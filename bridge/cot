# Junie CLI: ~/.junie/sessions/<id>/events.jsonl, one event per line
# ({timestampMs, kind, …}): UserPromptEvent (presentablePrompt / prompt),
# SessionA2uxEvent wrapping the agent's events (MarkdownBlockUpdatedEvent
# text, ResultBlockUpdatedEvent result, LlmResponseMetadataEvent modelUsage),
# SessionTitleSetEvent. sessions/index.jsonl names each session's project.

def _junie_index(root: Path) -> list[dict]:
    projects = {}
    for rec in _read_jsonl_file(root / "sessions" / "index.jsonl"):
        sid = rec.get("sessionId") or rec.get("id")
        if sid:
            projects[str(sid)] = rec
    out = []
    for path in sorted(root.glob("sessions/*/events.jsonl")):
        s = _file_session(path, path.parent.name)
        if s:
            meta = projects.get(s["id"], {})
            s.update(cwd=meta.get("projectDir"), title=meta.get("taskName"))
            out.append(s)
    return out


def _junie_items(session: dict, root: Path) -> list[dict]:
    items: list[dict] = []
    steps: dict[str, dict] = {}
    for n, ev in enumerate(_read_jsonl_file(session["_path"])):
        kind, ts = ev.get("kind"), ev.get("timestampMs")
        if kind in ("UserPromptEvent", "UserResponseEvent"):
            items.append({"kind": "prompt", "id": ev.get("requestId") or n, "ts": ts,
                          "text": ev.get("presentablePrompt") or ev.get("prompt") or ""})
        elif kind == "SessionTitleSetEvent":
            session["title"] = ev.get("name") or session.get("title")
        elif kind == "SessionA2uxEvent":
            agent = _first(ev, "event.agentEvent") or {}
            akind = agent.get("kind")
            if akind in ("MarkdownBlockUpdatedEvent", "ResultBlockUpdatedEvent"):
                text = agent.get("text") if akind == "MarkdownBlockUpdatedEvent" else \
                    str(agent.get("result") or "").replace("<!-- ANSWER -->", "").strip()
                step = agent.get("stepId")
                if step and step in steps:
                    steps[step].update(text=text, ts=ts)  # a block is rewritten as it streams
                else:
                    items.append({"kind": "response", "id": step or n, "ts": ts, "text": text})
                    if step:
                        steps[step] = items[-1]
            elif akind == "LlmResponseMetadataEvent":
                for i, u in enumerate(agent.get("modelUsage") or []):
                    if isinstance(u, dict):
                        items.append({"kind": "usage", "id": f"{n}:{i}", "ts": ts, "model": u.get("model"), "usage": {
                            "input_tokens": int(u.get("inputTokens") or 0), "output_tokens": int(u.get("outputTokens") or 0),
                            "cache_read_tokens": int(u.get("cacheInputTokens") or 0),
                            "cache_write_tokens": int(u.get("cacheCreateTokens") or 0)}})
    return items


_register(_Reader("junie", "Junie", (".junie",), env="JUNIE_DIR", index=_junie_index, items=_junie_items))


# Poolside Agent CLI: <root>/trajectories/*.ndjson|jsonl, one event per line,
# {id, timestamp, type, <type>: {...}}: session_start (workspace, prompt),
# session_input (prompt), assistant_message_end, thought_end,
# tool_call_parsed (id, name, args), tool_call_result (id, observation,
# is_error), tool_call_inference_start/end (model, tokens), session_exit.

def _poolside_index(root: Path) -> list[dict]:
    return [s for s in (_file_session(p) for p in sorted(root.glob("trajectories/**/*"))
                        if p.suffix in (".ndjson", ".jsonl", ".json")) if s]


def _poolside_items(session: dict, root: Path) -> list[dict]:
    items: list[dict] = []
    tools: dict = {}
    model = None
    for n, ev in enumerate(_read_jsonl_file(session["_path"])):
        etype, ts = ev.get("type"), ev.get("timestamp")
        body = ev.get(etype) if isinstance(ev.get(etype), dict) else {}
        if etype == "session_start":
            dirs = body.get("working_directories")
            session["cwd"] = body.get("workspace") or (dirs[0] if isinstance(dirs, list) and dirs else None)
            session["started"] = ts
            if body.get("prompt"):
                items.append({"kind": "prompt", "id": f"start:{n}", "ts": ts, "text": body["prompt"]})
        elif etype == "session_input" and body.get("prompt"):
            items.append({"kind": "prompt", "id": body.get("id") or n, "ts": ts, "text": body["prompt"]})
        elif etype == "assistant_message_end":
            items.append({"kind": "response", "id": ev.get("id") or n, "ts": ts, "text": body.get("assistant_message") or "",
                          "model": model})
        elif etype == "thought_end" and body.get("thought"):
            items.append({"kind": "thought", "id": ev.get("id") or n, "ts": ts, "text": body["thought"]})
        elif etype == "tool_call_parsed":
            tid = body.get("id") or f"t{n}"
            tools[tid] = {"kind": "tool", "id": tid, "ts": ts, "name": body.get("name"), "input": body.get("args")}
            items.append(tools[tid])
        elif etype == "tool_call_result" and tools.get(body.get("id")) is not None:
            tools[body["id"]].update(output=body.get("observation"), end_ts=ts, failed=bool(body.get("is_error")))
        elif etype == "tool_call_inference_start":
            model = _first(body, "chat_completion_request.model") or model
        elif etype == "tool_call_inference_end":
            items.append({"kind": "usage", "id": ev.get("id") or n, "ts": ts, "model": model, "usage": _usage_counts(body)})
        elif etype in ("session_exit", "session_error"):
            items.append({"kind": "end", "id": "end", "ts": ts,
                          "reason": body.get("reason") or body.get("error")})
    return items


