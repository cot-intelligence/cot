def _warp_index(root: Path) -> list[dict]:
    out = []
    for db_path in sorted({*root.glob("warp.sqlite"), *root.glob("*/warp.sqlite")}):
        for r in _sqlite_rows(db_path, "SELECT conversation_id, last_modified_at FROM agent_conversations"):
