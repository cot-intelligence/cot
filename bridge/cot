def _load_offsets() -> dict[str, int]:
    if not TRANSCRIPT_OFFSETS.exists():
        return {}
    try:
        return json.loads(TRANSCRIPT_OFFSETS.read_text())
    except (json.JSONDecodeError, OSError):
        return {}


def _save_offsets(data: dict[str, int]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    TRANSCRIPT_OFFSETS.write_text(json.dumps(data))


class _SpoolLock:
    """Best-effort exclusive lock around spool reads/writes so concurrent hook
    processes don't interleave appends or double-drain. A no-op where fcntl is
    unavailable — duplicate replays are harmless because ingest is idempotent."""

    def __init__(self) -> None:
        self._fh = None

    def __enter__(self) -> "_SpoolLock":
        if fcntl is None:
            return self
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            self._fh = open(SPOOL_LOCK_PATH, "w")
            fcntl.flock(self._fh.fileno(), fcntl.LOCK_EX)
        except OSError:
            if self._fh is not None:
                self._fh.close()
                self._fh = None
        return self

    def __exit__(self, *exc: object) -> None:
        if self._fh is not None:
            try:
                fcntl.flock(self._fh.fileno(), fcntl.LOCK_UN)
            finally:
                self._fh.close()
                self._fh = None


_down_since: float | None = None  # this process's last unreachable send


def _mark_collector_down() -> None:
    global _down_since
    _down_since = time.time()
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        COLLECTOR_DOWN_PATH.touch()
    except OSError:
        pass


def _mark_collector_up() -> None:
    global _down_since
    _down_since = None
    try:
        COLLECTOR_DOWN_PATH.unlink()
    except OSError:
        pass


def _probe_health() -> bool:
    try:
        urllib.request.urlopen(f"{COT_ENDPOINT}/health", timeout=_PROBE_TIMEOUT_S).read()
        return True
    except urllib.error.HTTPError:
        return True  # it answered
    except (urllib.error.URLError, TimeoutError, OSError):
        return False


# Spooled events per request when the collector takes batches.
_SPOOL_POST_BATCH = 100


def _collector_accepts_batches(endpoint: str | None = None) -> bool:
    """Whether the collector advertises batched ingest. An older one rejects an
    array as malformed, and a rejected send counts as delivered, so batches
    only go to a collector that says it takes them."""
    try:
        with urllib.request.urlopen(
            f"{(endpoint or COT_ENDPOINT).rstrip('/')}/health", timeout=_PROBE_TIMEOUT_S
        ) as resp:
            body = json.loads(resp.read() or b"{}")
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        return False
    return isinstance(body, dict) and "ingest_batch" in (body.get("features") or [])


def _collector_reachable() -> bool:
    """False while a recent unreachable send says the collector is down, so a
    hung collector costs one timeout rather than one per send. After the
    backoff, a short health probe decides instead of a full send timeout."""
    now = time.time()
    if _down_since is not None and now - _down_since < _DOWN_BACKOFF_S:
        return False
    try:
        marked: float | None = COLLECTOR_DOWN_PATH.stat().st_mtime
    except OSError:
        marked = None
    if marked is None and _down_since is None:
        return True
    if marked is not None and now - marked < _DOWN_BACKOFF_S:
        return False
    if _probe_health():
        _mark_collector_up()
        return True
    _mark_collector_down()
    return False


def _send_once(url: str, payload: dict | list[dict], timeout: float, *, retry_5xx: bool = False) -> bool:
    """POST one payload. Returns True on success, False if the collector could
    not be reached (the only condition that should trigger spooling).
    ``retry_5xx`` also returns False on a server error, for a batch whose
    events would otherwise all be dropped by one busy write."""
    data = json.dumps(payload, ensure_ascii=False, default=str).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        urllib.request.urlopen(req, timeout=timeout)
        return True
    except urllib.error.HTTPError as exc:
        # The collector answered (4xx/5xx). Retrying won't help and the payload
        # is likely malformed, so don't spool — treat as delivered.
        return not (retry_5xx and exc.code >= 500)
    except (urllib.error.URLError, TimeoutError, OSError):
        _mark_collector_down()
        return False


def _url_request_target(url: str) -> str:
    parsed = urllib.parse.urlsplit(url)
    path = parsed.path
    if parsed.query:
        path = f"{path}?{parsed.query}"
    return path


# When the running `cot hook` fired. A spooled event is stamped with this rather
# than the time it reached the spool: against a hanging collector every failed
# send first waits out its timeout, and a hook can post several events.
_HOOK_CAPTURED_AT: str | None = None


def _spool_append(url: str, payload: dict) -> bool:
    """Queue an undelivered ingest event, trimming the oldest to stay under the
    byte cap."""
    path = _url_request_target(url)
    # Most hook payloads carry no timestamp, so the collector stamps arrival
    # time. Pin the capture time now or a replay lands at flush time, out of
    # order with transcript-timed events. Only spooled events get this: the live
    # path's dedup hashes the raw payload, and a fresh ts would defeat it.
    if not payload.get("timestamp"):
        captured = _HOOK_CAPTURED_AT or datetime.now(timezone.utc).isoformat()
        payload = {**payload, "timestamp": captured}
    record = json.dumps({"path": path, "payload": payload}, ensure_ascii=False, default=str)
    line = record + "\n"
    with _SpoolLock():
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            existing = b""
            if SPOOL_PATH.exists() and SPOOL_PATH.stat().st_size + len(line.encode("utf-8")) > _MAX_SPOOL_BYTES:
                existing = SPOOL_PATH.read_bytes()
                # Drop whole lines from the front until the new record fits.
                budget = _MAX_SPOOL_BYTES - len(line.encode("utf-8"))
                while len(existing) > budget:
                    nl = existing.find(b"\n")
                    if nl == -1:
                        existing = b""
                        break
                    existing = existing[nl + 1:]
                SPOOL_PATH.write_bytes(existing)
            with SPOOL_PATH.open("a", encoding="utf-8") as fh:
                fh.write(line)
            return True
        except OSError as exc:
            print(f"cot: failed to spool event: {exc}", file=sys.stderr)
            return False


def _spool_target(record: dict, endpoint: str | None = None) -> str:
    """Resolve new and legacy spool records against the current collector."""
    path = record.get("path")
    if not isinstance(path, str) or not path:
        legacy_url = record.get("url")
        if not isinstance(legacy_url, str) or not legacy_url:
            return ""
        path = _url_request_target(legacy_url)
    if not path.startswith("/v1/ingest/"):
        return ""
    return f"{(endpoint or COT_ENDPOINT).rstrip('/')}{path}"


def _spool_flush(timeout: float = 3.0, *, endpoint: str | None = None) -> bool:
    """Replay queued events in order. Stops at the first unreachable send and
    rewrites the unsent remainder. Returns True if the collector was reachable
    (spool empty or fully/partially drained), False if it is still down."""
    with _SpoolLock():
        try:
            if not SPOOL_PATH.exists():
                return True
            raw = SPOOL_PATH.read_text(encoding="utf-8")
        except OSError:
            return True
        lines = [ln for ln in raw.splitlines() if ln.strip()]
        if not lines:
            try:
                SPOOL_PATH.unlink()
            except OSError:
                pass
            return True
        reachable = True
        limit = min(len(lines), _SPOOL_FLUSH_BATCH)
        # Consecutive events for the same endpoint go as one request (one write
        # transaction on the collector) when it takes batches; order is kept.
        per_post = _SPOOL_POST_BATCH if limit > 1 and _collector_accepts_batches(endpoint) else 1
        i = 0
        while i < limit:
            group: list[dict] = []
            target = ""
            j = i
            while j < limit and len(group) < per_post:
                try:
                    rec = json.loads(lines[j])
                except json.JSONDecodeError:
                    j += 1  # skip a corrupt line rather than wedge the queue
                    continue
                rec_target = _spool_target(rec, endpoint)
                if not rec_target:
                    j += 1
                    continue
                if target and rec_target != target:
                    break
                target = rec_target
                group.append(rec.get("payload", {}))
                j += 1
            if group and not _send_once(target, group if per_post > 1 else group[0], timeout):
                reachable = False
                break
            i = j
        remaining = lines[i:]
        try:
            if remaining:
                SPOOL_PATH.write_text("\n".join(remaining) + "\n", encoding="utf-8")
            else:
                SPOOL_PATH.unlink()
        except OSError:
            pass
        return reachable


def _post(url: str, payload: dict) -> None:
    is_ingest = "/v1/ingest/" in url
    if is_ingest:
        if "/v1/ingest/opencode" in url or "/v1/ingest/hermes" in url:
            # The plugin bounds subprocess lifetime. Persist before HTTP work
            # so a timeout during queue replay cannot lose the new event.
            if not _spool_append(url, payload):
                raise OSError("Unable to persist plugin hook event")
            if _collector_reachable():
                _spool_flush(endpoint=url.split("/v1/ingest/", 1)[0])
            return
        if not _collector_reachable():
            _spool_append(url, payload)
            return
        # Drain anything queued from a prior outage first so events stay ordered,
        # and skip the live attempt entirely if the collector is still down.
        if SPOOL_PATH.exists() and not _spool_flush():
            _spool_append(url, payload)
            return
        if _send_once(url, payload, timeout=3):
            return
        _spool_append(url, payload)
        return
    if not _collector_reachable() or not _send_once(url, payload, timeout=3):
        print(f"cot: failed to post event: {url}", file=sys.stderr)


def _post_async(url: str, payload: dict) -> None:
    """Fire-and-forget — only for non-critical follow-up posts."""
    def _send() -> None:
        _post(url, payload)

    threading.Thread(target=_send, daemon=True).start()


# Imported events per request when the collector takes batches. Each request is
# one write transaction, so this also bounds how long an import holds the write
# lock that live hooks wait on.
_IMPORT_POST_BATCH = 200
# Batches queued for the poster's sender thread before parsing waits on it.
_IMPORT_SEND_QUEUE = 2

# Set by a collector that runs the import in its own process: called with
# (url, body) instead of POSTing, where body is one payload or a list of them.
_INGEST_SINK = None
# Set alongside it: called with (agent, files_done, files_total, bytes_done,
# bytes_total) instead of printing cot-progress lines.
_PROGRESS_SINK = None
# Set while importing another machine's session folders (`cot import --from`):
# the home to read transcripts from, and the machine name stamped on each event.
_IMPORT_HOME_OVERRIDE: Path | None = None
_IMPORT_MACHINE: str | None = None
SESSION_SOURCES_PATH = Path.home() / ".cot" / "session_sources.json"


def _import_progress(agent: str, files_done: int, files_total: int, bytes_done: int, bytes_total: int) -> None:
    if _PROGRESS_SINK is not None:
        _PROGRESS_SINK(agent, files_done, files_total, bytes_done, bytes_total)
    else:
        print(f"cot-progress {agent} {files_done} {files_total} {bytes_done} {bytes_total}",
              file=sys.stderr, flush=True)


class _ImportPoster:
    """Posts imported events to one ingest endpoint, many per request.

    A per-event POST costs a round trip and a commit for every line of history;
    batches cost one of each per ``_IMPORT_POST_BATCH``. Order is kept. Events
    that can't be delivered are spooled, as ``_post`` does, so the caller can
    advance its offsets either way. Attachment bodies go alone: the collector
    folds them onto a prompt only when they arrive as a single object.

    Batches are sent from one background thread while the caller parses the
    next: the send (an HTTP round trip, or SQLite writes, which release the
    GIL) overlaps the parsing. At most ``_IMPORT_SEND_QUEUE`` batches wait.
    Call ``flush()`` before reading the results back or exiting; it returns
    once everything is delivered and re-raises a send's error."""

    def __init__(self, url: str) -> None:
        self.url = url
        self.pending: list[dict] = []
        self._queue = None
        self._thread: threading.Thread | None = None
        self._error: BaseException | None = None
        self.sink = _INGEST_SINK
        if self.sink is not None:
            self.batched = True
            return
        endpoint = url.split("/v1/ingest/", 1)[0]
        # Drain an earlier outage's spool first so events stay ordered.
        if SPOOL_PATH.exists() and _collector_reachable():
            _spool_flush(endpoint=endpoint)
        self.batched = _collector_accepts_batches(endpoint)

    def add(self, payload: dict) -> None:
        if _IMPORT_MACHINE:
            payload.setdefault("_machine", _IMPORT_MACHINE)
        if not self.batched or payload.get("_attach_to_prompt"):
            self._ship()
            self._submit([payload])
            return
        self.pending.append(payload)
        if len(self.pending) >= _IMPORT_POST_BATCH:
            self._ship()

    def flush(self) -> None:
        self._ship()
        if self._thread is not None:
            self._queue.put(None)
            self._thread.join()
            self._thread = self._queue = None
        self._raise()

    def _ship(self) -> None:
        if self.pending:
            group, self.pending = self.pending, []
            self._submit(group)

    def _raise(self) -> None:
        if self._error is not None:
            error, self._error = self._error, None
            raise error

    def _submit(self, group: list[dict]) -> None:
        self._raise()
        if self._thread is None:
            import queue

            self._queue = queue.Queue(maxsize=_IMPORT_SEND_QUEUE)
            self._thread = threading.Thread(target=self._sender, daemon=True, name="cot-import-send")
            self._thread.start()
        self._queue.put(group)

    def _sender(self) -> None:
        while True:
            group = self._queue.get()
            if group is None:
                return
            if self._error is None:  # after a failure, drop the rest; flush raises
                try:
                    self._send(group)
                except BaseException as exc:  # noqa: BLE001 - re-raised on the caller's thread
                    self._error = exc

    def _send(self, group: list[dict]) -> None:
        if self.sink is not None:
            self.sink(self.url, group if len(group) > 1 else group[0])
            return
        if len(group) > 1:
            sent = _collector_reachable() and _send_once(self.url, group, timeout=30, retry_5xx=True)
        else:
            sent = _collector_reachable() and _send_once(self.url, group[0], timeout=10)
        if sent:
            return
        for payload in group:
            _spool_append(self.url, payload)


def _audit_self(action: str, *, target: str | None = None, status: str = "ok", detail: dict | None = None) -> None:
    """Best-effort self-audit for bridge config changes."""
    payload = {
        "action": action,
        "actor": "cot-bridge",
        "target": target,
        "status": status,
        "detail": detail or {},
    }
    data = json.dumps(payload, ensure_ascii=False, default=str).encode("utf-8")
    req = urllib.request.Request(
        f"{COT_ENDPOINT}/v1/audit/self",
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        urllib.request.urlopen(req, timeout=2)
    except (urllib.error.URLError, TimeoutError, OSError):
        pass


def _now_z() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def _get_turn_anchors(session_id: str, hook_timestamp: str) -> dict | None:
    """Query the collector for tool-event timestamps in the current turn.

    Returns ``{prompt_ts: str, anchors: [{ts, ...}]}`` or None on failure.
    """
    ts_param = urllib.parse.quote(str(hook_timestamp), safe="")
    url = f"{COT_ENDPOINT}/v1/internal/turn-anchors/{session_id}?before={ts_param}"
    try:
        with urllib.request.urlopen(url, timeout=2) as resp:
            return json.loads(resp.read())
    except (urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError):
        return None


def _interpolate_ts(start: str, end: str, fraction: float) -> str:
    """Return a timestamp at *fraction* of the way from *start* to *end*."""
    try:
        s = datetime.fromisoformat(start.replace("Z", "+00:00"))
        e = datetime.fromisoformat(end.replace("Z", "+00:00"))
        dt = s + (e - s) * max(0.0, min(1.0, fraction))
        return dt.isoformat(timespec="milliseconds").replace("+00:00", "Z")
    except (ValueError, TypeError):
        return end


def _ordered_ts(base: object, index: int) -> str:
    """A timestamp derived from *base* plus *index* ms, so a batch of events
    emitted together keeps a stable, increasing order in the timeline."""
    if not base:
        base = _now_z()
    try:
        dt = datetime.fromisoformat(str(base).replace("Z", "+00:00")) + timedelta(milliseconds=index)
        return dt.isoformat(timespec="milliseconds").replace("+00:00", "Z")
    except ValueError:
        return str(base)


def _img_dims(raw: bytes) -> tuple[int | None, int | None]:
    """Best-effort pixel dimensions from raw image bytes (PNG/GIF/JPEG)."""
    try:
        if raw[:8] == b"\x89PNG\r\n\x1a\n":
            w, h = struct.unpack(">II", raw[16:24])
            return w, h
        if raw[:6] in (b"GIF87a", b"GIF89a"):
            w, h = struct.unpack("<HH", raw[6:10])
            return w, h
        if raw[:2] == b"\xff\xd8":  # JPEG: scan for a start-of-frame marker
            i, n = 2, len(raw)
            while i + 9 < n:
                if raw[i] != 0xFF:
                    i += 1
                    continue
                marker = raw[i + 1]
                if 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
                    h, w = struct.unpack(">HH", raw[i + 5 : i + 9])
                    return w, h
                seg = struct.unpack(">H", raw[i + 2 : i + 4])[0]
                i += 2 + seg
    except Exception:
        pass
    return None, None


def _kind_for_media_type(media_type: str | None) -> str:
    return "image" if media_type and media_type.startswith("image/") else "document"


def _meta_from_bytes(meta: dict, raw: bytes) -> None:
    meta["size_bytes"] = len(raw)
    if meta.get("kind") == "image":
        w, h = _img_dims(raw)
        if w:
            meta["width"], meta["height"] = w, h


def _decode_data_url(value: str) -> tuple[str | None, bytes | None]:
    if not value.startswith("data:") or "," not in value:
        return None, None
    header, data = value.split(",", 1)
    media_type = header[5:].split(";", 1)[0] or None
    if ";base64" not in header:
        return media_type, None
    try:
        return media_type, base64.b64decode(data)
    except Exception:
        return media_type, None


def _uploaded_documents_from_text(text: str) -> list[dict]:
    """Cursor records chat uploads as an uploaded_documents text preamble."""
    import mimetypes

    match = re.search(r"<uploaded_documents>(.*?)</uploaded_documents>", text, re.S)
    if not match:
        return []
    out: list[dict] = []
    for raw_line in match.group(1).splitlines():
        line = raw_line.strip()
        if not line.startswith("- "):
            continue
        m = re.match(r"-\s+(.+?)(?:\s+\(([^)]+)\))?$", line)
        if not m:
            continue
        path_text = m.group(1).strip()
        name = (m.group(2) or Path(path_text).name).strip()
        media_type = mimetypes.guess_type(name)[0] or mimetypes.guess_type(path_text)[0]
        meta: dict = {"kind": _kind_for_media_type(media_type), "media_type": media_type}
        if name:
            meta["name"] = name
            ext = Path(name).suffix.lstrip(".").lower()
            if ext:
                meta["extension"] = ext
        try:
            p = Path(path_text).expanduser()
            if p.is_file():
                meta["size_bytes"] = p.stat().st_size
        except OSError:
            pass
        out.append(meta)
    return out


def _codex_files_from_text(text: str) -> list[dict]:
    """Codex records some uploads only as a leading Files-mentioned preamble."""
    import mimetypes

    stripped = text.lstrip()
    if not stripped.startswith("# Files mentioned by the user:"):
        return []
    header = stripped.split("## My request for Codex:", 1)[0]
    out: list[dict] = []
    for raw_line in header.splitlines():
        line = raw_line.strip()
        if not line.startswith("## "):
            continue
        entry = line[3:].strip()
        if ": " not in entry:
            continue
        name, path_text = entry.rsplit(": ", 1)
        name = name.strip()
        path_text = path_text.strip()
        media_type = mimetypes.guess_type(name)[0] or mimetypes.guess_type(path_text)[0]
        meta: dict = {"kind": _kind_for_media_type(media_type), "media_type": media_type}
        if name:
            meta["name"] = name
            ext = Path(name).suffix.lstrip(".").lower()
            if ext:
                meta["extension"] = ext
        try:
            p = Path(path_text).expanduser()
            if p.is_file():
                meta["size_bytes"] = p.stat().st_size
        except OSError:
            pass
        out.append(meta)
    return out


def _file_attachment_meta(attachment: dict) -> dict | None:
    import mimetypes

    if attachment.get("type") != "file":
        return None
    filename = attachment.get("filename")
    content = attachment.get("content") if isinstance(attachment.get("content"), dict) else {}
    file_info = content.get("file") if isinstance(content.get("file"), dict) else {}
    path_text = str(file_info.get("filePath") or filename or "")
    name = Path(path_text).name if path_text else ""
    media_type = mimetypes.guess_type(name)[0] or mimetypes.guess_type(path_text)[0]
    meta: dict = {"kind": _kind_for_media_type(media_type), "media_type": media_type}
    if name:
        meta["name"] = name
        ext = Path(name).suffix.lstrip(".").lower()
        if ext:
            meta["extension"] = ext
    if isinstance(file_info.get("content"), str):
        meta["size_bytes"] = len(file_info["content"].encode("utf-8"))
    elif path_text:
        try:
            p = Path(path_text).expanduser()
            if p.is_file():
                meta["size_bytes"] = p.stat().st_size
        except OSError:
            pass
    return meta


def _file_attachment_matches_text(attachment: dict, text: str | None) -> bool:
    if not text:
        return False
    if "@" not in text:
        return False
    filename = str(attachment.get("filename") or "")
    if filename and re.search(rf"@['\"]?{re.escape(filename)}(?:['\"]|\s|$)", text):
        return True
    name = Path(filename).name if filename else ""
    return bool(name and re.search(rf"@['\"]?[^'\"]*{re.escape(name)}(?:['\"]|\s|$)", text))


def _message_attachments(content: list) -> list[dict]:
    """Metadata for non-text user attachments (images / documents): kind,
    media_type, byte size, and pixel dimensions — never the raw bytes."""
    out: list[dict] = []
    has_structured_upload = any(
        isinstance(block, dict) and block.get("type") in ("image", "document", "input_image", "input_file")
        for block in content
    )
    for block in content:
        if not isinstance(block, dict):
            continue
        bt = block.get("type")
        if bt in ("text", "input_text"):
            text = block.get("text")
            if isinstance(text, str):
                out.extend(_uploaded_documents_from_text(text))
                if not has_structured_upload:
                    out.extend(_codex_files_from_text(text))
            continue
        if bt not in ("image", "document", "input_image", "input_file"):
            continue
        src = block.get("source") if isinstance(block.get("source"), dict) else {}
        media_type = src.get("media_type") or block.get("media_type") or block.get("mime_type")
        raw: bytes | None = None
        if bt == "input_image":
            media_type, raw = _decode_data_url(str(block.get("image_url") or ""))
        elif bt == "input_file":
            media_type, raw = _decode_data_url(str(block.get("file_data") or ""))
        kind = "image" if bt in ("image", "input_image") else "document"
        if media_type and bt == "input_file":
            kind = _kind_for_media_type(media_type)
        meta: dict = {"kind": kind, "media_type": media_type}
        name = block.get("title") or block.get("filename") or src.get("name")
        if name:
            meta["name"] = name
            ext = Path(str(name)).suffix.lstrip(".").lower()
            if ext:
                meta["extension"] = ext
        data = src.get("data")
        if isinstance(data, str):
            try:
                raw = base64.b64decode(data)
            except Exception:
                raw = None
        if raw is not None:
            _meta_from_bytes(meta, raw)
        out.append(meta)
    return out


_ENV_CONTEXT_RE = re.compile(r"<environment_context>.*?</environment_context>", re.S)


def _extract_env_context(text: str | None) -> tuple[str | None, str]:
    """Split a Codex user message into (environment_context block, remainder).

    Codex injects an ``<environment_context>`` block (cwd/shell/sandbox/perms) as
    a synthetic user turn. It is not something the human typed, so it is lifted
    out into its own system event rather than shown — or counted — as a prompt.
    """
    out = str(text or "")
    match = _ENV_CONTEXT_RE.search(out)
    if not match:
        return None, out
    block = match.group(0)
    remainder = (out[: match.start()] + out[match.end():]).strip()
    return block, remainder


def _env_context_event(base: dict, block: str) -> dict:
    """A system 'Environment context' event for the injected block. The stable
    content-hash dedup key collapses the per-turn repeats to one per session."""
    digest = hashlib.sha1(block.encode("utf-8", "replace")).hexdigest()[:16]
    return {
        **base,
        "kind": "session_metadata",
        "metadata_type": "environment_context",
        "environment_context": block,
        "dedup_key": f"envctx:{digest}",
    }


def _clean_user_text(text: str) -> str:
    """Remove agent-added upload wrappers while preserving the user's request."""
    out = text.strip()
    user_query = re.search(r"<user_query>\s*(.*?)\s*</user_query>", out, re.S)
    if user_query:
        out = user_query.group(1).strip()
    marker = "## My request for Codex:"
    if marker in out:
        out = out.split(marker, 1)[1].strip()
    out = re.sub(r"<uploaded_documents>.*?</uploaded_documents>", "", out, flags=re.S).strip()
    out = re.sub(r"<image\b[^>]*>\s*</image>", "", out, flags=re.S).strip()
    # Codex injects an <environment_context> (cwd/shell/sandbox) block as a
    # synthetic user turn; strip it so it never lands as a real user prompt.
    out = re.sub(r"<environment_context>.*?</environment_context>", "", out, flags=re.S).strip()
    return out


def _text_from_blocks(content, *, clean_user: bool = False) -> str:
    if isinstance(content, str):
        text = content.strip()
        return _clean_user_text(text) if clean_user else text
    if not isinstance(content, list):
        return ""
    parts: list[str] = []
    for block in content:
        if isinstance(block, dict):
            if block.get("type") in ("text", "output_text", "input_text"):
                t = block.get("text", "")
                if t:
                    parts.append(str(t))
        elif isinstance(block, str) and block:
            parts.append(block)
    text = "\n".join(parts).strip()
    return _clean_user_text(text) if clean_user else text


def _is_interruption(text: str | None) -> bool:
    """Both agents record a user-stop as a synthetic user message right after the
    cut-off output: Claude ``[Request interrupted by user...]``, Codex
    ``<turn_aborted> The user interrupted the previous turn...``."""
    if not text:
        return False
    t = text.lower()
    return (
        "request interrupted by user" in t
        or "user aborted" in t
        or "<turn_aborted>" in t
        or "interrupted the previous turn" in t
    )


def _merge_usage(acc: dict | None, usage: dict) -> dict:
    """Sum per-turn token deltas. Handles both Claude and Codex key names;
    normalize.py maps them onto the stored token columns."""
    out = dict(acc) if isinstance(acc, dict) else {}
    for key in (
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "cache_read_input_tokens",
        "cache_creation_input_tokens",
        "reasoning_output_tokens",
        "total_tokens",
    ):
        val = usage.get(key)
        if isinstance(val, (int, float)):
            out[key] = out.get(key, 0) + int(val)
    return out


def _response_equality_key(text: object) -> str:
    s = str(text or "").replace("[REDACTED]", "")
    return " ".join(s.lower().split())


def _read_live_transcript_lines(transcript_path: str, session_id: str) -> list[tuple[int, str]]:
    """Read complete new JSONL records with their absolute byte offsets."""
    path = Path(transcript_path)
    try:
        size = path.stat().st_size
    except OSError:
        return []
    if size > _MAX_TRANSCRIPT_BYTES:
        return []
    offsets = _load_offsets()
    key = f"{session_id}:{transcript_path}"
    start = offsets.get(key, 0)
    if start > size:
        start = 0
    try:
        with path.open("rb") as fh:
            fh.seek(start)
            chunk = fh.read()
    except OSError:
        return []
    last_nl = chunk.rfind(b"\n")
    if last_nl < 0:
        return []
    consumed = chunk[: last_nl + 1]
    out: list[tuple[int, str]] = []
    relative = 0
    for raw_line in consumed.splitlines(keepends=True):
        absolute = start + relative
        relative += len(raw_line)
        line = raw_line.rstrip(b"\r\n").decode("utf-8", errors="replace").strip()
        if line:
            out.append((absolute, line))
    offsets[key] = start + len(consumed)
    _save_offsets(offsets)
    return out


def _origin_dedup_key(origin: str, source: str, key: str | None) -> str | None:
    if not key:
        return None
    return key if origin == "import" else f"live:{source}:{key}"


def _scoped_dedup_key(
    origin: str,
    source: str,
    suffix: str,
    *,
    import_anchor: str | None,
    live_anchor: str | None,
    live_only: bool = False,
) -> str | None:
    """Apply the shared import/live dedup scope to one Ingest Event."""
    if live_only and origin != "hook":
        return None
    anchor = import_anchor if origin == "import" else live_anchor
    return _origin_dedup_key(origin, source, f"{anchor}:{suffix}" if anchor else None)


def _keep_live_event(source: str, event: dict) -> bool:
    kind = event.get("kind")
    if kind in ("response", "thought", "attachment", "interruption", "plan"):
        return True
    if kind == "tool_call":
        name = event.get("tool_name")
        # Tools NOT in Cursor's hook tool allowlist (BSb map) — they fire no
        # preToolUse/postToolUse and would be lost without transcript capture.
        # WebSearch/WebFetch DO fire hooks but are kept defensively; dedup
        # prevents double-counting.
        return (
            source == "cursor"
            and name
            in (
                "AskQuestion",
                "WebSearch",
                "WebFetch",
                "ReadLints",
                "TodoWrite",
                "SwitchMode",
                "Glob",
            )
        ) or (source == "codex" and name in ("WebSearch", "WebFetch"))
    return False


def _filter_live_events_with_usage(source: str, events: list[dict]) -> list[dict]:
    """Drop hook-delivered kinds while preserving every parsed usage delta."""
    kept: list[dict] = []
    pending: dict | None = None
    for original in events:
        event = dict(original)
        usage = event.get("usage") if isinstance(event.get("usage"), dict) else None
        if not _keep_live_event(source, event):
            if usage:
                pending = _merge_usage(pending, usage)
            continue
        if pending:
            event["usage"] = _merge_usage(pending, usage or {})
            pending = None
        kept.append(event)
    if pending and kept:
        last = dict(kept[-1])
        last["usage"] = _merge_usage(last.get("usage"), pending)
        kept[-1] = last
    elif pending:
        # No transcript-only Event exists in this delta. Keep the tokens inside
        # the canonical list as session metadata; the live shell folds this
        # marker onto the hook body before the body is posted.
        kept.append({
            "kind": "session_metadata",
            "metadata_type": "usage",
            "origin": "hook",
            "usage": pending,
        })
    return kept


def _collapse_consecutive_responses(events: list[dict]) -> list[dict]:
    out: list[dict] = []
    for event in events:
        kind = event.get("kind")
        if (
            kind in ("response", "thought")
            and out
            and out[-1].get("kind") == kind
            and _response_equality_key(out[-1].get("text"))
            == _response_equality_key(event.get("text"))
        ):
            continue
        out.append(event)
    return out


def _apply_interruption_markers(events: list[dict]) -> list[dict]:
    out: list[dict] = []
    for event in events:
        if event.get("kind") != "interruption":
            out.append(event)
            continue
        if out:
            prior = dict(out[-1])
            prior["interrupted"] = True
            out[-1] = prior
    return out


def _prepare_ingest_events(
    source: str,
    events: list[dict],
    *,
    origin: str,
    hook_timestamp: object = None,
) -> list[dict]:
    """Apply the shared pure event-list transformations for either Origin."""
    prepared = [dict(event) for event in events]

    # Before filtering tool_calls for the Cursor hook path, record each
    # event's fractional position within its turn so we can proportionally
    # interpolate response timestamps across [prompt_ts, hook_ts].
    has_tool_ordinals = False
    total_before_filter = len(prepared)
    if origin == "hook" and source == "cursor":
        # First pass: find turn boundaries and count events per turn.
        turn_idx = 0
        turn_start: dict[int, int] = {0: 0}  # turn_idx → first event index
        tool_in_turn = 0
        for i, event in enumerate(prepared):
            if event.get("kind") == "prompt":
                turn_idx += 1
                turn_start[turn_idx] = i
                tool_in_turn = 0
            event["_turn_idx"] = turn_idx
            event["_tool_ordinal"] = tool_in_turn
            if event.get("kind") == "tool_call":
                tool_in_turn += 1

        # Second pass: compute per-event fractional position within its turn.
        # Count events per turn (excluding prompt and turn_end markers).
        turn_counts: dict[int, int] = {}
        for event in prepared:
            tidx = event["_turn_idx"]
            kind = event.get("kind")
            if kind not in ("prompt", None) and event.get("_turn_idx") is not None:
                turn_counts[tidx] = turn_counts.get(tidx, 0) + 1

        turn_pos: dict[int, int] = {}  # running position per turn
        for event in prepared:
            tidx = event["_turn_idx"]
            kind = event.get("kind")
            if kind == "prompt":
                continue
            pos = turn_pos.get(tidx, 0)
            total = turn_counts.get(tidx, 1)
            event["_event_frac"] = pos / max(total, 1)
            turn_pos[tidx] = pos + 1

        has_tool_ordinals = True

    if origin == "hook":
        prepared = _filter_live_events_with_usage(source, prepared)
    # Only Cursor is configured for this shared transform: its transcript
    # format is the one observed to repeat identical commentary blocks. Both
    # Cursor Origins pass through this gate; enabling it for another source is
    # a policy choice, not another parser implementation.
    if source == "cursor":
        prepared = _collapse_consecutive_responses(prepared)
    prepared = _apply_interruption_markers(prepared)
    if origin == "hook" and source == "cursor":
        prepared = _assign_cursor_response_timestamps(
            prepared, hook_timestamp, has_tool_ordinals
        )
    return prepared


def _assign_cursor_response_timestamps(
    events: list[dict],
    hook_timestamp: object,
    has_tool_ordinals: bool,
) -> list[dict]:
    """Assign timestamps to Cursor transcript-derived events.

    Instead of clustering all events at hook_timestamp (end of turn), query
    the collector for the turn's prompt timestamp and interpolate each
    response proportionally across [prompt_ts, hook_ts] based on its position
    in the unfiltered transcript event list.

    Each event carries ``_turn_idx`` (incremented at each prompt),
    ``_tool_ordinal`` (unused now but kept for possible future use), and
    ``_event_frac`` — the event's fractional position (0‥1) in the turn's
    full event list before filtering.
    """
    _INTERNAL = ("_tool_ordinal", "_turn_idx", "_event_frac")

    def _strip(ev: dict) -> dict:
        return {k: v for k, v in ev.items() if k not in _INTERNAL}

    if not events:
        return events

    session_id = next(
        (e.get("session_id") for e in events if e.get("session_id")), None
    )
    hook_ts_str = str(hook_timestamp)

    if not (session_id and hook_timestamp and has_tool_ordinals):
        return [
            {**_strip(event), "timestamp": _ordered_ts(hook_timestamp, idx)}
            for idx, event in enumerate(events)
        ]

    # Query the collector for prompts — we need the prompt_ts to define the
    # interpolation range [prompt_ts, hook_ts].
    # For multi-turn deltas, get all prompts so each turn has its own range.
    all_prompts = _get_all_prompt_timestamps(session_id)
    if not all_prompts:
        return [
            {**_strip(event), "timestamp": _ordered_ts(hook_timestamp, idx)}
            for idx, event in enumerate(events)
        ]

    # Build a per-turn time range map: turn_idx → (start_ts, end_ts).
    # turn_idx in the event list starts at 1 (set when a prompt is seen).
    # The last turn's end is the hook timestamp; earlier turns end at the
    # next prompt's timestamp.
    turn_ranges: dict[int, tuple[str, str]] = {}
    turn_indices = sorted({e.get("_turn_idx", 0) for e in events})
    for i, tidx in enumerate(turn_indices):
        # Match this turn_idx to a prompt. turn_idx=1 → first prompt seen in
        # this delta. If the delta spans multiple turns, we take prompts from
        # the end of the list (most recent prompts correspond to this delta).
        prompt_offset = len(all_prompts) - len(turn_indices) + i
        if prompt_offset < 0:
            prompt_offset = 0
        prompt_ts = all_prompts[prompt_offset] if prompt_offset < len(all_prompts) else all_prompts[-1]
        # End of turn = next prompt's ts, or hook_ts for the last turn.
        if prompt_offset + 1 < len(all_prompts) and i + 1 < len(turn_indices):
            end_ts = all_prompts[prompt_offset + 1]
        else:
            end_ts = hook_ts_str
        turn_ranges[tidx] = (prompt_ts, end_ts)

    out: list[dict] = []
    for i, event in enumerate(events):
        event = dict(event)
        tidx = event.get("_turn_idx", 0)
        frac = event.get("_event_frac")
        start_ts, end_ts = turn_ranges.get(tidx, (all_prompts[-1], hook_ts_str))

        if frac is not None:
            # Place at proportional position within the turn's time range.
            # Add a small offset per event to break ties.
            ts = _interpolate_ts(start_ts, end_ts, frac)
        else:
            ts = _ordered_ts(hook_ts_str, i)

        event["timestamp"] = ts
        out.append(_strip(event))
    return out


def _get_all_prompt_timestamps(session_id: str) -> list[str]:
    """Fetch all prompt timestamps for a session, oldest first."""
    if not _collector_reachable():
        return []
    try:
        enc_sid = urllib.parse.quote(session_id, safe="")
        req_url = f"{COT_ENDPOINT}/v1/internal/prompt-timestamps/{enc_sid}"
        with urllib.request.urlopen(req_url, timeout=2) as resp:
            data = json.loads(resp.read())
            return data.get("timestamps", [])
    except urllib.error.HTTPError:
        return []
    except (urllib.error.URLError, TimeoutError, OSError):
        _mark_collector_down()
        return []
    except json.JSONDecodeError:
        return []


def _scan_live_ingest_events(
    source: str,
    transcript_path: str,
    session_id: str,
    hook_timestamp: object,
) -> list[dict]:
    """Parse one transcript delta through the same line-parser as import."""
    parser = _ingest_line_parser(source)
    state: dict = {}
    events: list[dict] = []
    path = str(transcript_path)
    for lineno, (byte_offset, line) in enumerate(
        _read_live_transcript_lines(transcript_path, session_id)
    ):
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        events.extend(
            parser(
                obj,
                session_id,
                lineno=lineno,
                state=state,
                path=path,
                origin="hook",
                byte_offset=byte_offset,
            )
        )
    if source == "codex":
        events.extend(_codex_flush_pending_ingest_events(state))
    return _prepare_ingest_events(
        source, events, origin="hook", hook_timestamp=hook_timestamp
    )


def _ingest_line_parser(source: str):
    return {
        "claude": _claude_line_to_ingest_events,
        "cursor": _cursor_line_to_ingest_events,
        "codex": _codex_line_to_ingest_events,
    }[source]


def _import_line_to_hook_payloads(
    source: str,
    obj: dict,
    session_id: str,
    *,
    lineno: int = 0,
    mtime: float | None = None,
    state: dict | None = None,
    path: str = "",
) -> list[dict]:
    """Run one import line through the authoritative canonical pipeline."""
    events = _ingest_line_parser(source)(
        obj,
        session_id,
        lineno=lineno,
        mtime=mtime,
        state=state,
        path=path,
        origin="import",
    )
    return _ingest_events_to_hook_payloads(
        _prepare_ingest_events(source, events, origin="import")
    )


def _enrich_live_events(events: list[dict], body: dict) -> list[dict]:
    out: list[dict] = []
    for original in events:
        event = dict(original)
        event.setdefault("origin", "hook")
        if not event.get("session_id"):
            event["session_id"] = body.get("session_id")
        if not event.get("cwd") and body.get("cwd"):
            event["cwd"] = body.get("cwd")
        if not event.get("model") and body.get("model"):
            event["model"] = body.get("model")
        if not event.get("composer_mode") and body.get("composer_mode"):
            event["composer_mode"] = body.get("composer_mode")
        out.append(event)
    return out


def _fold_usage_metadata_into_hook_body(events: list[dict], body: dict) -> list[dict]:
    """Fold internal usage metadata onto the hook body and remove the marker."""
    out: list[dict] = []
    for event in events:
        if event.get("kind") == "session_metadata" and event.get("metadata_type") == "usage":
            usage = event.get("usage") if isinstance(event.get("usage"), dict) else {}
            if usage:
                body["usage"] = _merge_usage(body.get("usage"), usage)
            continue
        out.append(event)
    return out


def _post_ingest_events(source: str, events: list[dict]) -> None:
    for event in events:
        _post(
            f"{COT_ENDPOINT}/v1/ingest/{source}",
            _ingest_event_to_hook_payload(event),
        )


def _shell_dedup_key(source: str, label: str, body: dict, text: str) -> str:
    raw = f"{body.get('timestamp') or ''}\0{text}".encode("utf-8", "replace")
    return f"live:{source}:{label}:{hashlib.sha1(raw).hexdigest()[:16]}"


def _shell_response_event(
    source: str,
    body: dict,
    text: str,
    *,
    label: str | None = None,
    timestamp: object = None,
    composer_mode: str | None = None,
    dedup_key: str | None = None,
) -> dict:
    """Build the canonical response shape used by live-shell fallbacks."""
    if dedup_key is None:
        if not label:
            raise ValueError("shell response requires a label or explicit dedup key")
        dedup_key = _shell_dedup_key(source, label, body, text)
    return {
        "kind": "response",
        "origin": "hook",
        "session_id": body.get("session_id"),
        "cwd": body.get("cwd"),
        "model": body.get("model"),
        "composer_mode": composer_mode or body.get("composer_mode"),
        "text": text,
        "timestamp": timestamp if timestamp is not None else body.get("timestamp"),
        "dedup_key": dedup_key,
    }


def _emit_claude_events(body: dict, source: str) -> None:
    hook = body.get("hook_event_name") or body.get("hook") or ""
    transcript = body.get("transcript_path")
    session_id = body.get("session_id")
    if hook not in ("Stop", "SubagentStop") or not transcript or not session_id:
        return
    events = _scan_live_ingest_events(source, transcript, session_id, body.get("timestamp"))
    events = _fold_usage_metadata_into_hook_body(events, body)
    _post_ingest_events(source, _enrich_live_events(events, body))


def _emit_cursor_events(body: dict, source: str) -> bool:
    """Run Cursor's shared parser and retain only trigger-context behavior."""
    hook = body.get("hook_event_name") or body.get("hook") or ""
    transcript = body.get("transcript_path")
    session_id = body.get("session_id")
    if hook not in ("afterAgentResponse", "stop") or not transcript or not session_id:
        return False
    events = _scan_live_ingest_events(source, transcript, session_id, body.get("timestamp"))
    events = _fold_usage_metadata_into_hook_body(events, body)
    events = _enrich_live_events(events, body)
    body_text = str(body.get("text") or body.get("response") or "").strip()

    questions = [
        event for event in events
        if event.get("kind") == "tool_call" and event.get("tool_name") == "AskQuestion"
    ]
    responses = [event for event in events if event.get("kind") == "response"]
    plans = [event for event in events if event.get("kind") == "plan"]
    if body_text and (
        not responses
        or _response_equality_key(responses[-1].get("text"))
        != _response_equality_key(body_text)
    ):
        events.append(_shell_response_event(
            source,
            body,
            body_text,
            label="safety",
            timestamp=_ordered_ts(body.get("timestamp"), len(events)),
        ))
        responses.append(events[-1])
    if plans and not responses:
        plan = plans[-1]
        plan_text = str(plan.get("body") or plan.get("overview") or "").strip()
        if plan_text:
            events.append(_shell_response_event(
                source,
                body,
                plan_text,
                composer_mode="plan",
                timestamp=_ordered_ts(body.get("timestamp"), len(events)),
                dedup_key=f"{plan.get('dedup_key')}:fallback",
            ))
            responses.append(events[-1])

    _post_ingest_events(source, events)
    if body_text:
        for question in questions:
            _post(
                f"{COT_ENDPOINT}/v1/questions/answer",
                _question_answer_payload(
                    session_id, question.get("tool_input") or {}, body_text
                ),
            )
    return hook != "stop" and bool(responses or plans)


def _find_codex_transcript(session_id: str) -> str | None:
    """Locate a Codex rollout transcript from the session id alone.

    Codex only includes ``transcript_path`` on some hook payloads (it varies by
    version/hook), but the session id is always present and is the suffix of the
    rollout filename: ``rollout-<timestamp>-<session_id>.jsonl``. Deriving the
    path here means intermediate thinking is captured regardless of payload shape.
    """
    if not session_id:
        return None
    base = STATE_DIR.parent / ".codex" / "sessions"
    if not base.exists():
        return None
    matches = list(base.glob(f"**/rollout-*-{session_id}.jsonl"))
    if not matches:
        matches = list(base.glob(f"**/*{session_id}*.jsonl"))
    if not matches:
        return None
    return str(max(matches, key=lambda p: p.stat().st_mtime))


def _codex_read_session_posture(session_id: str) -> dict:
    """Best-effort read of a live run's posture from the rollout head.

    Codex omits sandbox/approval from its hook payloads but records it on the
    ``session_meta`` / first ``turn_context`` lines, so enrich the live
    SessionStart with whatever is already written. Returns ``{}`` if nothing is
    available yet (the first turn_context may lag the SessionStart hook)."""
    transcript = _find_codex_transcript(session_id)
    if not transcript:
        return {}
    meta = turn = None
    try:
        with open(transcript, "r", encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i > 50 or (meta is not None and turn is not None):
                    break
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if obj.get("type") == "session_meta" and meta is None:
                    meta = obj.get("payload")
                elif obj.get("type") == "turn_context" and turn is None:
                    turn = obj.get("payload")
    except OSError:
        return {}
    out: dict = {}
    cfg = _codex_session_config(meta, turn)
    if cfg:
        out["codex"] = cfg
        if cfg.get("model"):
            out["model"] = cfg["model"]
    if isinstance(meta, dict) and meta.get("cwd"):
        out.setdefault("cwd", meta.get("cwd"))
    return out


def _emit_codex_events(body: dict, source: str) -> None:
    """Run Codex's shared parser, with its no-transcript Stop fallback."""
    session_id = body.get("session_id")
    transcript = body.get("transcript_path") or _find_codex_transcript(session_id)
    hook = body.get("hook_event_name") or body.get("hook") or ""
    readable = bool(transcript and Path(str(transcript)).is_file())
    if readable and session_id:
        events = _scan_live_ingest_events(
            source, str(transcript), session_id, body.get("timestamp")
        )
        events = _fold_usage_metadata_into_hook_body(events, body)
        _post_ingest_events(source, _enrich_live_events(events, body))
    if hook not in ("Stop", "SubagentStop") or not session_id or readable:
        return
    msg = str(body.get("last_assistant_message") or "").strip()
    if not msg:
        return
    _post_ingest_events(source, [
        _shell_response_event(source, body, msg, label="fallback")
    ])


def _hook_response(source: str, body: dict) -> dict | None:
    hook = body.get("hook_event_name") or body.get("hook") or body.get("event") or ""
    if source == "cursor":
        if hook in CURSOR_ALLOW_HOOKS:
            return {"permission": "allow"}
        return {"continue": True}
    if source == "codex":
        # Codex's hook engine rejects the {continue, suppressOutput} envelope on
        # tool-use events and marks the run "Failed". Emit nothing there (exit 0
        # with no output is a pass); for the rest, the passive continue is fine.
        if hook in ("PreToolUse", "PostToolUse", "PermissionRequest"):
            return None
        return {"continue": True}
    return {"continue": True, "suppressOutput": True}


def _log_launch(body: dict) -> None:
    """Debug aid: record the process tree that started a Claude session, so we
    can see what spawns the empty home-directory sessions."""
    try:
        import subprocess

        STATE_DIR.mkdir(parents=True, exist_ok=True)
        log = STATE_DIR / "session-launches.log"
        lines = [
            f"=== {body.get('timestamp') or ''} session={body.get('session_id')} "
            f"source={body.get('source')} cwd={body.get('cwd')}"
        ]
        pid = os.getppid()  # the claude process that ran this hook
        for _ in range(8):
            if pid <= 1:
                break
            row = subprocess.run(
                ["ps", "-o", "pid=,ppid=,command=", "-p", str(pid)],
                capture_output=True, text=True, timeout=2,
            ).stdout.strip()
            if not row:
                break
            lines.append("  " + row)
            ppid = subprocess.run(
                ["ps", "-o", "ppid=", "-p", str(pid)],
                capture_output=True, text=True, timeout=2,
            ).stdout.strip()
            pid = int(ppid) if ppid.isdigit() else 0
        with log.open("a", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
    except Exception:
        pass


AGENTS = ("claude", "cursor", "codex", "opencode", "hermes")
OPENCODE_EVENTS = (
    "SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse",
    "PostToolUseFailure", "afterAgentResponse", "afterAgentThought",
    "OpenCodeUsage", "PermissionRequest", "PostCompact", "Stop",
)
OPENCODE_PLUGIN_MARKER = 'id: "cot.observability"'
HERMES_EVENTS = (
    "SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "PostToolUseFailure",
    "afterAgentResponse", "ModelUsage", "ApiRequestError", "PermissionRequest",
    "PermissionGranted", "PermissionDenied", "Notification", "SubagentStart",
    "SubagentStop", "PostCompact", "Stop", "SessionEnd",
)
HERMES_PLUGIN_MARKER = "id: cot.observability"
HERMES_PLUGIN_FILES = ("plugin.yaml", "__init__.py")


def _hermes_home() -> Path:
    return Path(os.environ.get("HERMES_HOME") or Path.home() / ".hermes")

# Where each agent reads its hook config, and whether it is a Cursor-style file
# (a top-level "version" alongside "hooks") vs. a Claude/Codex-style file.
_CONFIG_TARGETS = {
    "claude": (Path.home() / ".claude" / "settings.json", False),
    "cursor": (Path.home() / ".cursor" / "hooks.json", True),
    "codex": (Path.home() / ".codex" / "hooks.json", False),
    "opencode": (Path.home() / ".config" / "opencode" / "plugins" / "cot.js", False),
    "hermes": (_hermes_home() / "plugins" / "cot" / "__init__.py", False),
}


def _hook_command(agent: str) -> str:
    """Portable bridge path — agents expand ``$HOME`` when invoking hook commands."""
    return f"$HOME/.cot/bin/cot hook {agent}"


def _cot_hook_signature(agent: str) -> str:
    """Stable substring for detecting cot hook wiring without false positives."""
    return f".cot/bin/cot hook {agent}"


def _hook_commands_in_entry(entry: dict) -> list[str]:
    cmds: list[str] = []
    if not isinstance(entry, dict):
        return cmds
    for hook in entry.get("hooks") or []:
        if isinstance(hook, dict) and isinstance(hook.get("command"), str):
            cmds.append(hook["command"])
    if isinstance(entry.get("command"), str):
        cmds.append(entry["command"])
    return cmds


def _entry_has_cot_hook(entry: dict, agent: str) -> bool:
    sig = _cot_hook_signature(agent)
    return any(sig in cmd for cmd in _hook_commands_in_entry(entry))


def _entries_have_cot_hook(entries: list, agent: str) -> bool:
    return any(_entry_has_cot_hook(entry, agent) for entry in entries if isinstance(entry, dict))


def _normalize_cot_hooks(entries: list, agent: str) -> list:
    """Rewrite any cot hook command to the canonical ``$HOME`` form."""
    cmd = _hook_command(agent)
    sig = _cot_hook_signature(agent)
    out: list = []
    for entry in entries:
        if not isinstance(entry, dict):
            out.append(entry)
            continue
        if not _entry_has_cot_hook(entry, agent):
            out.append(entry)
            continue
        new_entry = dict(entry)
        if "hooks" in new_entry:
            new_hooks = []
            for hook in new_entry.get("hooks") or []:
                if not isinstance(hook, dict):
                    new_hooks.append(hook)
                    continue
                hook_cmd = hook.get("command", "")
                if isinstance(hook_cmd, str) and sig in hook_cmd:
                    new_hooks.append({**hook, "command": cmd})
                else:
                    new_hooks.append(hook)
            new_entry["hooks"] = new_hooks
        elif isinstance(new_entry.get("command"), str) and sig in new_entry["command"]:
            new_entry["command"] = cmd
        out.append(new_entry)
    return out


def _claude_style_hooks(agent: str, events: list[tuple[str, bool]]) -> dict:
    """Claude/Codex hook shape: each event maps to a list of groups, each with a
    `hooks` array of command entries (and an optional tool `matcher`)."""
    cmd = _hook_command(agent)
    out: dict[str, list] = {}
    for name, matcher in events:
        group: dict = {"hooks": [{"type": "command", "command": cmd}]}
        if matcher:
            group = {"matcher": "*", **group}
        out[name] = [group]
    return out


def _hook_templates() -> dict[str, dict]:
    return {
        "claude": _claude_style_hooks(
            "claude",
            [
                ("SessionStart", False),
                ("SessionEnd", False),
                ("UserPromptSubmit", False),
                ("PreToolUse", True),
                ("PostToolUse", True),
                ("PostToolUseFailure", True),
                ("Stop", False),
                ("SubagentStop", False),
                ("PreCompact", False),
                ("Notification", False),
            ],
        ),
        "codex": _claude_style_hooks(
            "codex",
            [
                ("SessionStart", False),
                ("UserPromptSubmit", False),
                ("PreToolUse", True),
                ("PostToolUse", True),
                ("PermissionRequest", True),
                ("PreCompact", False),
                ("PostCompact", False),
                ("SubagentStart", True),
                ("SubagentStop", True),
                ("Stop", False),
            ],
        ),
        # Cursor fires both granular hooks (beforeShellExecution, afterFileEdit,
        # before/afterMCPExecution, beforeReadFile) AND generic pre/postToolUse
        # for the same action. The generic pair carries the richest, most uniform
        # payload (tool_input, tool_output, duration, model) and fires for *every*
        # tool — shell, read, edit, search, subagent, delete, web, and MCP — so we
        # wire only those and skip the granular duplicates to avoid double-counting.
        "cursor": {
            name: [{"command": _hook_command("cursor")}]
            for name in (
                "sessionStart",
                "sessionEnd",
                "beforeSubmitPrompt",
                "afterAgentResponse",
                "afterAgentThought",
                "preToolUse",
                "postToolUse",
                "postToolUseFailure",
                "subagentStart",
                "subagentStop",
                "preCompact",
                "stop",
            )
        },
    }


def _template_events(template: dict) -> list[str]:
    return list(template.keys())


def _read_json_file(path: Path) -> tuple[dict, str | None]:
    try:
        parsed = json.loads(path.read_text() or "{}")
    except FileNotFoundError:
        return {}, "missing"
    except json.JSONDecodeError as exc:
        return {}, f"invalid json: {exc}"
    except OSError as exc:
        return {}, str(exc)
    if not isinstance(parsed, dict):
        return {}, "json root is not an object"
    return parsed, None


def _read_backup_manifest() -> dict:
    data, err = _read_json_file(HOOK_BACKUPS_PATH)
    if err:
        return {"entries": []}
    entries = data.get("entries")
    return {"entries": entries if isinstance(entries, list) else []}


def _write_backup_manifest(manifest: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    manifest["updated_at"] = _now_z()
    HOOK_BACKUPS_PATH.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n")


def _backup_entries(agent: str) -> list[dict]:
    entries = _read_backup_manifest().get("entries", [])
    return [e for e in entries if isinstance(e, dict) and e.get("agent") == agent]


def _latest_backup(agent: str) -> dict | None:
    entries = _backup_entries(agent)
    if not entries:
        return None
    return sorted(entries, key=lambda e: str(e.get("created_at") or ""))[-1]


def _backup_config(agent: str, path: Path, action: str) -> dict | None:
    import shutil

    if not path.exists():
        return None
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = path.with_name(f"{path.name}.cot-{stamp}.bak")
    shutil.copy2(path, backup)
    entry = {
        "agent": agent,
        "config_path": str(path),
        "backup_path": str(backup),
        "created_at": _now_z(),
        "action": action,
        "endpoint": COT_ENDPOINT,
    }
    manifest = _read_backup_manifest()
    manifest.setdefault("entries", []).append(entry)
    _write_backup_manifest(manifest)
    _audit_self(
        "bridge.hooks.backup_created",
        target=agent,
        detail=entry,
    )
    return entry


def _hermes_bin() -> str | None:
    import shutil
    found = shutil.which("hermes")
    if found:
        return found
    local = Path.home() / ".local" / "bin" / "hermes"
    return str(local) if local.exists() else None


def _hermes_plugin_enabled() -> bool | None:
    """Whether ``cot`` is in config.yaml's ``plugins.enabled``; None when unknown.

    A line scan rather than a YAML parser (the bridge is stdlib-only); it reads
    the block and flow list styles Hermes itself writes."""
    try:
        text = (_hermes_home() / "config.yaml").read_text()
    except OSError:
        return None
    section = sub = None
    enabled: list[str] = []
    for line in text.splitlines():
        stripped = line.split("#", 1)[0].rstrip()
        if not stripped.strip():
            continue
        indent = len(stripped) - len(stripped.lstrip())
        if indent == 0:
            section = "plugins" if stripped.strip() == "plugins:" else None
            sub = None
            continue
        if section != "plugins":
            continue
        body = stripped.strip()
        if indent == 2 and ":" in body and not body.startswith("-"):
            key, _, rest = body.partition(":")
            sub = key.strip()
            rest = rest.strip()
            if sub == "enabled" and rest.startswith("["):
                enabled += [x.strip().strip("'\"") for x in rest.strip("[]").split(",") if x.strip()]
            continue
        if sub == "enabled" and body.startswith("-"):
            enabled.append(body[1:].strip().strip("'\""))
    return "cot" in enabled


def _hermes_status() -> dict:
    agent = "hermes"
    path = _CONFIG_TARGETS[agent][0]
    try:
        content = path.read_text()
    except OSError:
        content = ""
    copied = HERMES_PLUGIN_MARKER in content and (path.parent / "plugin.yaml").exists()
    enabled = _hermes_plugin_enabled() if copied else False
    installed = copied and enabled is not False
    warnings = []
    if not copied:
        warnings.append("plugin_missing")
    elif enabled is False:
        warnings.append("plugin_disabled")
    expected = list(HERMES_EVENTS)
    return {
        "agent": agent,
        "config_path": str(path.parent),
        "config_exists": path.exists(),
        "valid_json": None,
        "error": None,
        "installed": installed,
        "expected_hooks": expected,
        "installed_hooks": expected if installed else [],
        "missing_hooks": [] if installed else expected,
        "backup_count": len(_backup_entries(agent)),
        "latest_backup": _latest_backup(agent),
        "warnings": warnings,
    }


def _hermes_install(action: str) -> dict:
    agent = "hermes"
    path = _CONFIG_TARGETS[agent][0]
    if not _hermes_home().is_dir():
        # "all" includes Hermes; don't create ~/.hermes for people without it.
        status = _hermes_status()
        status.update({"changed": False, "backup_created": None, "status": "ok", "skipped": True})
        return status
    try:
        current = path.read_text()
    except FileNotFoundError:
        current = None
    if current is not None and HERMES_PLUGIN_MARKER not in current:
        raise ValueError(f"{path.parent} exists and is not cot's plugin; move it before installing")
    files: dict[str, str] = {}
    for name in HERMES_PLUGIN_FILES:
        req = urllib.request.Request(f"{COT_ENDPOINT}/hermes-plugin/{name}")
        with urllib.request.urlopen(req, timeout=10) as response:
            files[name] = response.read().decode("utf-8")
    if HERMES_PLUGIN_MARKER not in files["__init__.py"]:
        raise ValueError("collector returned an invalid Hermes plugin")
    changed = any(
        not (path.parent / name).exists() or (path.parent / name).read_text() != text
        for name, text in files.items()
    )
    backup = None
    if changed:
        path.parent.mkdir(parents=True, exist_ok=True)
        backup = _backup_config(agent, path, action)
        for name, text in files.items():
            (path.parent / name).write_text(text)
    if _hermes_plugin_enabled() is not True:
        # Hermes loads user plugins only once they are on plugins.enabled; its
        # own command edits config.yaml so cot never rewrites the user's YAML.
        hermes = _hermes_bin()
        if hermes:
            try:
                import subprocess
                subprocess.run([hermes, "plugins", "enable", "cot"], stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               timeout=60, check=False)
                changed = True
            except (OSError, subprocess.SubprocessError):
                pass
    status = _hermes_status()
    status.update({"changed": changed, "backup_created": backup, "status": "ok"})
    return status


def _hermes_uninstall(action: str) -> dict:
    agent = "hermes"
    path = _CONFIG_TARGETS[agent][0]
    try:
        content = path.read_text()
    except FileNotFoundError:
        content = None
    if content is not None and HERMES_PLUGIN_MARKER not in content:
        return {"agent": agent, "config_path": str(path.parent), "changed": False,
                "backup_created": None, "status": "error", "error": "plugin folder is not owned by cot"}
    backup = None
    if content is not None:
        backup = _backup_config(agent, path, action)
        hermes = _hermes_bin()
        if hermes and _hermes_plugin_enabled():
            try:
                import subprocess
                subprocess.run([hermes, "plugins", "disable", "cot"], stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               timeout=60, check=False)
            except (OSError, subprocess.SubprocessError):
                pass
        for name in HERMES_PLUGIN_FILES:
            (path.parent / name).unlink(missing_ok=True)
        import shutil
        shutil.rmtree(path.parent / "__pycache__", ignore_errors=True)
        try:
            path.parent.rmdir()
        except OSError:
            pass
    return {"agent": agent, "config_path": str(path.parent), "changed": content is not None,
            "backup_created": backup, "status": "ok"}


def _agent_hook_status(agent: str) -> dict:
    if agent == "hermes":
        return _hermes_status()
    if agent == "opencode":
        path = _CONFIG_TARGETS[agent][0]
        try:
            content = path.read_text()
        except OSError:
            content = ""
        installed = OPENCODE_PLUGIN_MARKER in content
        expected = list(OPENCODE_EVENTS)
        return {
            "agent": agent,
            "config_path": str(path),
            "config_exists": path.exists(),
            "valid_json": None,
            "error": None,
            "installed": installed,
            "expected_hooks": expected,
            "installed_hooks": expected if installed else [],
            "missing_hooks": [] if installed else expected,
            "backup_count": len(_backup_entries(agent)),
            "latest_backup": _latest_backup(agent),
            "warnings": [] if installed else ["plugin_missing"],
        }
    path, _ = _CONFIG_TARGETS[agent]
    expected = _template_events(_hook_templates()[agent])
    config, err = _read_json_file(path)
    exists = path.exists()
    valid_json = err is None
    hooks = config.get("hooks") if isinstance(config.get("hooks"), dict) else {}
    installed_hooks: list[str] = []
    if valid_json:
        for name in expected:
            entries = hooks.get(name)
            if isinstance(entries, list) and _entries_have_cot_hook(entries, agent):
                installed_hooks.append(name)
    missing_hooks = [name for name in expected if name not in installed_hooks]
    latest = _latest_backup(agent)
    backups = _backup_entries(agent)
    warnings: list[str] = []
    if not exists:
        warnings.append("config_missing")
    elif not valid_json:
        warnings.append("config_invalid")
    if missing_hooks:
        warnings.append("hooks_missing")
    return {
        "agent": agent,
        "config_path": str(path),
        "config_exists": exists,
        "valid_json": valid_json,
        "error": None if err == "missing" else err,
        "installed": valid_json and not missing_hooks,
        "expected_hooks": expected,
        "installed_hooks": installed_hooks,
        "missing_hooks": missing_hooks,
        "backup_count": len(backups),
        "latest_backup": latest,
        "warnings": warnings,
    }


def _merge_hooks(existing: dict, template: dict, agent: str) -> dict:
    """Add cot's command for each event without disturbing the user's own hooks.
    Idempotent: if cot is already wired into an event, normalize its command;
    otherwise append cot alongside any existing hooks."""
    merged = dict(existing) if isinstance(existing, dict) else {}
    for event, entries in template.items():
        current = merged.get(event)
        if not isinstance(current, list):
            # A bare dict entry is a valid user hook in some configs — keep it
            # rather than dropping it on merge.
            current = [current] if isinstance(current, dict) else []
        if _entries_have_cot_hook(current, agent):
            merged[event] = _normalize_cot_hooks(current, agent)
        else:
            merged[event] = current + entries
    return merged


def _remove_hooks(existing: dict, agent: str) -> dict:
    """Remove only cot hook entries, preserving any user-managed hooks."""
    cleaned = dict(existing) if isinstance(existing, dict) else {}
    for event, entries in list(cleaned.items()):
        if not isinstance(entries, list):
            continue
        kept = [entry for entry in entries if not _entry_has_cot_hook(entry, agent)]
        if kept:
            cleaned[event] = kept
        else:
            cleaned.pop(event, None)
    return cleaned


def _hooks_installed(agent: str) -> bool:
    return bool(_agent_hook_status(agent)["installed"])


def _install_agent(agent: str, action: str = "install") -> dict:
    if agent == "hermes":
        return _hermes_install(action)
    if agent == "opencode":
        path = _CONFIG_TARGETS[agent][0]
        try:
            current = path.read_text()
        except FileNotFoundError:
            current = None
        if current is not None and OPENCODE_PLUGIN_MARKER not in current:
            raise ValueError(f"{path} exists and is not cot's plugin; move it before installing")
        req = urllib.request.Request(f"{COT_ENDPOINT}/opencode-plugin.js")
        with urllib.request.urlopen(req, timeout=10) as response:
            plugin = response.read().decode("utf-8")
        if OPENCODE_PLUGIN_MARKER not in plugin:
            raise ValueError("collector returned an invalid OpenCode plugin")
        changed = current != plugin
        backup = None
        if changed:
            path.parent.mkdir(parents=True, exist_ok=True)
            backup = _backup_config(agent, path, action)
            path.write_text(plugin)
        status = _agent_hook_status(agent)
        status.update({"changed": changed, "backup_created": backup, "status": "ok"})
        return status
    path, cursor_style = _CONFIG_TARGETS[agent]
    template = _hook_templates()[agent]

    config, err = _read_json_file(path)
    if err == "missing":
        config = {}

    existing = config.get("hooks") if isinstance(config.get("hooks"), dict) else {}
    next_config = dict(config)
    next_config["hooks"] = _merge_hooks(existing, template, agent)
    if cursor_style:
        next_config.setdefault("version", 1)
    changed = next_config != config or err not in (None, "missing")
    backup = None
    if changed:
        path.parent.mkdir(parents=True, exist_ok=True)
        backup = _backup_config(agent, path, action)
        path.write_text(json.dumps(next_config, indent=2) + "\n")
    status = _agent_hook_status(agent)
    status.update(
        {
            "changed": changed,
            "backup_created": backup,
            "status": "ok",
        }
    )
    return status


def _uninstall_agent(agent: str, action: str = "uninstall") -> dict:
    if agent == "hermes":
        return _hermes_uninstall(action)
    if agent == "opencode":
        path = _CONFIG_TARGETS[agent][0]
        try:
            content = path.read_text()
        except FileNotFoundError:
            content = None
        if content is not None and OPENCODE_PLUGIN_MARKER not in content:
            return {"agent": agent, "config_path": str(path), "changed": False,
                    "backup_created": None, "status": "error", "error": "plugin file is not owned by cot"}
        backup = None
        if content is not None:
            backup = _backup_config(agent, path, action)
            path.unlink()
        return {"agent": agent, "config_path": str(path), "changed": content is not None,
                "backup_created": backup, "status": "ok"}
    path, _ = _CONFIG_TARGETS[agent]
    config, err = _read_json_file(path)
    if err == "missing":
        return {
            "agent": agent,
            "config_path": str(path),
            "changed": False,
            "backup_created": None,
            "status": "ok",
        }
    if err:
        return {
            "agent": agent,
            "config_path": str(path),
            "changed": False,
            "backup_created": None,
            "status": "error",
            "error": err,
        }

    existing = config.get("hooks") if isinstance(config.get("hooks"), dict) else {}
    next_config = dict(config)
    next_hooks = _remove_hooks(existing, agent)
    if next_hooks:
        next_config["hooks"] = next_hooks
    else:
        next_config.pop("hooks", None)

    changed = next_config != config
    backup = None
    if changed:
        backup = _backup_config(agent, path, action)
        path.write_text(json.dumps(next_config, indent=2) + "\n")
    return {
        "agent": agent,
        "config_path": str(path),
        "changed": changed,
        "backup_created": backup,
        "status": "ok",
    }


def _write_hook_status() -> None:
    """Record installed hook status where the collector can read it.

    The collector runs in Docker with ~/.cot mounted, so it cannot inspect
    agent config directories directly. This manifest is the bridge's small,
    content-free handoff to the dashboard.
    """
    status = {
        "updated_at": _now_z(),
        "endpoint": COT_ENDPOINT,
        "agents": {agent: _agent_hook_status(agent) for agent in AGENTS},
    }
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    HOOK_STATUS_PATH.write_text(json.dumps(status, indent=2) + "\n")


def _cmd_install(args: list[str]) -> int:
    agents = [a for a in args if a in AGENTS]
    if not agents:
        agents = list(AGENTS)
    repair = os.environ.get("COT_REPAIR") in ("1", "true", "yes")
    action = "repair" if repair else "install"
    results: list[dict] = []
    for agent in agents:
        try:
            result = _install_agent(agent, action=action)
            results.append(result)
            if result.get("skipped"):
                print(f"cot: {agent} not found ({result['config_path']}); skipped")
                continue
            verb = "repaired" if repair else "wired up"
            print(f"cot: {verb} {agent} hooks -> {result['config_path']}")
            if result.get("backup_created"):
                print(f"cot: backup saved -> {result['backup_created']['backup_path']}")
            elif not result.get("changed"):
                print(f"cot: {agent} hooks already up to date")
        except (OSError, ValueError, urllib.error.URLError) as exc:
            results.append(
                {
                    "agent": agent,
                    "config_path": str(_CONFIG_TARGETS[agent][0]),
                    "status": "error",
                    "error": str(exc),
                }
            )
            print(f"cot: failed to wire up {agent}: {exc}", file=sys.stderr)
    try:
        _write_hook_status()
        status_written = True
    except OSError as exc:
        status_written = False
        print(f"cot: failed to write hook status: {exc}", file=sys.stderr)
    audit_detail = {
        "agents": [
            {
                "agent": r.get("agent") or r.get("target"),
                "config_path": r.get("config_path"),
                "status": r.get("status"),
                "changed": r.get("changed"),
                "missing_hooks": r.get("missing_hooks"),
                "backup_path": (r.get("backup_created") or {}).get("backup_path")
                if isinstance(r.get("backup_created"), dict)
                else None,
            }
            for r in results
        ],
        "hook_status_path": str(HOOK_STATUS_PATH),
        "hook_status_written": status_written,
        "endpoint": COT_ENDPOINT,
    }
    _audit_self(
        "bridge.hooks.repaired" if repair else "bridge.hooks.installed",
        target="hooks",
        status="ok" if all(r["status"] == "ok" for r in results) and status_written else "error",
        detail=audit_detail,
    )
    if "codex" in agents:
        print("cot: run /hooks in Codex to review and trust the new hooks.")

    if not status_written or any(r["status"] != "ok" for r in results):
        return 1

    # Auto-import historical transcripts after hook setup.
    if os.environ.get("COT_SKIP_IMPORT") in ("1", "true", "yes"):
        return 0
    if all(agent == "opencode" for agent in agents):
        return 0
    print("cot: importing historical transcripts…")
    try:
        _reindex_if_parser_changed()
        origins = _fetch_session_origins()
        offsets = _import_offsets_load()
        total = 0
        for agent in agents:
            if agent == "opencode":
                continue  # Live plugin only; no historical OpenCode parser yet.
            count = _import_agent(agent, None, offsets, origins, verbose=False)
            total += count
        _import_offsets_save(offsets)
        _write_import_parser_version()
        if total:
            try:
                req = urllib.request.Request(
                    f"{COT_ENDPOINT}/v1/sessions/complete-imported",
                    method="POST",
                    headers={"Content-Type": "application/json"},
                    data=b"{}",
                )
                urllib.request.urlopen(req, timeout=10)
            except (urllib.error.URLError, TimeoutError, OSError):
                pass
            print(f"cot: imported {total} events from existing transcripts")
        else:
            print("cot: no new transcripts to import")
    except Exception as exc:
        print(f"cot: transcript import skipped ({exc})", file=sys.stderr)

    # Recover AskQuestion answers from the transcripts (best-effort).
    try:
        recovered = _recover_questions()
        if recovered:
            print(f"cot: recovered {recovered} question answer(s)")
    except Exception:
        pass

    return 0


def _cmd_status() -> int:
    status = {agent: _hooks_installed(agent) for agent in AGENTS}
    out = {"endpoint": COT_ENDPOINT, "hooks": status}
    queued = _spool_count()
    if queued:
