# -------------------------------------------------------------- Cursor IDE
# The Cursor editor's own chat history, beside the agent transcripts in
# ~/.cursor: <User>/globalStorage/state.vscdb, table cursorDiskKV. Each
# "composerData:<id>" row is a chat (name, workspace, timestamps, and its
# bubbles in order in fullConversationHeadersOnly); each
# "bubbleId:<composer>:<bubble>" row is one turn: type 1 the person, type 2
# the model, with a tool call inline in toolFormerData. Chats the transcript
# reader or the hooks already brought in are left alone.

def _cursor_ide_index(root: Path) -> list[dict]:
    db_path = root / "globalStorage" / "state.vscdb"
    rows = _sqlite_rows(db_path,
                        "SELECT substr(key, 14) AS id, json_extract(value, '$.name') AS name,"
                        " json_extract(value, '$.createdAt') AS created,"
                        " json_extract(value, '$.lastUpdatedAt') AS updated,"
                        " json_array_length(value, '$.fullConversationHeadersOnly') AS n, length(value) AS size"
                        " FROM cursorDiskKV WHERE key >= 'composerData:' AND key < 'composerData;'")
    return [{"id": r["id"], "title": r["name"], "started": r["created"],
             "updated": _reader_epoch(r["updated"] or r["created"]), "weight": r["n"] or 0,
             "bytes": r["size"] or 0, "_db": db_path} for r in rows if r["n"]]


def _cursor_ide_items(session: dict, root: Path) -> list[dict]:
    cid = session["id"]
    doc_rows = _sqlite_rows(session["_db"], "SELECT value FROM cursorDiskKV WHERE key = ?", (f"composerData:{cid}",))
    doc = _reader_json(doc_rows[0]["value"]) if doc_rows else None
    if not isinstance(doc, dict):
        return []
    ws = ((doc.get("workspaceIdentifier") or {}).get("uri") or {}) if isinstance(doc.get("workspaceIdentifier"), dict) else {}
    repos = doc.get("trackedGitRepos") if isinstance(doc.get("trackedGitRepos"), list) else []
    session["cwd"] = ws.get("fsPath") or (repos[0].get("repoPath") if repos and isinstance(repos[0], dict) else None)
    lo, hi = f"bubbleId:{cid}:", f"bubbleId:{cid};"
    bubbles = {r["key"][len(lo):]: _reader_json(r["value"]) for r in _sqlite_rows(
        session["_db"], "SELECT key, value FROM cursorDiskKV WHERE key >= ? AND key < ?", (lo, hi))}
    items: list[dict] = []
    for h in doc.get("fullConversationHeadersOnly") or []:
        b = bubbles.get(h.get("bubbleId")) if isinstance(h, dict) else None
        if not isinstance(b, dict):
            continue
        bid, ts, text = h["bubbleId"], b.get("createdAt"), b.get("text") or ""
        model = (b.get("modelInfo") or {}).get("modelName") if isinstance(b.get("modelInfo"), dict) else None
        if b.get("type") == 1:
            items.append({"kind": "prompt", "id": bid, "ts": ts, "text": text})
            continue
        if b.get("type") != 2:
            continue
        thinking = b.get("thinking")
        thought = thinking.get("text") if isinstance(thinking, dict) else thinking if isinstance(thinking, str) else None
        if thought:
            items.append({"kind": "thought", "id": f"{bid}:t", "ts": ts, "text": thought})
        tool = b.get("toolFormerData") if isinstance(b.get("toolFormerData"), dict) else None
        if tool and tool.get("name"):
            result = _reader_json(tool.get("result"))
            status = str(tool.get("status") or "")
            items.append({"kind": "tool", "id": tool.get("toolCallId") or bid, "ts": ts, "name": tool["name"],
                          "input": tool.get("rawArgs") or tool.get("params"),
                          **({"output": result if isinstance(result, str) else _reader_text(result) or result,
                              "failed": status in ("error", "cancelled")} if status not in ("", "loading", "pending") else {})})
        items.append({"kind": "response", "id": bid, "ts": ts, "text": text, "model": model})
        tokens = b.get("tokenCount") if isinstance(b.get("tokenCount"), dict) else None
        if tokens and (tokens.get("inputTokens") or tokens.get("outputTokens")):
            items.append({"kind": "usage", "id": bid, "ts": ts, "model": model, "usage": {
                "input_tokens": int(tokens.get("inputTokens") or 0), "output_tokens": int(tokens.get("outputTokens") or 0)}})
    return items


