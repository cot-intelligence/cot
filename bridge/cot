# When the collector is unreachable, ingest events are appended here as JSONL
# ({"path", "payload"} per line) and replayed on the next successful contact, so
# a stopped or restarting collector never silently drops a session's events.
SPOOL_PATH = STATE_DIR / "spool.jsonl"
SPOOL_LOCK_PATH = STATE_DIR / "spool.lock"
# Hard cap on the spool. If the collector stays down long enough to exceed it,
# the oldest events are dropped to bound disk use (recoverable via `cot import`).
_MAX_SPOOL_BYTES = 50 * 1024 * 1024
# Per-flush batch cap so a large backlog drains across several hook invocations
# instead of blocking any single one on a long network drain.
_SPOOL_FLUSH_BATCH = 500
# Set when a send finds the collector unreachable. A hung collector makes every
# send wait out its timeout and agents block on their hooks, so while this is
# fresh, hooks (in any process) skip the network and spool directly. Once it
# goes stale, a short /health probe decides whether to try again.
COLLECTOR_DOWN_PATH = STATE_DIR / "collector_down"
_DOWN_BACKOFF_S = 10.0
_PROBE_TIMEOUT_S = 0.5

DEFAULT_ENDPOINT = "http://127.0.0.1:31337"

