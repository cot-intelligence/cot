def _forge_items(session: dict, root: Path) -> list[dict]:
    rows = _sqlite_rows(session["_db"], "SELECT context FROM conversations WHERE conversation_id = ?", (session["id"],))
    ctx = _reader_json(rows[0]["context"]) if rows else None
    records = []
    for e in (ctx.get("messages") or []) if isinstance(ctx, dict) else []:
        m = e.get("message", e) if isinstance(e, dict) else {}
        if isinstance(m.get("text"), dict):
            t = m["text"]
            content = t.get("content") or _first(t, "raw_content.Text") or ""
            records.append({"role": t.get("role"), "content": content, "model": t.get("model"),
