# --------------------------------------------------------------- Gemini CLI
# ~/.gemini/tmp/<project>/chats/session-*.json: one JSON document per session
# (newer releases append JSONL records, with ``$set`` lines updating the
# header). <project> is the SHA-256 of the project path or, lately, a short
# name; projects.json and trustedFolders.json map both back to the path.

def _gemini_projects(root: Path) -> dict[str, str]:
    paths: list[str] = []
    data = _read_json_doc(root / "projects.json")
    if isinstance(data, dict) and isinstance(data.get("projects"), dict):
        paths += [str(p) for p in data["projects"]]
        names = {str(v): str(k) for k, v in data["projects"].items() if isinstance(v, str)}
    else:
        names = {}
    trusted = _read_json_doc(root / "trustedFolders.json")
    if isinstance(trusted, dict):
        folders = trusted.get("trustedFolders", trusted)
        paths += [str(p) for p in (folders if isinstance(folders, (list, dict)) else [])]
    out = dict(names)
    for p in paths:
        out[hashlib.sha256(p.encode()).hexdigest()] = p
        out.setdefault(Path(p).name, p)
    return out


def _gemini_index(root: Path) -> list[dict]:
    out = []
    for path in sorted(root.glob("tmp/*/chats/session-*.json*")):
        if path.suffix not in (".json", ".jsonl"):
            continue
        s = _file_session(path, _head_field(path, "sessionId"))
        if s:
            s["_project"] = path.parent.parent.name
            out.append(s)
    return out


def _gemini_records(path: Path) -> tuple[dict, list[dict]]:
    if path.suffix == ".json":
        doc = _read_json_doc(path)
        if isinstance(doc, dict):
            return doc, [m for m in doc.get("messages") or [] if isinstance(m, dict)]
    header: dict = {}
    by_id: dict[str, int] = {}
    records: list[dict] = []
    for rec in _read_jsonl_file(path):
        if rec.get("sessionId"):
            header = {**rec, **header} if header else dict(rec)
        if isinstance(rec.get("$set"), dict):
            header.update(rec["$set"])
        if rec.get("type") not in ("user", "gemini"):
            continue
        mid = rec.get("id")
        if mid and mid in by_id:
            records[by_id[mid]] = rec  # a later write of the same message wins
            continue
        if mid:
            by_id[mid] = len(records)
        records.append(rec)
    return header, records


def _gemini_items(session: dict, root: Path) -> list[dict]:
    header, messages = _gemini_records(session["_path"])
    if header.get("sessionId"):
        session["id"] = header["sessionId"]
    session["started"] = header.get("startTime")
    session["title"] = header.get("summary")
    session["cwd"] = _gemini_projects(root).get(session.get("_project") or "")
    items: list[dict] = []
    for m in messages:
        mid, ts = m.get("id") or len(items), m.get("timestamp")
        if m.get("type") == "user":
            items.append({"kind": "prompt", "id": mid, "ts": ts, "text": _reader_text(m.get("content"))})
            continue
        if m.get("type") != "gemini":
            continue
        model = m.get("model")
        session["model"] = session.get("model") or model
        for i, t in enumerate(m.get("thoughts") or []):
            if isinstance(t, dict) and t.get("description"):
                text = f"{t['subject']}\n{t['description']}" if t.get("subject") else t["description"]
                items.append({"kind": "thought", "id": f"{mid}:{i}", "ts": t.get("timestamp") or ts, "text": text})
        items.append({"kind": "response", "id": mid, "ts": ts, "text": _reader_text(m.get("content")), "model": model})
        for tc in m.get("toolCalls") or []:
            if not isinstance(tc, dict):
                continue
            output = None
            for r in tc.get("result") or []:
                resp = ((r or {}).get("functionResponse") or {}).get("response") if isinstance(r, dict) else None
                if isinstance(resp, dict):
                    output = resp.get("output", resp.get("error", output))
            if output is None:
                output = tc.get("resultDisplay")
            status = tc.get("status")
            items.append({"kind": "tool", "id": tc.get("id") or f"{mid}:tool", "ts": tc.get("timestamp") or ts,
                          "name": tc.get("name"), "input": tc.get("args"), "output": output,
                          "failed": status in ("error", "cancelled") if status else None})
        tok = m.get("tokens")
        if isinstance(tok, dict):
            cached = int(tok.get("cached") or 0)
            items.append({"kind": "usage", "id": mid, "ts": ts, "model": model, "usage": {
                "input_tokens": max(0, int(tok.get("input") or 0) - cached),
                "output_tokens": int(tok.get("output") or 0) + int(tok.get("thoughts") or 0),
                "cache_read_tokens": cached, "reasoning_tokens": int(tok.get("thoughts") or 0),
            }})
    return items


# Same id as the OpenTelemetry source, so sessions it exported aren't imported twice.
_register(_Reader("gemini-cli", "Gemini CLI", (".gemini",), env="GEMINI_DIR", otel=True,
                  index=_gemini_index, items=_gemini_items))


# -------------------------------------------------------------- Copilot CLI
# ~/.copilot/session-state/<id>.jsonl, or <id>/events.jsonl in newer
# releases: one event per line (session.start, user.message, assistant.message,
# tool.execution_start/complete, session.model_change, session.shutdown).

def _copilot_index(root: Path) -> list[dict]:
    out: dict[str, dict] = {}
    state = root / "session-state"
    for path in sorted(state.glob("*/events.jsonl")):
        s = _file_session(path, path.parent.name)
        if s:
            out[s["id"]] = s
    for path in sorted(state.glob("*.jsonl")):
        if path.stem not in out:
            s = _file_session(path)
            if s:
                out[s["id"]] = s
    return list(out.values())


def _copilot_items(session: dict, root: Path) -> list[dict]:
    items: list[dict] = []
    tools: dict[str, dict] = {}
    model = None
    for n, ev in enumerate(_read_jsonl_file(session["_path"])):
        kind, ts = ev.get("type"), ev.get("timestamp")
        data = ev.get("data") if isinstance(ev.get("data"), dict) else {}
        eid = ev.get("id") or n
        if kind == "session.start":
            session["started"] = data.get("startTime") or ts
            ctx = data.get("context") if isinstance(data.get("context"), dict) else {}
            session["cwd"] = ctx.get("cwd") or session.get("cwd")
            model = data.get("selectedModel") or model
        elif kind == "session.model_change":
            model = data.get("newModel") or model
        elif kind == "user.message":
            text = str(data.get("content") or "")
            if str(data.get("source") or "").startswith("skill-") or text.startswith("<skill-context"):
                continue
            items.append({"kind": "prompt", "id": eid, "ts": ts, "text": text})
        elif kind == "assistant.message":
            m = data.get("model") or model
            session["model"] = session.get("model") or m
            if data.get("reasoningText"):
                items.append({"kind": "thought", "id": eid, "ts": ts, "text": data["reasoningText"]})
            items.append({"kind": "response", "id": eid, "ts": ts, "text": data.get("content") or "", "model": m})
            for req in data.get("toolRequests") or []:
                if isinstance(req, dict) and req.get("name"):
                    call = req.get("toolCallId") or f"{eid}:{req['name']}"
                    tools[call] = {"kind": "tool", "id": call, "ts": ts, "name": req["name"],
                                   "input": req.get("arguments")}
                    items.append(tools[call])
        elif kind == "tool.execution_start":
            call = data.get("toolCallId")
            if call and call not in tools:
                tools[call] = {"kind": "tool", "id": call, "ts": ts, "name": data.get("toolName"),
                               "input": data.get("arguments")}
                items.append(tools[call])
        elif kind == "tool.execution_complete":
            call = tools.get(data.get("toolCallId") or "")
            if call is not None:
                result = data.get("result")
                if isinstance(result, dict):
                    result = result.get("content", result.get("detailedContent", result))
                call.update(output=result, end_ts=ts, failed=data.get("success") is False)
        elif kind == "session.shutdown":
            for name, metrics in (data.get("modelMetrics") or {}).items():
                u = (metrics or {}).get("usage") if isinstance(metrics, dict) else None
                if not isinstance(u, dict):
                    continue
                read, write = int(u.get("cacheReadTokens") or 0), int(u.get("cacheWriteTokens") or 0)
                items.append({"kind": "usage", "id": f"shutdown:{name}", "ts": ts, "model": name, "usage": {
                    "input_tokens": max(0, int(u.get("inputTokens") or 0) - read - write),
                    "output_tokens": int(u.get("outputTokens") or 0), "cache_read_tokens": read,
                    "cache_write_tokens": write, "reasoning_tokens": int(u.get("reasoningTokens") or 0),
                }})
            items.append({"kind": "end", "id": "end", "ts": ts})
    return items


_register(_Reader("copilot-cli", "Copilot CLI", (".copilot",), env="COPILOT_DIR",
                  index=_copilot_index, items=_copilot_items))



# ------------------------------------------------------------ Claude Cowork
# The Claude desktop app's Cowork sessions run Claude Code in a sandbox and
# keep its transcripts there:
#   <org>/<workspace>/local_<id>.json                       title, chosen folders
#   <org>/<workspace>/local_<id>/.claude/projects/<enc>/<cli session>.jsonl
# The transcript's cwd is the sandbox; the folder the person picked is the
# project.

def _cowork_meta(path: Path) -> dict:
    for parent in path.parents:
        if parent.name.startswith("local_"):
            data = _read_json_doc(parent.with_name(parent.name + ".json"))
            if not isinstance(data, dict):
                return {}
            folders = data.get("userSelectedFolders")
