# --------------------------------------------------------- SQLite stores
# Agents that keep every session in one SQLite file. Each reader lists the
# sessions with one query and turns a session's rows into the chat-log
# records _chat_items reads, or into items directly.

def _zcode_index(root: Path) -> list[dict]:
    db_path = root / "db" / "db.sqlite"
    if not db_path.is_file():
        db_path = root / "db.sqlite"  # ZCODE_DIR pointed at the db folder itself
    return [{"id": r["id"], "cwd": r["directory"] or None, "title": r["title"], "started": r["time_created"],
             "updated": _reader_epoch(r["time_updated"] or r["time_created"]), "_db": db_path}
            for r in _sqlite_rows(db_path, "SELECT id, directory, title, time_created, time_updated FROM session")]


def _zcode_payloads(session: dict, root: Path) -> list[dict]:
    """ZCode is an OpenCode fork: the same message / part JSON, in its own tables."""
    db = session["_db"]
    parts: dict[str, list[dict]] = {}
    for r in _sqlite_rows(db, "SELECT id, message_id, data FROM part WHERE session_id = ? ORDER BY message_id, id",
                          (session["id"],)):
        data = _reader_json(r["data"])
        if isinstance(data, dict):
            parts.setdefault(r["message_id"], []).append({**data, "id": r["id"], "messageID": r["message_id"]})
    messages = []
    for r in _sqlite_rows(db, "SELECT id, data, time_created FROM message WHERE session_id = ? ORDER BY time_created, id",
                          (session["id"],)):
        info = _reader_json(r["data"])
        if isinstance(info, dict):
            info = {**info, "id": r["id"], "sessionID": session["id"]}
            info.setdefault("time", {}).setdefault("created", _reader_epoch(r["time_created"]) * 1000)
            messages.append((info, parts.get(r["id"], [])))
    raw = {"id": session["id"], "directory": session.get("cwd"), "title": session.get("title"),
           "created": _reader_epoch(session.get("started")) * 1000}
    reader = READERS["zcode"]
    out = []
    for p in _opencode_session_payloads(raw, messages):
        p = {**p, "_reader": "zcode", "_dedup_key": "zcode:" + str(p.get("_dedup_key") or "").split(":", 1)[-1]}
        if p.get("tool_name"):
            raw_name = p["tool_name"]
            p["tool_name"], p["tool_input"] = _reader_tool(reader, raw_name, p.get("tool_input"))
            if raw_name != p["tool_name"]:
                p["raw_tool_name"] = raw_name
        if p.get("hook_event_name") == "OpenCodeUsage":
            p["hook_event_name"] = "ModelUsage"
        out.append(p)
    for u in _sqlite_rows(db, "SELECT * FROM model_usage WHERE session_id = ?", (session["id"],)):
        out.append({"session_id": session["id"], "hook_event_name": "ModelUsage", "origin": "import", "_import": True,
                    "_reader": "zcode", "cwd": session.get("cwd"),
                    "timestamp": _reader_ts(u.get("completed_at") or u.get("started_at")) or _reader_ts(session.get("updated")),
                    "_dedup_key": f"zcode:{session['id']}:usage:{u.get('turn_id')}:{u.get('model_id')}",
                    "model": u.get("model_id"), "usage": _usage_counts(u)})
    return out


_register(_Reader("zcode", "ZCode", (".zcode/cli",), index=_zcode_index, payloads=_zcode_payloads,
                  tools={"list": "Search"}))


# Shelley: shelley.db, conversations (cwd, model, parent) and messages, whose
# llm_data is a serialized Go llm.Message: {Role, Content: [{Type, Text,
# Thinking, ToolName, ToolInput, ToolUseID, ToolResult, ToolError}]} with
# Type 2 text, 3 thinking, 5 tool use, 6 tool result.

def _shelley_index(root: Path) -> list[dict]:
    db_path = root / "shelley.db"
    return [{"id": r["conversation_id"], "title": r.get("slug"), "cwd": r.get("cwd") or None, "started": r.get("created_at"),
             "updated": _reader_epoch(r.get("updated_at") or r.get("created_at")), "model": r.get("model"),
             "parent_id": r.get("parent_conversation_id") or None, "_db": db_path}
            for r in _sqlite_rows(db_path, "SELECT * FROM conversations")]


def _shelley_items(session: dict, root: Path) -> list[dict]:
    items: list[dict] = []
    tools: dict = {}
    for r in _sqlite_rows(session["_db"], "SELECT * FROM messages WHERE conversation_id = ? ORDER BY sequence_id",
                          (session["id"],)):
        kind, ts, seq = r.get("type"), r.get("created_at"), r.get("sequence_id")
        llm = _reader_json(r.get("llm_data"))
        blocks = llm.get("Content") if isinstance(llm, dict) and isinstance(llm.get("Content"), list) else []
        text: list[str] = []
        for i, b in enumerate(blocks):
            if not isinstance(b, dict):
                continue
            btype = b.get("Type")
            if btype == 2 and b.get("Text"):
                text.append(b["Text"])
            elif btype == 3 and b.get("Thinking"):
                items.append({"kind": "thought", "id": f"{seq}:{i}", "ts": ts, "text": b["Thinking"]})
            elif btype in (5, 7) and b.get("ToolName"):
                tid = b.get("ID") or f"{seq}:{i}"
                tools[tid] = {"kind": "tool", "id": tid, "ts": ts, "name": b["ToolName"], "input": b.get("ToolInput")}
                items.append(tools[tid])
            elif btype == 6 and tools.get(b.get("ToolUseID")) is not None:
                tools[b["ToolUseID"]].update(output="\n".join(str(x.get("Text") or "") for x in b.get("ToolResult") or []
                                                             if isinstance(x, dict)),
                                             end_ts=ts, failed=bool(b.get("ToolError")))
        if kind == "user" and text:
            items.append({"kind": "prompt", "id": seq, "ts": ts, "text": "\n".join(text)})
        elif kind == "agent" and text:
            items.append({"kind": "response", "id": seq, "ts": ts, "text": "\n".join(text), "model": session.get("model")})
        usage = _reader_json(r.get("usage_data"))
        if kind == "agent" and isinstance(usage, dict) and any(_usage_counts(usage).values()):
            items.append({"kind": "usage", "id": f"{seq}:u", "ts": ts, "model": session.get("model"), "usage": _usage_counts(usage)})
    return items


_register(_Reader("shelley", "Shelley", (".config/shelley",), index=_shelley_index, items=_shelley_items,
                  tools={"bash": "Bash", "patch": "Edit", "think": "Think", "keyword_search": "Grep"}))


# Omnigent: ~/.omnigent/chat.db, conversations and conversation_items (one
# Responses-API-style item per row: message, function_call,
# function_call_output, reasoning …; ``type`` is a name or, in newer
# databases, a small integer).
_OMNIGENT_TYPES = {1: "message", 2: "function_call", 3: "function_call_output", 4: "reasoning"}


def _omnigent_index(root: Path) -> list[dict]:
    db_path = root / "chat.db"
    out = []
    for r in _sqlite_rows(db_path, "SELECT * FROM conversations"):
        cid = r.get("id") or r.get("conversation_id")
        if cid is None:
            continue
        out.append({"id": str(cid), "title": r.get("title") or r.get("name"),
                    "cwd": r.get("cwd") or r.get("working_directory") or r.get("workspace_path"),
                    "started": r.get("created_at"), "updated": _reader_epoch(r.get("updated_at") or r.get("created_at")),
                    "_db": db_path, "_ws": r.get("workspace_id")})
    return out


def _omnigent_items(session: dict, root: Path) -> list[dict]:
    rows = _sqlite_rows(session["_db"], "SELECT position, type, data FROM conversation_items"
                                        " WHERE workspace_id IS ? AND conversation_id = ? ORDER BY position",
                        (session.get("_ws"), session["id"]))
    records = []
    for r in rows:
        data = _reader_json(r["data"])
        if isinstance(data, dict):
            rtype = _OMNIGENT_TYPES.get(r["type"], r["type"]) if isinstance(r["type"], int) else r["type"]
            records.append({**data, "type": rtype if rtype != "message" else data.get("role") or "message",
                            "id": r["position"]})
    session["_id_set"] = True
    return _chat_items(records, session)


_register(_Reader("omnigent", "Omnigent", (".omnigent",), index=_omnigent_index, items=_omnigent_items,
                  tools={"sys_os_shell": "Bash", "sys_os_read": "Read", "sys_os_write": "Write"}))


# Piebald: app.db, chats and messages, each message split into parts: text
# parts (content in message_content_nodes / message_node_text) and tool-call
# parts (message_part_tool_call: tool name, input, result, error).

def _piebald_index(root: Path) -> list[dict]:
    db_path = root / "app.db"
    return [{"id": str(r["id"]), "title": r.get("title"), "started": r.get("created_at"),
             "updated": _reader_epoch(r.get("updated_at") or r.get("created_at")),
             "weight": r.get("message_count"), "cwd": r.get("working_directory") or r.get("cwd"), "_db": db_path}
            for r in _sqlite_rows(db_path, "SELECT * FROM chats WHERE COALESCE(is_deleted, 0) = 0 AND message_count > 0")]


def _piebald_items(session: dict, root: Path) -> list[dict]:
    db = session["_db"]
    items: list[dict] = []
    for m in _sqlite_rows(db, "SELECT * FROM messages WHERE parent_chat_id = ? ORDER BY created_at, id", (session["id"],)):
        ts, mid, role, model = m.get("created_at"), m.get("id"), m.get("role"), m.get("model") or None
        text: list[str] = []
        for part in _sqlite_rows(db, "SELECT id, part_type FROM message_parts WHERE parent_chat_message_id = ?"
                                     " ORDER BY part_index, id", (mid,)):
            if part["part_type"] == "text":
                thinking = _sqlite_rows(db, "SELECT is_thinking FROM message_part_text WHERE message_part_id = ?", (part["id"],))
                body = "".join(r["content"] or "" for r in _sqlite_rows(
                    db, "SELECT mnt.content FROM message_content_nodes mcn JOIN message_node_text mnt"
                        " ON mnt.node_id = mcn.id WHERE mcn.parent_text_part_id = ? AND mcn.node_type = 'text'"
                        " ORDER BY mcn.node_index, mcn.id", (part["id"],)))
                if thinking and thinking[0]["is_thinking"]:
                    items.append({"kind": "thought", "id": f"{mid}:{part['id']}", "ts": ts, "text": body})
                else:
                    text.append(body)
            elif part["part_type"] in ("tool_call", "toolCall", "tool"):
                for t in _sqlite_rows(db, "SELECT * FROM message_part_tool_call WHERE message_part_id = ?", (part["id"],)):
                    items.append({"kind": "tool", "id": t.get("provider_tool_use_id") or f"{mid}:{part['id']}", "ts": ts,
                                  "name": t.get("tool_name"), "input": t.get("tool_input"),
                                  **({"output": t.get("tool_error") or t.get("tool_result"), "failed": bool(t.get("tool_error"))}
                                     if t.get("tool_result") is not None or t.get("tool_error") else {})})
        if text and role in ("user", "assistant"):
            items.append({"kind": "prompt" if role == "user" else "response", "id": mid, "ts": ts,
