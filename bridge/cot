# Muse Code: <root>/YYYY/MM/DD/<id>/session.jsonl, an append-only event log.
# Each record has payload_type and recorded_at (microseconds); conversation
# events are payload_type "runtime.session" with payload {kind: "run", event:
# {kind: started (prompt) | assistant_message_committed (text) |
# assistant_tool_calls_committed (tool_calls) | tool_result_batch_committed
# (results) | reasoning_summary_committed | model_completed (usage)}}.

def _muse_items(session: dict, root: Path) -> list[dict]:
    items: list[dict] = []
    tools: dict = {}
    model = None
    for n, rec in enumerate(_read_jsonl_file(session["_path"])):
        ptype, payload = rec.get("payload_type"), rec.get("payload") if isinstance(rec.get("payload"), dict) else {}
        us = rec.get("recorded_at")
        ts = us / 1_000_000 if isinstance(us, (int, float)) and us > 1e14 else us
        if ptype in ("runtime.session.metadata", "run.model.configured"):
            model = _first(payload, "record.model_id") or model
            session["cwd"] = session.get("cwd") or _first(payload, "record.cwd", "record.workspace_root")
            continue
        if ptype == "runtime.model_reconfigure.completed":
            model = _first(payload, "record.effective.model_id") or model
            continue
        if ptype != "runtime.session" or payload.get("kind") != "run":
            continue
        ev = payload.get("event") if isinstance(payload.get("event"), dict) else {}
        kind, rid = ev.get("kind"), ev.get("response_id") or n
        if kind == "started" and ev.get("prompt"):
            items.append({"kind": "prompt", "id": rec.get("id") or n, "ts": ts, "text": ev["prompt"]})
        elif kind == "reasoning_summary_committed" and ev.get("text"):
            items.append({"kind": "thought", "id": f"{rid}:t{n}", "ts": ts, "text": ev["text"]})
        elif kind == "assistant_message_committed" and ev.get("text"):
            items.append({"kind": "response", "id": f"{rid}:{n}", "ts": ts, "text": ev["text"], "model": model})
        elif kind == "assistant_tool_calls_committed":
            for c in ev.get("tool_calls") or []:
                if isinstance(c, dict):
                    tid = c.get("call_id") or c.get("id") or f"c{n}"
                    tools[tid] = {"kind": "tool", "id": tid, "ts": ts, "name": c.get("name"), "input": c.get("args")}
                    items.append(tools[tid])
        elif kind == "tool_result_batch_committed":
            for r in ev.get("results") or []:
                if isinstance(r, dict) and tools.get(r.get("tool_call_id")) is not None:
                    tools[r["tool_call_id"]].update(output=r.get("text") or r.get("output") or r.get("content"),
                                                    end_ts=ts, failed=bool(r.get("is_error")))
        elif kind == "model_completed" and isinstance(ev.get("usage"), dict):
            items.append({"kind": "usage", "id": f"u{n}", "ts": ts, "model": ev.get("model") or model,
                          "usage": _usage_counts(ev["usage"])})
    session["model"] = model
    return items


def _muse_index(root: Path) -> list[dict]:
    return [s for s in (_file_session(p, p.parent.name) for p in sorted(root.glob("*/*/*/*/session.jsonl"))) if s]


