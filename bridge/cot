def _opencode_family(agent: str, label: str, dirs: tuple[str, ...]) -> _Reader:
    def payloads(session: dict, root: Path) -> list[dict]:
        reader = READERS[agent]
        out = []
        for p in _opencode_session_payloads(session["_raw"], _opencode_messages(root, session["_raw"])):
            p = {**p, "_reader": agent, "_dedup_key": f"{agent}:" + str(p.get("_dedup_key") or "").split(":", 1)[-1]}
            if p.get("tool_name"):
                raw = p["tool_name"]
                p["tool_name"], p["tool_input"] = _reader_tool(reader, raw, p.get("tool_input"))
                if raw != p["tool_name"]:
                    p["raw_tool_name"] = raw
            if p.get("hook_event_name") == "OpenCodeUsage":
                p["hook_event_name"] = "ModelUsage"
            out.append(p)
        return out
    return _Reader(agent, label, dirs, index=_opencode_index, payloads=payloads,
                   mark=lambda s: int(s["_raw"].get("updated") or 0), tools={"list": "Search"})


