        return _cmd_homes(sys.argv[2:])
    if len(sys.argv) >= 2 and sys.argv[1] == "statusline":
        return _cmd_statusline(sys.argv[2:])
    if len(sys.argv) >= 2 and sys.argv[1] == "capture":
        return _cmd_capture(sys.argv[2:])
    if len(sys.argv) < 3 or sys.argv[1] != "hook":
        print(
            "Usage:\n"
            "  cot hook <claude|cursor|codex|opencode|hermes>  # reads a hook payload from stdin\n"
            "  cot install [claude cursor codex opencode hermes]  # wire up agent integrations\n"
            "  cot import [--agent X] [--since]   # import historical transcripts\n"
            "  cot reimport                       # wipe + re-import all transcripts\n"
            "  cot recover-questions              # fill AskQuestion answers from transcripts\n"
            "  cot watch [--agent X] [--interval]  # tail transcripts continuously\n"
            "  cot status                         # show endpoint + installed hooks\n"
            "  cot up                             # start/resume collector container\n"
            "  cot down                           # stop collector container\n"
            "  cot purge [--yes]                  # remove container, hooks, and ~/.cot\n"
            "  cot retention [status|dry-run]     # manage local cleanup policy\n"
            "  cot audit [limit]                  # show cot self-audit events\n"
            "  cot sources [list|add|remove]      # import other machines' copied session folders\n"
            "  cot homes [list|add|remove]        # extra folders per agent (e.g. a custom CLAUDE_CONFIG_DIR)\n"
            "  cot statusline [--json]            # one-line spend summary (Claude status line)\n"
            "  cot capture [--out F] -- <cmd>     # record usage of one `claude -p` / `codex exec` run",
            file=sys.stderr,
        )
        return 1
    source = sys.argv[2]
    if source not in AGENTS:
        print(f"Unknown source: {source}", file=sys.stderr)
        return 1

    global _HOOK_CAPTURED_AT
    _HOOK_CAPTURED_AT = datetime.now(timezone.utc).isoformat()
    raw = sys.stdin.read()
    try:
        body = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        body = {"_raw": raw}

    hook = body.get("hook_event_name") or body.get("hook") or body.get("event") or ""
    # Fold the sandbox/approval posture onto the live Codex SessionStart so it
    # matches what the importer records (Codex keeps it out of the hook payload).
    if source == "codex" and hook in ("SessionStart", "sessionStart"):
        for key, val in _codex_read_session_posture(body.get("session_id") or "").items():
            body.setdefault(key, val)
    # Codex sometimes prepends its injected <environment_context> onto the very
    # prompt it sends the hook. Lift it into its own system event so it is not
    # mislabeled as something the user typed; suppress the prompt if nothing else
    # remains after removing it.
    suppress = False
    if source == "codex" and hook in ("UserPromptSubmit", "beforeSubmitPrompt"):
        prompt = body.get("prompt")
        if isinstance(prompt, str):
            env_block, remainder = _extract_env_context(prompt)
            if env_block:
                event = _env_context_event(
                    {
                        "session_id": body.get("session_id"),
                        "cwd": body.get("cwd"),
                        "origin": "hook",
                        "timestamp": body.get("timestamp"),
                    },
                    env_block,
                )
                # This is hook-derived rather than scanner-recovered, so keep
                # the Collector's ordinary five-second payload-hash dedup.
                event.pop("dedup_key", None)
                _post(
                    f"{COT_ENDPOINT}/v1/ingest/{source}",
                    _ingest_event_to_hook_payload(event),
                )
                body["prompt"] = remainder
                suppress = not remainder
    redundant = source == "cursor" and hook in CURSOR_REDUNDANT_HOOKS
    handled = False
    if source == "cursor":
        # Cursor's shell derives whether its canonical response/plan Events
        # replace the raw afterAgentResponse hook body.
        handled = _emit_cursor_events(body, source)
    elif source == "claude":
        _emit_claude_events(body, source)
    elif source == "codex":
        _emit_codex_events(body, source)
    if not redundant and not handled and not suppress:
        # Cursor double-fires afterAgentThought: first with model:"default",
        # then ~15 ms later with the real model name + extra metadata.
        # Suppress the "default" copy so the richer second fire is the one
        # that gets stored. The thought text is also in the JSONL transcript,
        # so in the unlikely case the second fire never arrives, transcript
        # reconciliation on stop/subagentStop still captures it.
        if (
            source == "cursor"
            and hook == "afterAgentThought"
            and str(body.get("model") or "").strip().lower() == "default"
        ):
            pass  # suppress — wait for the real-model copy
        else:
            _post(f"{COT_ENDPOINT}/v1/ingest/{source}", body)
    if source == "claude":
        if hook in ("SessionStart", "sessionStart"):
            _log_launch(body)
    elif source == "cursor" and hook in ("subagentStop", "stop"):
        # A subagent just finished (or the turn ended): fold its transcript-only
        # responses in now, so active sessions don't wait for cot watch/import.
        _reconcile_cursor_subagents(body)

    response = _hook_response(source, body)
    if response is not None:
        print(json.dumps(response))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
