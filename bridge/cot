IMPORT_OFFSETS_PATH = STATE_DIR / "import_offsets.json"
# Per-transcript identity next to the plain offsets: inode, mtime and a digest
# of the bytes just before the offset, so an unchanged file is skipped without
# opening it and a rewritten or replaced one is re-read from the start. A
# sidecar rather than richer offsets so an older bridge sharing ~/.cot still
# reads offsets it understands; an entry whose offset no longer matches (an
# older bridge moved it) is ignored.
IMPORT_FILE_STATE_PATH = STATE_DIR / "import_file_state.json"
_FILE_STATE: dict[str, dict] = {}
# Bytes before the offset the digest covers.
_TAIL_PROBE_BYTES = 4096


def _read_json_dict(path: Path) -> dict:
    try:
        data = json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return {}
    return data if isinstance(data, dict) else {}


def _write_json_atomic(path: Path, data: dict) -> None:
    """Write via a temp file and rename, so a crash mid-write never leaves a
    truncated file (which reads as empty and re-imports everything)."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data))
    os.replace(tmp, path)


def _import_offsets_load() -> dict[str, int]:
    global _FILE_STATE
    _FILE_STATE = _read_json_dict(IMPORT_FILE_STATE_PATH)
    return _read_json_dict(IMPORT_OFFSETS_PATH)


def _import_offsets_save(data: dict[str, int]) -> None:
    _write_json_atomic(IMPORT_OFFSETS_PATH, data)
    # Only entries for files the offsets still track.
    _write_json_atomic(IMPORT_FILE_STATE_PATH, {k: v for k, v in _FILE_STATE.items() if k in data})


def _read_import_parser_version() -> str:
    try:
        return IMPORT_PARSER_VERSION_PATH.read_text().strip()
    except OSError:
        return ""


def _write_import_parser_version() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    try:
        IMPORT_PARSER_VERSION_PATH.write_text(IMPORT_PARSER_VERSION)
    except OSError:
        pass


def _reindex_if_parser_changed() -> bool:
    """If the import parser changed since the last run, wipe import-origin data
    and offsets so the next import re-derives everything with the new logic.
    Returns True when a reset happened. Live hook data is left untouched by the
    server-side reset."""
    if _read_import_parser_version() == IMPORT_PARSER_VERSION:
        return False
    try:
        _api_json("POST", "/v1/import/reset", {})
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        return False
    for path in (IMPORT_OFFSETS_PATH, IMPORT_FILE_STATE_PATH):
        try:
            path.unlink(missing_ok=True)
        except OSError:
            pass
    _FILE_STATE.clear()
    print("cot: import parser updated — re-importing transcripts from scratch")
    return True


def _open_rb_nofollow(path: Path):
    """Open *path* read-only in binary, refusing to follow a symlink at the
    final component (closes the discovery→read TOCTOU window). Returns a file
    object or None on any error (including the path being a symlink)."""
    try:
        fd = os.open(str(path), os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        return None
    try:
        return os.fdopen(fd, "rb")
    except OSError:
        os.close(fd)
        return None


def _read_text_capped(path: Path) -> str | None:
    """Whole-file UTF-8 read with a size cap and symlink protection."""
    try:
        if path.stat().st_size > _MAX_TRANSCRIPT_BYTES:
            return None
    except OSError:
        return None
    fh = _open_rb_nofollow(path)
    if fh is None:
        return None
    try:
        return fh.read().decode("utf-8", errors="replace")
    except OSError:
        return None
    finally:
        fh.close()


def _tail_digest(fh, offset: int) -> str:
    """Digest of the bytes just before ``offset``: whether the prefix an offset
    points into is still the one that was read."""
    fh.seek(max(0, offset - _TAIL_PROBE_BYTES))
    return hashlib.sha256(fh.read(min(offset, _TAIL_PROBE_BYTES))).hexdigest()[:32]


def _remember_file(key: str, st: os.stat_result, offset: int, tail: str, lines: int) -> None:
    _FILE_STATE[key] = {"offset": offset, "ino": st.st_ino, "mtime_ns": st.st_mtime_ns,
                        "tail": tail, "lines": lines}


# New bytes read per step. A large transcript is imported a chunk at a time so
# memory stays flat however big the file is; parser state carries across. 1 MB
# measured as fast as 8 MB with a third of the peak memory.
_IMPORT_CHUNK_BYTES = 1024 * 1024
# A single line longer than a chunk is read whole up to this size (a large
# inlined tool output); a longer one is skipped rather than held in memory.
_MAX_LINE_BYTES = 64 * 1024 * 1024


def _count_lines_before(fh, offset: int) -> int:
    """Non-empty lines in the first ``offset`` bytes: the line number the next
    read starts at, for transcripts tracked before line counts were kept."""
    fh.seek(0)
    count, read = 0, 0
    while read < offset:
        raw = fh.readline(offset - read)
        if not raw:
            break
        read += len(raw)
        if raw.strip():
            count += 1
    return count


def _import_read_chunk(path: Path, offsets: dict[str, int],
                       max_bytes: int | None = None) -> tuple[list[str], int, int, bool]:
    """Read up to ``max_bytes`` of new complete lines from *path* past the
    stored offset.

    Returns (lines, new_offset, first_lineno, more). ``first_lineno`` is the
    file-wide index (counting non-empty lines) of the first returned line, so
    line-keyed dedup stays stable across appends and chunks. ``more`` is True
    when the read stopped at ``max_bytes`` with more data behind it. An
    incomplete trailing line (writer mid-flush) is not consumed; a single line
    longer than ``max_bytes`` is read whole, and one past ``_MAX_LINE_BYTES``
    is skipped. Reads in binary so the stored byte
    offset seeks exactly; opens with O_NOFOLLOW.

    A file whose inode, size and mtime match what was recorded is skipped
    without opening it. One whose inode changed (replaced at the same path) or
    whose bytes before the offset changed (rewritten) is read from the start;
    dedup keys keep the re-read idempotent.
    """
    max_bytes = max_bytes or _IMPORT_CHUNK_BYTES
    key = str(path)
    start = offsets.get(key, 0)
    try:
        st = path.stat()
    except OSError:
        return [], start, 0, False
    size = st.st_size
    known = _FILE_STATE.get(key)
    if known is not None and known.get("offset") != start:
        known = None  # an older bridge moved the offset; the identity is stale
    if known is not None:
        if known.get("ino") != st.st_ino:
            start, known = 0, None
        elif size == start and known.get("mtime_ns") == st.st_mtime_ns:
            return [], start, int(known.get("lines") or 0), False
    if size < start:
        start, known = 0, None
    fh = _open_rb_nofollow(path)
    if fh is None:
        return [], start, 0, False
    try:
        if start and known is not None and known.get("tail") and _tail_digest(fh, start) != known["tail"]:
            start, known = 0, None
        if start == 0:
            base = 0
        elif known is not None and isinstance(known.get("lines"), int):
            base = known["lines"]
        else:
            base = _count_lines_before(fh, start)
        if size == start:
            # Unchanged content (a touch, or no identity recorded yet): note it.
            _remember_file(key, st, start, _tail_digest(fh, start), base)
            return [], start, base, False
        fh.seek(start)
        raw = fh.read(max_bytes)
        last_nl = raw.rfind(b"\n")
        if last_nl < 0:
            if len(raw) < max_bytes:
                return [], start, base, False  # a partial line still being written
            # One line longer than a whole chunk: read on to its end.
            parts, length, keep = [raw], len(raw), True
            while True:
                block = fh.read(1024 * 1024)
                if not block:
                    return [], start, base, False  # still unterminated
                nl = block.find(b"\n")
                if nl >= 0:
                    length += nl + 1
                    if keep:
                        parts.append(block[: nl + 1])
                    break
                length += len(block)
                if keep:
                    parts.append(block)
                    if length > _MAX_LINE_BYTES:
                        keep, parts = False, []
            if not keep:
                new_offset = start + length
                print(f"cot import: skipped a {length // (1024 * 1024)} MB line in {path.name}", file=sys.stderr)
                _remember_file(key, st, new_offset, _tail_digest(fh, new_offset), base + 1)
                return [], new_offset, base + 1, True
            raw = b"".join(parts)
            last_nl = len(raw) - 1
        consumed = raw[: last_nl + 1]
        new_offset = start + len(consumed)
        more = len(raw) >= max_bytes and new_offset < size
        # JSONL splits on "\n" only: splitlines() would also break on U+2028 and
        # friends, which JSON allows unescaped inside strings.
        lines = [ln for ln in consumed.decode("utf-8", errors="replace").split("\n") if ln.strip()]
        _remember_file(key, st, new_offset, _tail_digest(fh, new_offset), base + len(lines))
    except OSError:
        return [], start, 0, False
    finally:
        fh.close()
    return lines, new_offset, base, more


def _import_read_new_lines(path: Path, offsets: dict[str, int]) -> tuple[list[str], int]:
    """Every new complete line past the stored offset, in one read."""
    lines, new_offset, _, _ = _import_read_chunk(path, offsets, max_bytes=_MAX_TRANSCRIPT_BYTES)
    return lines, new_offset


def _import_home() -> Path | None:
    if _IMPORT_HOME_OVERRIDE is not None:
        return _IMPORT_HOME_OVERRIDE
    # Sandbox desktop builds run with an empty HOME but import transcripts
    # (read only) from the real one.
    env = os.environ.get("COT_IMPORT_HOME")
    return Path(env) if env else None


def _safe_transcript_root(root: Path) -> Path | None:
    try:
        resolved = root.resolve(strict=True)
        home = (_import_home() or Path.home()).resolve(strict=True)
        resolved.relative_to(home)
        return resolved
    except (OSError, ValueError):
        return None


def _transcript_root(env_key: str, directory: str) -> Path:
    if _import_home():
        return _import_home() / directory
    env = os.environ.get(env_key)
    return Path(env) if env else Path.home() / directory


def _claude_transcript_root() -> Path:
    return _transcript_root("COT_CLAUDE_HOME", ".claude")


def _cursor_transcript_root() -> Path:
    return _transcript_root("COT_CURSOR_HOME", ".cursor")


def _codex_transcript_root() -> Path:
    return _transcript_root("COT_CODEX_HOME", ".codex")


def _discover_transcripts(agent: str) -> list[Path]:
    if agent == "claude":
        root = _safe_transcript_root(_claude_transcript_root())
        if not root:
            return []
        return sorted(root.glob("projects/**/*.jsonl"))
    if agent == "cursor":
        root = _safe_transcript_root(_cursor_transcript_root())
        if not root:
            return []
        return sorted(root.glob("projects/**/agent-transcripts/**/*.jsonl"))
    if agent == "codex":
        root = _safe_transcript_root(_codex_transcript_root())
        if not root:
            return []
        return sorted(root.glob("sessions/**/*.jsonl"))
    return []


_SUBAGENT_UUID_RE = re.compile(
    r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
)


def _uuid_from(name: str) -> str | None:
    m = _SUBAGENT_UUID_RE.search(name or "")
    return m.group(0) if m else None


def _subagent_label_from_file(path: Path, limit: int = 80) -> str | None:
    """First human instruction in a subagent transcript, for the back-link pill.

    The richer ``type · description`` label still comes from the parent's Task
    span in the timeline; this is only a fallback when the pill has nothing."""
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            for _ in range(5):
                line = fh.readline()
                if not line:
                    break
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if obj.get("role") != "user":
                    continue
                msg = obj.get("message")
                text: str | None = msg if isinstance(msg, str) else None
                if isinstance(msg, dict):
                    content = msg.get("content")
                    if isinstance(content, str):
                        text = content
                    elif isinstance(content, list):
                        parts = [
                            b.get("text")
                            for b in content
                            if isinstance(b, dict) and isinstance(b.get("text"), str)
                        ]
                        text = "\n".join(p for p in parts if p)
                if text and text.strip():
                    flat = " ".join(_clean_user_text(text).split())
                    if not flat:
                        continue
                    return flat if len(flat) <= limit else flat[: limit - 1] + "…"
    except OSError:
        return None
    return None


def _discover_subagent_links(agent: str) -> list[dict]:
    """child→parent subagent links from the on-disk transcript nesting.

    Cursor (and Claude) nest a subagent's transcript under the launching
    session's folder: ``.../<parentId>/subagents/<childId>.jsonl``. That path is
    the deterministic parent pointer the hook payloads never carry, so we recover
    it here. (Claude additionally stamps the parent ``sessionId`` *inside* its
    subagent lines, so those already fold into the parent and yield no separate
    child session — the child stem isn't a UUID, so it's skipped below.)"""
    if agent == "cursor":
        root = _safe_transcript_root(_cursor_transcript_root())
        pattern = "projects/**/agent-transcripts/*/subagents/*.jsonl"
    elif agent == "claude":
        root = _safe_transcript_root(_claude_transcript_root())
        pattern = "projects/**/subagents/*.jsonl"
    else:
        return []
    if not root:
        return []
    out: list[dict] = []
    seen: set[str] = set()
    for path in root.glob(pattern):
        parent_id = _uuid_from(path.parent.parent.name)
        child_id = _uuid_from(path.stem)
        if not parent_id or not child_id or parent_id == child_id or child_id in seen:
            continue
        seen.add(child_id)
        out.append(
            {"child": child_id, "parent": parent_id, "label": _subagent_label_from_file(path)}
        )
    return out


def _post_subagent_links(links: list[dict], *, verbose: bool = False) -> int:
    """POST child→parent links to the collector. Returns the count applied."""
    if not links:
        return 0
    if not _collector_reachable():
        if verbose:
            print("cot: subagent link sync skipped: collector unreachable", file=sys.stderr)
        return 0
    try:
        data = json.dumps({"links": links}, ensure_ascii=False, default=str).encode("utf-8")
        req = urllib.request.Request(
            f"{COT_ENDPOINT}/v1/subagent-links",
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            applied = json.loads(resp.read().decode("utf-8")).get("applied", 0)
    except (urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError) as exc:
        if not isinstance(exc, (urllib.error.HTTPError, json.JSONDecodeError)):
            _mark_collector_down()
        if verbose:
            print(f"cot: subagent link sync failed: {exc}", file=sys.stderr)
        return 0
    if verbose and applied:
        print(f"cot: linked {applied} subagent session(s) to their parent")
    return applied


def _sync_subagent_links(agents: list[str], *, verbose: bool = False) -> int:
    """Post filesystem-derived subagent links so children embed under parents."""
    links: list[dict] = []
    for agent in agents:
        links.extend(_discover_subagent_links(agent))
    return _post_subagent_links(links, verbose=verbose)


def _import_cursor_subagent_responses(path: Path, child_id: str) -> None:
    """Post a subagent's prompt/thought/response Ingest Events from its transcript,
    dropping tool_call Events (the child's live tool hooks already captured those).

    Transcript-position keyed conversation Ingest Events are idempotent across
    stop hooks. Imported attachment Ingest Events intentionally retain their
    historical unkeyed, time-windowed dedup behavior."""
    try:
        mtime = path.stat().st_mtime
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return
    state: dict = {}
    path_str = str(path)
    parsed_events: list[dict] = []
    for lineno, raw in enumerate(lines):
        raw = raw.strip()
        if not raw:
            continue
        try:
            obj = json.loads(raw)
        except json.JSONDecodeError:
            continue
        parsed_events.extend(
            _cursor_line_to_ingest_events(
                obj,
                child_id,
                lineno=lineno,
                mtime=mtime,
                state=state,
                path=path_str,
                origin="import",
            )
        )
    parsed_events = [
        event for event in parsed_events if event.get("kind") != "tool_call"
    ]
    events = _prepare_ingest_events("cursor", parsed_events, origin="import")
    if not events:
        return
    poster = _ImportPoster(f"{COT_ENDPOINT}/v1/ingest/cursor")
    for event in events:
        payload = _ingest_event_to_hook_payload(event)
        if payload.get("_dedup_key") is None:
            payload.pop("_dedup_key", None)
        poster.add(payload)
    poster.flush()


def _reconcile_cursor_subagents(body: dict) -> None:
    """Fold a Cursor session's finished subagents in *live*, so active sessions
    don't depend on a running ``cot watch``/``cot import``.

    Cursor fires tool hooks inside a subagent but never its response/thought/
    prompt hooks, so the subagent's assistant text exists only in the child
    transcript at ``<parent>/subagents/<child>.jsonl``. This runs on the
    parent's ``subagentStop``/``stop`` hook — by which point the child
    transcript is finalized on disk — to (1) link each child to this parent and
    (2) import its responses (dropping tool_use, already captured live). The
    subagents/ glob is skipped entirely for the common no-subagent turn, so it
    adds no overhead there."""
    transcript = body.get("transcript_path")
    parent_id = body.get("session_id")
    if not transcript or not parent_id:
        return
    try:
        sub_dir = Path(transcript).parent / "subagents"
    except (TypeError, ValueError):
        return
    if not sub_dir.is_dir():
        return
    links: list[dict] = []
    for child_path in sorted(sub_dir.glob("*.jsonl")):
        child_id = _uuid_from(child_path.stem)
        if not child_id or child_id == parent_id:
            continue
        links.append({
            "child": child_id,
            "parent": parent_id,
            "label": _subagent_label_from_file(child_path),
        })
        _import_cursor_subagent_responses(child_path, child_id)
    _post_subagent_links(links)


def _claude_line_to_ingest_events(
    obj: dict,
    session_id: str,
    *,
    lineno: int = 0,
    mtime: float | None = None,
    state: dict | None = None,
    path: str = "",
    origin: str = "import",
    byte_offset: int | None = None,
) -> list[dict]:
    """Map a single Claude transcript JSONL line to canonical ingest events.

    ``state`` carries tool_use id -> (name, input) across lines so the
    ``tool_result`` blocks — which Claude writes in the *following* user
    message, not alongside the call — can be paired back to their tool name.
    """
    state = state if state is not None else {}
    events: list[dict] = []
    message = obj.get("message") if isinstance(obj.get("message"), dict) else {}
    role = obj.get("role") or message.get("role") or obj.get("type")
    content = obj.get("content")
    if content is None:
        content = message.get("content")
    ts = obj.get("timestamp")
    uuid = obj.get("uuid") or ""
    sid = obj.get("sessionId") or session_id
    cwd = obj.get("cwd")
    model = message.get("model") or obj.get("model")
    usage = message.get("usage") if isinstance(message.get("usage"), dict) else None
    fallback_anchor = f"{path}:{byte_offset if byte_offset is not None else lineno}"

    def _dedup(suffix: str, *, live_only: bool = False) -> str | None:
        return _scoped_dedup_key(
            origin,
            "claude",
            suffix,
            import_anchor=str(uuid) if uuid else None,
            live_anchor=str(uuid or fallback_anchor),
            live_only=live_only,
        )

    base = {
        "session_id": sid,
        "cwd": cwd,
        "origin": origin,
        "timestamp": ts,
    }

    if role == "user":
        text = _text_from_blocks(content, clean_user=True) if isinstance(content, list) else _clean_user_text(str(content or ""))
        if uuid and text:
            state.setdefault("_user_prompts", {})[str(uuid)] = text
        # Tool results ride in user messages; pair them to the earlier call.
        if isinstance(content, list):
            for i, block in enumerate(content):
                if not isinstance(block, dict) or block.get("type") != "tool_result":
                    continue
                tool_use_id = block.get("tool_use_id") or ""
                result_content = block.get("content")
                if isinstance(result_content, str):
                    result_text = result_content
                elif isinstance(result_content, list):
                    result_text = _text_from_blocks(result_content)
                else:
                    result_text = ""
                tool_name, matched_input = state.get(tool_use_id, ("", {}))
                is_error = block.get("is_error", False)
                events.append({
                    **base,
                    "kind": "tool_call",
                    "phase": "end",
                    "status": "error" if is_error else "ok",
                    "tool_name": tool_name,
                    "tool_input": matched_input,
                    "tool_response": result_text,
                    "model": model,
                    "dedup_key": _dedup(f"post:{tool_use_id or i}"),
                })
        if _is_interruption(text):
            events.append({
                **base,
                "kind": "interruption",
                "dedup_key": _dedup("interruption"),
            })
        elif text:
            events.append({
                **base,
                "kind": "prompt",
                "text": text,
                "dedup_key": _dedup("prompt"),
            })
        if isinstance(content, list):
            atts = _message_attachments(content)
            if atts and text:
                events.append({
                    **base,
                    "kind": "attachment",
                    "text": text,
                    "attachments": atts,
                    "dedup_key": _dedup("attachment", live_only=True),
                })
    elif role == "assistant":
        if isinstance(content, list):
            usage_placed = False
            for i, block in enumerate(content):
                if not isinstance(block, dict):
                    continue
                btype = block.get("type")
                block_usage = None
                if usage and not usage_placed:
                    block_usage = usage
                    usage_placed = True
                if btype == "thinking":
                    think = block.get("thinking")
                    if think:
                        events.append({
                            **base,
                            "kind": "thought",
                            "text": str(think),
                            "model": model,
                            "usage": block_usage,
                            "dedup_key": _dedup(f"think:{i}"),
                        })
                elif btype == "text":
                    text = block.get("text")
                    if text:
                        events.append({
                            **base,
                            "kind": "response",
                            "text": str(text),
                            "model": model,
                            "usage": block_usage,
                            "dedup_key": _dedup(f"resp:{i}"),
                        })
                elif btype == "tool_use":
                    tool_name = block.get("name") or ""
                    tool_input = block.get("input") if isinstance(block.get("input"), dict) else {}
                    tool_id = block.get("id") or ""
                    if tool_id:
                        state[tool_id] = (tool_name, tool_input)
                    events.append({
                        **base,
                        "kind": "tool_call",
                        "phase": "start",
                        "status": "ok",
                        "tool_name": tool_name,
                        "tool_input": tool_input,
                        "model": model,
                        "usage": block_usage,
                        "dedup_key": _dedup(f"pre:{tool_id or i}"),
                    })
        else:
            text = str(content or "").strip()
            if text:
                events.append({
                    **base,
                    "kind": "response",
                    "text": text,
                    "model": model,
                    "usage": usage,
                    "dedup_key": _dedup("resp"),
                })
    elif obj.get("type") == "attachment":
        attachment = obj.get("attachment") if isinstance(obj.get("attachment"), dict) else {}
        meta = _file_attachment_meta(attachment)
        parent_uuid = obj.get("parentUuid")
        parent_text = state.get("_user_prompts", {}).get(str(parent_uuid)) if parent_uuid else None
        if meta and _file_attachment_matches_text(attachment, parent_text):
            events.append({
                **base,
                "kind": "attachment",
                "text": parent_text,
                "attachments": [meta],
                "dedup_key": _dedup("attachment", live_only=True),
            })

    return events


def _claude_line_to_events(
    obj: dict,
    session_id: str,
    *,
    lineno: int = 0,
    mtime: float | None = None,
    state: dict | None = None,
    path: str = "",
) -> list[dict]:
    """Map a Claude transcript line to current collector hook payloads."""
    return _import_line_to_hook_payloads(
        "claude",
        obj,
        session_id,
        lineno=lineno,
        mtime=mtime,
        state=state,
        path=path,
    )


def _cursor_import_ts(mtime: float | None, lineno: int, block_idx: int = 0) -> str | None:
    """Cursor transcripts carry no per-event timestamps, so anchor on the file's
    mtime and offset by line/block position. This keeps events chronologically
    ordered within a session and roughly placed on the right day, instead of
    collapsing the whole history onto import time."""
    if mtime is None:
        return _now_z()
    dt = datetime.fromtimestamp(mtime, tz=timezone.utc) + timedelta(
        milliseconds=lineno * 100 + block_idx
    )
    # Fixed-precision so lexical string ordering (used by the DB's MIN/MAX(ts))
    # matches chronological ordering — without timespec a zero offset would drop
    # the fractional seconds and sort after the offset events.
    return dt.isoformat(timespec="milliseconds").replace("+00:00", "Z")


def _ingest_event_to_hook_payload(event: dict) -> dict:
    """Translate a canonical import event onto the current collector payload.

    The collector still accepts Claude-Code-style hook payloads. Keeping this
    bridge at the edge lets source adapters move to product-level ingest events
    without forcing a storage/API migration in the same change.
    """
    out = {
        "session_id": event.get("session_id"),
        "timestamp": event.get("timestamp"),
    }
    if event.get("origin") == "import":
        out["_import"] = True
    if event.get("cwd"):
        out["cwd"] = event.get("cwd")
    if event.get("dedup_key"):
        out["_dedup_key"] = event.get("dedup_key")
    if event.get("model"):
        out["model"] = event.get("model")
    if event.get("usage") is not None:
        out["usage"] = event.get("usage")
    if event.get("interrupted"):
        out["interrupted"] = True
    if event.get("codex"):
        out["codex"] = event.get("codex")
    if event.get("composer_mode"):
        out["composer_mode"] = event.get("composer_mode")

    kind = event.get("kind")
    if kind == "prompt":
        out["hook_event_name"] = "UserPromptSubmit"
        out["prompt"] = event.get("text") or ""
    elif kind == "response":
        out["hook_event_name"] = "afterAgentResponse"
        out["_synthetic_category"] = "response"
        out["response"] = event.get("text") or ""
    elif kind == "thought":
        out["hook_event_name"] = "afterAgentThought"
        out["_synthetic_category"] = "thought"
        out["thought"] = event.get("text") or ""
    elif kind == "plan":
        out["hook_event_name"] = "createPlan"
        out["_synthetic_category"] = "plan"
        out["plan_name"] = event.get("name") or "Plan"
        out["plan_overview"] = event.get("overview") or ""
        out["plan_body"] = event.get("body") or ""
        out["plan_todos"] = event.get("todos") or []
        out["composer_mode"] = "plan"
    elif kind == "tool_call":
        phase = event.get("phase") or "instant"
        if phase == "start":
            out["hook_event_name"] = "PreToolUse"
        elif event.get("status") == "error":
            out["hook_event_name"] = "PostToolUseFailure"
        else:
            out["hook_event_name"] = "PostToolUse"
        out["tool_name"] = event.get("tool_name") or ""
        out["tool_input"] = event.get("tool_input") or {}
        if "tool_response" in event:
            out["tool_response"] = event.get("tool_response")
    elif kind == "attachment":
        out["_attach_to_prompt"] = True
        out["text"] = event.get("text") or ""
        out["attachments"] = event.get("attachments") or []
    elif kind == "session_metadata":
        metadata_type = event.get("metadata_type")
        if metadata_type == "environment_context":
            out["hook_event_name"] = "CodexEnvironmentContext"
            out["environment_context"] = event.get("environment_context") or ""
        elif metadata_type == "session_start":
            out["hook_event_name"] = "SessionStart"
    else:
        out.update(event.get("payload") if isinstance(event.get("payload"), dict) else {})

    return {k: v for k, v in out.items() if v is not None}


def _ingest_events_to_hook_payloads(events: list[dict]) -> list[dict]:
    return [_ingest_event_to_hook_payload(ev) for ev in events]


def _cursor_line_to_ingest_events(
    obj: dict,
    session_id: str,
    *,
    lineno: int = 0,
    mtime: float | None = None,
    state: dict | None = None,
    path: str = "",
    origin: str = "import",
    byte_offset: int | None = None,
) -> list[dict]:
    """Map a Cursor transcript line to canonical ingest events.

    Cursor transcripts differ from Claude's: no per-line timestamp or uuid, and
    no ``tool_result`` blocks (only the assistant's ``tool_use`` inputs). So we
    emit each tool call as a single standalone instant tool_call event rather
    than a Pre/Post span that would otherwise dangle as "ongoing". Dedup keys
    are derived from the stable (path, line, block) position.
    """
    events: list[dict] = []
    message = obj.get("message") if isinstance(obj.get("message"), dict) else {}
    role = obj.get("role") or message.get("role") or obj.get("type")
    content = obj.get("content")
    if content is None:
        content = message.get("content")

    def _dedup(suffix: str, *, live_only: bool = False) -> str | None:
        return _scoped_dedup_key(
            origin,
            "cursor",
            suffix,
            import_anchor=f"{path}:{lineno}",
            live_anchor=str(byte_offset if byte_offset is not None else lineno),
            live_only=live_only,
        )

    def _base(block_idx: int = 0) -> dict:
        return {
            "origin": origin,
            "session_id": session_id,
            "timestamp": _cursor_import_ts(mtime, lineno, block_idx),
        }

    if (
        obj.get("type") == "turn_ended"
        and obj.get("status") in ("error", "aborted")
        and _is_interruption(str(obj.get("error") or ""))
    ):
        return [{
            **_base(),
            "kind": "interruption",
            "dedup_key": _dedup("interruption"),
        }]

    if role == "user":
        text = _text_from_blocks(content, clean_user=True) if isinstance(content, list) else _clean_user_text(str(content or ""))
        if _is_interruption(text):
            events.append({
                **_base(),
                "kind": "interruption",
                "dedup_key": _dedup("interruption"),
            })
        elif text:
            events.append({
                **_base(),
                "kind": "prompt",
                "text": text,
                "dedup_key": _dedup("prompt"),
            })
        if isinstance(content, list):
            atts = _message_attachments(content)
            if atts and text:
                events.append({
                    **_base(),
                    "kind": "attachment",
                    "text": text,
                    "attachments": atts,
                    "dedup_key": _dedup("attachment", live_only=True),
                })
        return events

    if role == "assistant" and isinstance(content, list):
        for i, block in enumerate(content):
            if not isinstance(block, dict):
                continue
            btype = block.get("type")
            if btype == "text":
                text = block.get("text")
                if text:
                    events.append({
                        **_base(i),
                        "kind": "response",
                        "text": str(text),
                        "dedup_key": _dedup(f"resp:{i}"),
                    })
            elif btype == "thinking":
                think = block.get("thinking")
                if think:
                    events.append({
                        **_base(i),
                        "kind": "thought",
                        "text": str(think),
                        "dedup_key": _dedup(f"think:{i}"),
                    })
            elif btype == "tool_use":
                name = block.get("name") or ""
                inp = block.get("input")
                # ApplyPatch sends a raw patch string; keep dict or str as-is so
                # normalize can pull the target path out of either shape.
                tool_input = inp if isinstance(inp, (dict, str)) else {}
                if name == "CreatePlan":
                    plan_input = tool_input if isinstance(tool_input, dict) else {}
                    events.append({
                        **_base(i),
                        "kind": "plan",
                        "name": plan_input.get("name") or "Plan",
                        "overview": plan_input.get("overview") or "",
                        "body": plan_input.get("plan") or "",
                        "todos": plan_input.get("todos")
                        if isinstance(plan_input.get("todos"), list) else [],
                        "dedup_key": _dedup(f"plan:{i}"),
                    })
                else:
                    events.append({
                        **_base(i),
                        "kind": "tool_call",
                        "phase": "instant",
                        "status": "ok",
                        "tool_name": name,
                        "tool_input": tool_input,
                        "dedup_key": _dedup(f"tool:{i}"),
                    })
        return events

    return events


def _cursor_line_to_events(
    obj: dict,
    session_id: str,
    *,
    lineno: int = 0,
    mtime: float | None = None,
    state: dict | None = None,
    path: str = "",
) -> list[dict]:
    """Map a Cursor transcript line to current collector hook payloads."""
    return _import_line_to_hook_payloads(
        "cursor",
        obj,
        session_id,
        lineno=lineno,
        mtime=mtime,
        state=state,
        path=path,
    )


def _codex_tool_args(raw_args: object) -> dict:
    """Codex ``function_call`` arguments arrive as a JSON string."""
    if isinstance(raw_args, dict):
        return raw_args
    if isinstance(raw_args, str) and raw_args.strip():
        try:
            parsed = json.loads(raw_args)
            return parsed if isinstance(parsed, dict) else {}
        except json.JSONDecodeError:
            return {}
    return {}


def _codex_map_tool(name: str, raw_args: object) -> tuple[str, object]:
    """Map a Codex tool name + raw args onto a canonical (tool_name, tool_input)
    that normalize.categorize understands (shell/file_edit/etc.)."""
    args = _codex_tool_args(raw_args)
    if name in ("exec_command", "shell", "local_shell", "shell_command"):
        cmd = args.get("cmd") or args.get("command") or ""
        if isinstance(cmd, list):
            cmd = " ".join(str(c) for c in cmd)
        return "Bash", {"command": cmd}
    if name == "apply_patch":
        patch = args.get("input") or args.get("patch") or args.get("command") or ""
        if not patch and isinstance(raw_args, str):
            patch = raw_args
        return "apply_patch", {"command": patch}
    return name, args if args else {}


def _codex_reasoning_text(payload: dict) -> str:
    """Pull human-readable reasoning out of a Codex ``reasoning`` item. Most are
    encrypted (``encrypted_content``) or empty; only return real text."""
    parts: list[str] = []
    summary = payload.get("summary")
    if isinstance(summary, list):
        for s in summary:
            if isinstance(s, dict) and s.get("text"):
                parts.append(str(s["text"]))
            elif isinstance(s, str) and s.strip():
                parts.append(s)
    content = payload.get("content")
    if isinstance(content, str) and content.strip() and content != "None":
        parts.append(content)
    elif isinstance(content, list):
        t = _text_from_blocks(content)
        if t:
            parts.append(t)
    return "\n".join(parts).strip()


def _codex_flush_pending_ingest_events(state: dict | None) -> list[dict]:
    """Release the deferred Codex assistant message, if one is held.

    Codex emits each turn's ``token_count`` and ``turn_aborted`` lines *after*
    the assistant message, so the message is buffered in ``state`` until the
    next message (or end-of-file) lets that usage / interrupted status fold onto
    it. Returns ``[]`` for every other agent, which never sets ``_pending_msg``.
    """
    if not state:
        return []
    ev = state.pop("_pending_msg", None)
    return [ev] if isinstance(ev, dict) else []


def _codex_flush_pending(state: dict | None) -> list[dict]:
    return _ingest_events_to_hook_payloads(_codex_flush_pending_ingest_events(state))


def _codex_session_config(meta: dict | None, turn: dict | None) -> dict:
    """Curated session posture from Codex ``session_meta`` + ``turn_context``.

    Only the human-meaningful fields, and only when present: the CLI/build, the
    model and reasoning effort, and the sandbox/approval posture the run was
    granted. The raw permission_profile entry list is intentionally left out."""
    meta = meta if isinstance(meta, dict) else {}
    turn = turn if isinstance(turn, dict) else {}
    cfg: dict = {}
    for key, src in (
        ("cli_version", meta),
        ("originator", meta),
        ("source", meta),
        ("model_provider", meta),
        ("model", turn),
        ("effort", turn),
        ("approval_policy", turn),
        ("sandbox_policy", turn),
    ):
        val = src.get(key)
        if val not in (None, "", [], {}):
            cfg[key] = val
    return cfg


def _codex_session_start_event(
    session_id: str, ts, state: dict, *, origin: str = "import"
) -> dict:
    """A SessionStart lifecycle event for an imported Codex session, carrying the
    sandbox/approval posture that Codex only records on its metadata lines."""
    ev: dict = {
        "session_id": session_id,
        "origin": origin,
        "timestamp": ts,
        "kind": "session_metadata",
        "metadata_type": "session_start",
        "cwd": state.get("cwd"),
        "dedup_key": _origin_dedup_key(origin, "codex", "session:start"),
    }
    cfg = _codex_session_config(state.get("_codex_meta"), state.get("_codex_turn"))
    if cfg.get("model"):
        ev["model"] = cfg["model"]
    if cfg:
        ev["codex"] = cfg
    return ev


def _codex_line_to_ingest_events(
    obj: dict,
    session_id: str,
    *,
    lineno: int = 0,
    mtime: float | None = None,
    state: dict | None = None,
    path: str = "",
    origin: str = "import",
    byte_offset: int | None = None,
) -> list[dict]:
    """Map a Codex rollout JSONL line to canonical ingest events.

    Beyond messages and web searches, Codex records tool activity as
    ``function_call`` / ``custom_tool_call`` items with their results in
    separate ``*_output`` items keyed by ``call_id``. ``state`` correlates them
    so a call and its output become a Pre/Post span with the result body.
    """
    state = state if state is not None else {}
    events: list[dict] = []
    ts = obj.get("timestamp")
    kind = obj.get("type")
    payload = obj.get("payload") if isinstance(obj.get("payload"), dict) else {}
    line_id = obj.get("id") or ""
    fallback_anchor = str(byte_offset if byte_offset is not None else lineno)

    def _dedup(
        suffix: str,
        *,
        anchor_override: str | None = None,
        live_only: bool = False,
    ) -> str | None:
        return _scoped_dedup_key(
            origin,
            "codex",
            suffix,
            import_anchor=anchor_override or (str(line_id) if line_id else None),
            live_anchor=anchor_override or str(line_id or fallback_anchor),
            live_only=live_only,
        )

    # Codex never repeats cwd/model on message lines; it records them once on
    # session_meta and per-turn on turn_context. Capture them in per-file state
    # so they can be stamped onto the events that follow.
    if kind == "session_meta":
        if payload.get("cwd"):
            state["cwd"] = payload.get("cwd")
        state["_codex_meta"] = payload
        return events
    if kind == "turn_context":
        if payload.get("cwd"):
            state["cwd"] = payload.get("cwd")
        if payload.get("model"):
            state["model"] = payload.get("model")
        if not isinstance(state.get("_codex_turn"), dict):
            state["_codex_turn"] = payload
        # turn_context follows session_meta and carries the run's posture, so
        # emit the SessionStart here, once, with everything gathered so far.
        if not state.get("_session_started") and isinstance(state.get("_codex_meta"), dict):
            state["_session_started"] = True
            return [_codex_session_start_event(session_id, ts, state, origin=origin)]
        return events
    # Per-turn token usage and interruptions arrive on event_msg lines *after*
    # the assistant message, so fold them onto the deferred pending message.
    if kind == "event_msg":
        ptype = payload.get("type")
        pending = state.get("_pending_msg")
        if ptype == "token_count" and isinstance(pending, dict):
            info = payload.get("info") if isinstance(payload.get("info"), dict) else {}
            last = info.get("last_token_usage") if isinstance(info.get("last_token_usage"), dict) else None
            if last:
                pending["usage"] = _merge_usage(pending.get("usage"), last)
        elif ptype == "turn_aborted":
            events.extend(_codex_flush_pending_ingest_events(state))
            events.append({
                "session_id": session_id,
                "origin": origin,
                "timestamp": ts,
                "kind": "interruption",
                "dedup_key": _dedup("interruption"),
            })
        return events

    if kind != "response_item":
        return events

    base: dict = {"session_id": session_id, "origin": origin, "timestamp": ts}
    if state.get("cwd"):
        base["cwd"] = state["cwd"]

    pt = payload.get("type")
    if pt == "message" and payload.get("role") == "assistant":
        text_val = _text_from_blocks(payload.get("content"))
        if not text_val:
            return events
        model = payload.get("model") or obj.get("model") or state.get("model")
        phase = payload.get("phase") or ""
        if phase == "final_answer":
            ev = {
                **base,
                "kind": "response",
                "text": text_val,
                "model": model,
                "dedup_key": _dedup("resp"),
            }
        else:
            ev = {
                **base,
                "kind": "thought",
                "text": text_val,
                "model": model,
                "dedup_key": _dedup("think"),
            }
        # Defer so a trailing token_count / turn_aborted line can fold usage and
        # interrupted status onto this message before it is posted. The prior
        # pending message (if any) is released now, preserving order.
        flushed = _codex_flush_pending_ingest_events(state)
        state["_pending_msg"] = ev
        return flushed
    else:
        events.extend(_codex_flush_pending_ingest_events(state))

    if pt == "message" and payload.get("role") == "user":
        content = payload.get("content")
        raw_text = _text_from_blocks(content, clean_user=False) if isinstance(content, list) else str(content or "")
        env_block, _ = _extract_env_context(raw_text)
        if env_block:
            events.append(_env_context_event(base, env_block))
        text_val = _clean_user_text(raw_text)
        if _is_interruption(text_val):
            events.append({
                **base,
                "kind": "interruption",
                "dedup_key": _dedup("interruption"),
            })
            return events
        if text_val:
            events.append({
                **base,
                "kind": "prompt",
                "text": text_val,
                "dedup_key": _dedup("prompt"),
            })
        if isinstance(content, list):
            atts = _message_attachments(content)
            if atts and text_val:
                events.append({
                    **base,
                    "kind": "attachment",
                    "text": text_val,
                    "attachments": atts,
                    "dedup_key": _dedup("attachment", live_only=True),
                })
    elif pt == "reasoning":
        text_val = _codex_reasoning_text(payload)
        if text_val:
            events.append({
                **base,
                "kind": "thought",
                "text": text_val,
                "dedup_key": _dedup("reason"),
            })
    elif pt == "web_search_call":
        action = payload.get("action") if isinstance(payload.get("action"), dict) else {}
        query = action.get("query") or payload.get("query") or ""
        if query:
            events.append({
                **base,
                "kind": "tool_call",
                "phase": "instant",
                "status": "ok",
                "tool_name": "WebSearch",
                "tool_input": {"query": str(query)},
                "tool_response": {"status": payload.get("status"), "action": action},
                "dedup_key": _dedup("web"),
            })
    elif pt in ("function_call", "custom_tool_call"):
        name = payload.get("name") or ""
        call_id = payload.get("call_id") or ""
        raw_args = payload.get("arguments") if pt == "function_call" else payload.get("input")
        tool_name, tool_input = _codex_map_tool(name, raw_args)
        if call_id:
            state[call_id] = (tool_name, tool_input)
        dk = _dedup("pre", anchor_override=str(call_id) if call_id else None)
        events.append({
            **base,
            "kind": "tool_call",
            "phase": "start",
            "status": "ok",
            "tool_name": tool_name,
            "tool_input": tool_input,
            "dedup_key": dk,
        })
    elif pt in ("function_call_output", "custom_tool_call_output"):
        call_id = payload.get("call_id") or ""
        output = payload.get("output")
        out_text = output if isinstance(output, str) else json.dumps(output, ensure_ascii=False, default=str)
        tool_name, tool_input = state.get(call_id, ("", {}))
        status = payload.get("status")
        is_error = status not in (None, "completed", "success")
        dk = _dedup("post", anchor_override=str(call_id) if call_id else None)
        events.append({
            **base,
            "kind": "tool_call",
            "phase": "end",
            "status": "error" if is_error else "ok",
            "tool_name": tool_name,
            "tool_input": tool_input,
            "tool_response": out_text,
            "dedup_key": dk,
        })

    return events


def _codex_line_to_events(
    obj: dict,
    session_id: str,
    *,
    lineno: int = 0,
    mtime: float | None = None,
    state: dict | None = None,
    path: str = "",
) -> list[dict]:
    """Map a Codex rollout JSONL line to current collector hook payloads."""
    return _import_line_to_hook_payloads(
        "codex",
        obj,
        session_id,
        lineno=lineno,
        mtime=mtime,
        state=state,
        path=path,
    )


def _session_id_from_claude_path(path: Path) -> str | None:
    """Claude transcripts often have the session id in the first few lines."""
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i > 5:
                    break
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                sid = obj.get("sessionId") or obj.get("session_id")
                if sid:
                    return str(sid)
    except OSError:
        pass
    return path.stem


def _session_id_from_codex_path(path: Path) -> str:
    """Codex rollout filenames are rollout-<timestamp>-<uuid>.jsonl."""
    import re
    m = re.search(r"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", path.stem)
    if m:
        return m.group(1)
    return path.stem


# --------------------------------------------------------------- OpenCode
# OpenCode keeps sessions in a database rather than per-session transcripts:
# ``opencode.db`` (SQLite) since 1.x, JSON files under ``storage/`` before that.
# Import replays them as the same payloads the plugin sends, with the plugin's
# dedup keys, so a pass over an already-imported session only adds what's new.


def _opencode_data_root() -> Path:
    if _import_home():
        return _import_home() / ".local" / "share" / "opencode"
    env = os.environ.get("COT_OPENCODE_HOME")
    if env:
        return Path(env)
    xdg = os.environ.get("XDG_DATA_HOME")
    return (Path(xdg) if xdg else Path.home() / ".local" / "share") / "opencode"


def _opencode_json(path: Path) -> dict | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def _opencode_db_connect(path: Path):
    import sqlite3
    # OpenCode may hold the file open in WAL mode; read-only first, then an
    # immutable snapshot when the -shm sidecar can't be created (sandboxes).
    for query in ("mode=ro", "immutable=1"):
        try:
            conn = sqlite3.connect(f"{path.as_uri()}?{query}", uri=True, timeout=5)
            conn.row_factory = sqlite3.Row
            conn.execute("SELECT 1 FROM session LIMIT 1")
            return conn
        except sqlite3.Error:
            continue
    return None


def _opencode_session_index(root: Path | None = None) -> list[dict]:
    """Every OpenCode session on disk: id, parent, directory, title, created and
    updated (epoch ms), and how many messages it has. No message bodies."""
    root = root or _opencode_data_root()
    out: dict[str, dict] = {}
    db_path = root / "opencode.db"
    if db_path.is_file():
        conn = _opencode_db_connect(db_path)
        if conn is not None:
            try:
                rows = conn.execute(
                    "SELECT s.id, s.parent_id, s.directory, s.title, s.time_created, s.time_updated,"
                    " (SELECT COUNT(*) FROM message m WHERE m.session_id = s.id) AS n"
                    " FROM session s"
                ).fetchall()
                for r in rows:
                    out[r["id"]] = {
                        "id": r["id"], "parent_id": r["parent_id"], "directory": r["directory"],
                        "title": r["title"], "created": r["time_created"], "updated": r["time_updated"],
                        "messages": r["n"], "store": "sqlite",
                    }
            except Exception:  # noqa: BLE001 - an unknown schema reads as no sessions
                pass
            finally:
                conn.close()
    for path in sorted((root / "storage" / "session").glob("*/*.json")):
        info = _opencode_json(path)
        if not info or not info.get("id") or info["id"] in out:
            continue
        t = info.get("time") or {}
        msg_dir = root / "storage" / "message" / info["id"]
        out[info["id"]] = {
            "id": info["id"], "parent_id": info.get("parentID"), "directory": info.get("directory"),
            "title": info.get("title"), "created": t.get("created"), "updated": t.get("updated") or t.get("created"),
            "messages": sum(1 for _ in msg_dir.glob("*.json")) if msg_dir.is_dir() else 0, "store": "json",
        }
    return sorted(out.values(), key=lambda s: s.get("created") or 0)


def _opencode_messages(root: Path, session: dict) -> list[tuple[dict, list[dict]]]:
    """A session's messages in order, each with its parts in order."""
    msgs: list[tuple[dict, list[dict]]] = []
    if session.get("store") == "sqlite":
        conn = _opencode_db_connect(root / "opencode.db")
        if conn is None:
            return []
        try:
            parts: dict[str, list[dict]] = {}
            for r in conn.execute(
                "SELECT id, message_id, time_created, data FROM part WHERE session_id = ? ORDER BY message_id, id",
                (session["id"],),
            ):
                try:
                    data = json.loads(r["data"])
                except (TypeError, ValueError):
                    continue
                parts.setdefault(r["message_id"], []).append({**data, "id": r["id"], "messageID": r["message_id"]})
            for r in conn.execute(
                "SELECT id, time_created, data FROM message WHERE session_id = ? ORDER BY time_created, id",
                (session["id"],),
            ):
                try:
                    info = json.loads(r["data"])
                except (TypeError, ValueError):
                    continue
                info = {**info, "id": r["id"], "sessionID": session["id"]}
                info.setdefault("time", {}).setdefault("created", r["time_created"])
                msgs.append((info, parts.get(r["id"], [])))
        finally:
            conn.close()
        return msgs
    msg_dir = root / "storage" / "message" / session["id"]
    for path in msg_dir.glob("*.json"):
        info = _opencode_json(path)
        if not info or not info.get("id"):
            continue
        part_dir = root / "storage" / "part" / info["id"]
        parts = [p for p in (_opencode_json(x) for x in sorted(part_dir.glob("*.json"))) if p]
        msgs.append((info, sorted(parts, key=lambda p: str(p.get("id") or ""))))
    msgs.sort(key=lambda m: ((m[0].get("time") or {}).get("created") or 0, str(m[0].get("id"))))
    return msgs


def _opencode_ts(ms: object) -> str | None:
    if isinstance(ms, (int, float)) and ms > 0:
        return datetime.fromtimestamp(ms / 1000, tz=timezone.utc).isoformat().replace("+00:00", "Z")
    return None


def _opencode_session_payloads(session: dict, messages: list[tuple[dict, list[dict]]]) -> list[dict]:
    """Plugin-shaped hook payloads for one session, oldest first."""
    sid = session["id"]
    cwd = session.get("directory")
    out: list[dict] = []

    def add(hook: str, ts: object, key: str, **fields) -> None:
        out.append({
            "session_id": sid, "hook_event_name": hook, "origin": "import", "_import": True,
            "cwd": cwd, "timestamp": _opencode_ts(ts) or _opencode_ts(session.get("created")),
            "_dedup_key": f"opencode:{sid}:{key}", **fields,
        })

    start = {"session_title": session.get("title")}
    if session.get("parent_id"):
        start["parent_session_id"] = session["parent_id"]
    add("SessionStart", session.get("created"), f"session:{sid}", **start)
    for info, parts in messages:
        mid = info.get("id")
        created = (info.get("time") or {}).get("created")
        if info.get("role") == "user":
            prompt = "\n".join(
                p["text"] for p in parts
                if p.get("type") == "text" and not p.get("synthetic") and isinstance(p.get("text"), str)
            )
            if prompt.strip():
                model = (info.get("model") or {}).get("modelID") if isinstance(info.get("model"), dict) else None
                add("UserPromptSubmit", created, f"prompt:{mid}", prompt=prompt, **({"model": model} if model else {}))
            continue
        if info.get("role") != "assistant":
            continue
        for p in parts:
            ptype = p.get("type")
            pt = p.get("time") or {}
            if ptype in ("text", "reasoning") and isinstance(p.get("text"), str) and p["text"].strip():
                response = ptype == "text"
                add("afterAgentResponse" if response else "afterAgentThought", pt.get("end") or pt.get("start") or created,
                    f"part:{p.get('id')}", **({"response": p["text"]} if response else {"thought": p["text"]}))
            elif ptype == "tool":
                state = p.get("state") or {}
                status = state.get("status")
                if status not in ("completed", "error"):
                    continue
                call = p.get("callID") or p.get("id")
                st = state.get("time") or {}
                tool = p.get("tool")
                add("PreToolUse", st.get("start") or created, f"tool:start:{call}",
                    tool_name=tool, tool_input=state.get("input"), tool_use_id=call)
                meta = state.get("metadata") or {}
                failed = status == "error" or (tool in ("bash", "shell") and isinstance(meta.get("exit"), int) and meta["exit"] != 0)
                add("PostToolUseFailure" if failed else "PostToolUse", st.get("end") or st.get("start") or created,
                    f"tool:end:{call}", tool_name=tool, tool_input=state.get("input"),
                    tool_response=state.get("error") if state.get("error") is not None else state.get("output"),
                    tool_metadata=meta, tool_use_id=call)
        done = (info.get("time") or {}).get("completed")
        if done:
            t = info.get("tokens") or {}
            cache = t.get("cache") or {}
            add("OpenCodeUsage", done, f"usage:{mid}", model=info.get("modelID"), usage={
                "input_tokens": t.get("input") or 0, "output_tokens": t.get("output") or 0,
                "cache_read_tokens": cache.get("read") or 0, "cache_write_tokens": cache.get("write") or 0,
            })
    return out


def _import_opencode(offsets: dict[str, int], origins: dict[str, str], *, verbose: bool = True,
                     skip_active_s: float = 0, held_back: list[str] | None = None) -> int:
    """Import OpenCode sessions changed since the last pass. ``offsets`` holds the
    ``time_updated`` each session had when it was last imported."""
    root = _opencode_data_root()
    try:
        root.resolve(strict=True).relative_to((_import_home() or Path.home()).resolve(strict=True))
    except (OSError, ValueError):
        if verbose:
            print("cot import: no opencode data found", file=sys.stderr)
        return 0
    sessions = _opencode_session_index(root)
    progress = _PROGRESS_SINK is not None or bool(os.environ.get("COT_IMPORT_PROGRESS"))
    weights = [max(1, s.get("messages") or 0) for s in sessions]
    total_w = sum(weights)
    last_report = 0.0

    def report(done: int, frac: float = 0.0, force: bool = False) -> None:
        nonlocal last_report
        if not progress or (not force and time.monotonic() - last_report < 0.5):
            return
        last_report = time.monotonic()
        cur = int(weights[done] * frac) if done < len(weights) else 0
        _import_progress("opencode", done, len(sessions), sum(weights[:done]) + cur, total_w)

    now_ms = time.time() * 1000
    posted = 0
    poster = _ImportPoster(f"{COT_ENDPOINT}/v1/ingest/opencode")
    for done, s in enumerate(sessions):
        report(done)
        key = f"opencode:{s['id']}"
        updated = int(s.get("updated") or 0)
        if origins.get(s["id"]) == "hook" or offsets.get(key) == updated:
            continue
        if skip_active_s and updated and now_ms - updated < skip_active_s * 1000:
            if held_back is not None:
                held_back.append(key)
            continue
        payloads = _opencode_session_payloads(s, _opencode_messages(root, s))
        if verbose:
            print(f"cot import: opencode {s['id']} ({len(payloads)} events)")
        for i, payload in enumerate(payloads):
            # Straight to the collector: _post's per-event spool round trip is
            # for the plugin's short-lived worker, not a bulk import.
            poster.add(payload)
            posted += 1
            report(done, (i + 1) / len(payloads))
        offsets[key] = updated
    poster.flush()
    report(len(sessions), force=True)
    return posted


# ----------------------------------------------------------------- Hermes
# Hermes keeps every session in one SQLite file, ``state.db`` (WAL mode, shared
# by every Hermes process). It is read in place, read-only and in short
# statements: copying it without its -wal/-shm sidecars loses recent writes.
_HERMES_SCHEMA_MAX = 31  # newest state.db schema this reader was written against


def _hermes_data_root() -> Path:
    if _import_home():
        return _import_home() / ".hermes"
    env = os.environ.get("COT_HERMES_HOME")
    return Path(env) if env else _hermes_home()


def _hermes_db_connect(path: Path):
    import sqlite3
    if not path.exists():
        return None
    try:
        conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=1)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA query_only = ON")
        return conn
    except sqlite3.Error:
        return None


def _hermes_schema_version(conn) -> int | None:
    try:
        row = conn.execute("SELECT version FROM schema_version LIMIT 1").fetchone()
        return int(row[0]) if row else None
    except Exception:  # noqa: BLE001
        return None


def _hermes_session_index(home: Path | None = None) -> list[dict]:
    """Local Hermes sessions, newest activity last. Messaging-gateway chats
    (Telegram, Discord, …) carry a ``chat_id`` and have no project folder;
    they are left out unless COT_HERMES_GATEWAY=1."""
    conn = _hermes_db_connect((home or _hermes_data_root()) / "state.db")
    if conn is None:
        return []
    try:
        version = _hermes_schema_version(conn)
        if version is not None and version > _HERMES_SCHEMA_MAX:
            print(f"cot import: hermes state.db schema {version} is newer than {_HERMES_SCHEMA_MAX};"
                  " reading the columns cot knows", file=sys.stderr)
        gateway = os.environ.get("COT_HERMES_GATEWAY") in ("1", "true", "yes")
        rows = conn.execute(
            "SELECT s.id, s.source, s.chat_id, s.model, s.parent_session_id, s.started_at,"
            " s.ended_at, s.end_reason, s.title, s.cwd,"
            " COALESCE(s.last_activity_at, s.ended_at, s.started_at) AS updated,"
            " (SELECT MAX(m.id) FROM messages m WHERE m.session_id = s.id) AS last_message,"
            " (SELECT COUNT(*) FROM messages m WHERE m.session_id = s.id) AS messages"
            " FROM sessions s ORDER BY updated"
        ).fetchall()
    except Exception:  # noqa: BLE001 - an unreadable store reads as empty
        return []
    finally:
        conn.close()
    return [dict(r) for r in rows if gateway or not r["chat_id"]]


def _hermes_messages(home: Path, sid: str) -> list[dict]:
    conn = _hermes_db_connect(home / "state.db")
    if conn is None:
        return []
    try:
        rows = conn.execute(
            "SELECT * FROM messages WHERE session_id = ? AND active = 1 ORDER BY timestamp, id", (sid,)
        ).fetchall()
        return [dict(r) for r in rows]
    except Exception:  # noqa: BLE001
        return []
    finally:
        conn.close()


def _hermes_model_usage(home: Path, sid: str) -> list[dict]:
    conn = _hermes_db_connect(home / "state.db")
    if conn is None:
        return []
    try:
        rows = conn.execute("SELECT * FROM session_model_usage WHERE session_id = ?", (sid,)).fetchall()
        return [dict(r) for r in rows]
    except Exception:  # noqa: BLE001 - table predates schema v20-something
        return []
    finally:
        conn.close()


def _hermes_ts(value: object) -> str | None:
    if isinstance(value, (int, float)) and value > 0:
        return datetime.fromtimestamp(value, timezone.utc).isoformat()
    return None


def _hermes_json(value: object) -> object:
    if isinstance(value, str):
        try:
            return json.loads(value)
        except json.JSONDecodeError:
            return value
    return value


def _hermes_tool_failed(tool: str | None, result: object) -> bool:
    # Mirrors Hermes's own observer rule: a JSON result with ``error`` failed,
    # and a terminal run failed when it exited non-zero.
    parsed = _hermes_json(result)
    if not isinstance(parsed, dict):
        return False
    if parsed.get("error"):
        return True
    code = parsed.get("exit_code")
    return tool == "terminal" and isinstance(code, int) and code != 0


def _hermes_session_payloads(session: dict, messages: list[dict], usage: list[dict]) -> list[dict]:
    """Plugin-shaped hook payloads for one Hermes session, oldest first."""
    sid = session["id"]
    cwd = session.get("cwd")
    out: list[dict] = []

    def add(hook: str, ts: object, key: str, **fields) -> None:
        out.append({
            "session_id": sid, "hook_event_name": hook, "origin": "import", "_import": True,
            "cwd": cwd, "timestamp": _hermes_ts(ts) or _hermes_ts(session.get("started_at")),
            "_dedup_key": f"hermes:{sid}:{key}", **{k: v for k, v in fields.items() if v is not None},
        })

    # Hermes stamps the first message a moment before the session row's
    # started_at; start the session no later than its first message.
    first = min((m["timestamp"] for m in messages if isinstance(m.get("timestamp"), (int, float))), default=None)
    started = session.get("started_at")
    if first is not None and (not isinstance(started, (int, float)) or first < started):
        started = first
    add("SessionStart", started, "session", model=session.get("model"),
        platform=session.get("source"), session_title=session.get("title"),
        parent_session_id=session.get("parent_session_id"))
    calls: dict[str, dict] = {}
    for m in messages:
        role, ts, mid = m.get("role"), m.get("timestamp"), m.get("message_uid") or m.get("id")
        content = m.get("content")
        if role == "user":
            if isinstance(content, str) and content.strip():
                add("UserPromptSubmit", ts, f"prompt:{mid}", prompt=content)
            continue
        if role == "assistant":
            thought = m.get("reasoning") or m.get("reasoning_content")
            if isinstance(thought, str) and thought.strip():
                add("afterAgentThought", ts, f"thought:{mid}", thought=thought)
            uids = _hermes_json(m.get("tool_call_uids")) or {}
            tool_calls = _hermes_json(m.get("tool_calls"))
            for call in tool_calls if isinstance(tool_calls, list) else []:
                fn = call.get("function") or {}
                call_id = call.get("id") or ""
                uid = (uids.get(call_id) if isinstance(uids, dict) else None) or call_id
                args = _hermes_json(fn.get("arguments"))
                calls[uid] = calls[call_id] = {"tool": fn.get("name"), "input": args if isinstance(args, dict) else {"args": args}}
                add("PreToolUse", ts, f"tool:start:{uid}", tool_name=fn.get("name"),
                    tool_input=calls[uid]["input"], tool_use_id=call_id)
            if isinstance(content, str) and content.strip():
                add("afterAgentResponse", ts, f"response:{mid}", response=content,
                    model=session.get("model"))
            continue
        if role == "tool":
            uid = m.get("tool_call_uid") or m.get("tool_call_id") or str(mid)
            call = calls.get(uid) or calls.get(m.get("tool_call_id") or "") or {}
            tool = m.get("tool_name") or call.get("tool")
            failed = _hermes_tool_failed(tool, content)
            add("PostToolUseFailure" if failed else "PostToolUse", ts, f"tool:end:{uid}",
                tool_name=tool, tool_input=call.get("input") or {}, tool_response=content,
                tool_use_id=m.get("tool_call_id"))
    end_ts = session.get("ended_at")
    for row in usage:
        add("ModelUsage", row.get("last_seen") or end_ts or session.get("updated"),
            f"usage:{row.get('model')}:{row.get('task') or ''}", model=row.get("model"), usage={
                "input_tokens": row.get("input_tokens") or 0, "output_tokens": row.get("output_tokens") or 0,
                "cache_read_tokens": row.get("cache_read_tokens") or 0,
                "cache_write_tokens": row.get("cache_write_tokens") or 0,
                "reasoning_tokens": row.get("reasoning_tokens") or 0,
            })
    if end_ts:
        add("SessionEnd", end_ts, "session:end", reason=session.get("end_reason"))
    return out


def _import_hermes(offsets: dict[str, int], origins: dict[str, str], *, verbose: bool = True,
                   skip_active_s: float = 0, held_back: list[str] | None = None) -> int:
    """Import Hermes sessions changed since the last pass. ``offsets`` holds the
    newest message id each session had when it was last imported."""
    home = _hermes_data_root()
    try:
        home.resolve(strict=True).relative_to((_import_home() or Path.home()).resolve(strict=True))
    except (OSError, ValueError):
        if verbose:
            print("cot import: no hermes data found", file=sys.stderr)
        return 0
    sessions = _hermes_session_index(home)
    # ``origins`` was read when the whole import began; a session the plugin
    # started capturing since then must not be imported over its live events.
    origins = {**origins, **_fetch_session_origins()}
    progress = _PROGRESS_SINK is not None or bool(os.environ.get("COT_IMPORT_PROGRESS"))
    weights = [max(1, s.get("messages") or 0) for s in sessions]
    total_w = sum(weights)
    now = time.time()
    posted = 0
    poster = _ImportPoster(f"{COT_ENDPOINT}/v1/ingest/hermes")
    for done, s in enumerate(sessions):
        if progress:
            _import_progress("hermes", done, len(sessions), sum(weights[:done]), total_w)
        key = f"hermes:{s['id']}"
        mark = int(s.get("last_message") or 0) * 2 + (1 if s.get("ended_at") else 0)
        if origins.get(s["id"]) == "hook" or offsets.get(key) == mark:
            continue
        updated = s.get("updated") or 0
        if skip_active_s and not s.get("ended_at") and updated and now - updated < skip_active_s:
            if held_back is not None:
                held_back.append(key)
            continue
        payloads = _hermes_session_payloads(s, _hermes_messages(home, s["id"]),
                                            _hermes_model_usage(home, s["id"]))
        if verbose:
            print(f"cot import: hermes {s['id']} ({len(payloads)} events)")
        for payload in payloads:
            poster.add(payload)
            posted += 1
        offsets[key] = mark
    poster.flush()
    if progress:
        _import_progress("hermes", len(sessions), len(sessions), total_w, total_w)
    return posted


def _fetch_session_origins() -> dict[str, str]:
    """Session id -> "hook"/"import", so the import skips hooked sessions. An
    empty map on failure means nothing is skipped; the collector then drops
    imported events for hooked sessions itself, but every one is still read and
    posted, so the timeout allows for a cold read of a large DB (seconds)."""
    try:
        req = urllib.request.Request(
            f"{COT_ENDPOINT}/v1/sessions/origins",
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        return data.get("origins") or {}
    except (urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError):
        return {}


def _import_agent(agent: str, since: str | None, offsets: dict[str, int],
                  origins: dict[str, str], *, verbose: bool = True,
                  skip_active_s: float = 0, held_back: list[str] | None = None) -> int:
    """Import transcripts for one agent. Returns count of events posted.

    ``skip_active_s`` holds back transcripts written to within that many seconds
    (a session that's still running): their offsets stay put, so a later pass
    imports them whole once they've gone quiet. Held-back paths are appended to
    ``held_back``."""
    if agent == "opencode":
        return _import_opencode(offsets, origins, verbose=verbose,
                                skip_active_s=skip_active_s, held_back=held_back)
    if agent == "hermes":
        return _import_hermes(offsets, origins, verbose=verbose,
                              skip_active_s=skip_active_s, held_back=held_back)
    transcripts = _discover_transcripts(agent)
    now_ts = time.time()
    if verbose and not transcripts:
        print(f"cot import: no {agent} transcripts found", file=sys.stderr)
        return 0

    line_parser = _ingest_line_parser(agent)

    # The collector's passive import sets COT_IMPORT_PROGRESS and reads these
    # lines to drive its progress bar: files and bytes done out of the total.
    progress = _PROGRESS_SINK is not None or bool(os.environ.get("COT_IMPORT_PROGRESS"))
    sizes: list[int] = []
    if progress:
        for path in transcripts:
            try:
                sizes.append(path.stat().st_size)
            except OSError:
                sizes.append(0)
    bytes_total = sum(sizes)
    last_report = 0.0

    def report(done: int, force: bool = False, frac: float = 0.0) -> None:
        """``frac`` is how far through transcript ``done`` the import is, so one
        large file moves the bar as it goes instead of all at once."""
        nonlocal last_report
        if not progress or (not force and time.monotonic() - last_report < 0.25):
            return
        last_report = time.monotonic()
        within = int(sizes[done] * frac) if done < len(sizes) else 0
        _import_progress(agent, done, len(transcripts), sum(sizes[:done]) + within, bytes_total)

    source = agent
    posted = 0
    poster = _ImportPoster(f"{COT_ENDPOINT}/v1/ingest/{source}")
    for done, path in enumerate(transcripts):
        report(done)
        # Derive session id
        if agent == "claude":
            sid = _session_id_from_claude_path(path)
        elif agent == "codex":
            sid = _session_id_from_codex_path(path)
        else:
            sid = _session_id_from_claude_path(path) or path.stem

        if not sid:
            continue

        # Cursor subagent transcripts are always imported in "responses-only"
        # mode: Cursor fires tool hooks inside a subagent (so the session is
        # "hook" origin and the tool calls already exist live) but never its
        # response/thought/prompt hooks, so the assistant text lives only in the
        # transcript. We import that text and drop tool_use blocks — recovering
        # responses without double-counting tools. This is decided structurally
        # (path under /subagents/) rather than from the possibly-stale origins
        # map, so `cot watch` can't briefly duplicate a fresh subagent's tools.
        is_cursor_subagent = agent == "cursor" and path.parent.name == "subagents"
        responses_only = is_cursor_subagent
        # For hook-origin Cursor sessions, supplement with transcript-only
        # tool_calls that don't fire preToolUse hooks (ReadLints, TodoWrite,
        # SwitchMode, Glob, etc.). Responses/thoughts/prompts are already
        # covered by hooks — only the no-hook tools live solely in the
        # transcript.
        hook_supplement = (
            agent == "cursor"
            and origins.get(sid) == "hook"
            and not is_cursor_subagent
        )
        if origins.get(sid) == "hook" and not is_cursor_subagent and not hook_supplement:
            continue

        if skip_active_s:
            try:
                if now_ts - path.stat().st_mtime < skip_active_s:
                    if held_back is not None:
                        held_back.append(str(path))
                    continue
            except OSError:
                pass

        # Apply --since filter on file mtime as a cheap pre-filter
        if since:
            try:
                mtime = datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)
                cutoff = datetime.fromisoformat(since.replace("Z", "+00:00"))
                if cutoff.tzinfo is None:
                    cutoff = cutoff.replace(tzinfo=timezone.utc)
                if mtime < cutoff:
                    continue
            except (OSError, ValueError):
                pass

        key = str(path)
        # Per-file state lets parsers correlate across lines (Claude/Codex pair a
        # tool call with its result; reset per file so ids never bleed across).
        # It carries across chunks of the same file.
        state: dict = {}
        try:
            mtime = path.stat().st_mtime
        except OSError:
            mtime = None
        begin = offsets.get(key, 0)
        span = max(1, (sizes[done] if done < len(sizes) else 0) - begin)

        def emit(parsed_events: list[dict]) -> None:
            nonlocal posted
            for event in _prepare_ingest_events(agent, parsed_events, origin="import"):
                # Subagent transcripts: live hooks already hold the tool calls, so
                # import only the conversation text the hooks never deliver.
                if responses_only and event.get("kind") == "tool_call":
                    continue
                # Hook-supplemented sessions: hooks already cover responses,
                # thoughts, and hooked tool calls. Only import tool_call events
                # for tools that the hook system never fires (the same set that
                # _keep_live_event preserves during live mode).
                if hook_supplement:
                    if event.get("kind") != "tool_call":
                        continue
                    if not _keep_live_event(source, event):
                        continue
                payload = _ingest_event_to_hook_payload(event)
                if payload.get("_dedup_key") is None:
                    payload.pop("_dedup_key", None)
                poster.add(payload)
                posted += 1

        while True:
            lines, new_offset, first_lineno, more = _import_read_chunk(path, offsets)
            if not lines:
                offsets[key] = new_offset
                if more:
                    continue  # skipped an oversized line; keep going
                # Codex holds its last message until the end of what's there.
                emit(_codex_flush_pending_ingest_events(state))
                break
            if verbose:
                print(f"cot import: {agent} {path.name} ({len(lines)} new lines)")
            parsed_events: list[dict] = []
            for i, line in enumerate(lines):
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                parsed_events.extend(
                    line_parser(
                        obj,
                        sid,
                        lineno=first_lineno + i,
                        mtime=mtime,
                        state=state,
                        path=key,
                        origin="import",
                    )
                )
            if not more:
                # Codex holds its last message until the end of what's there.
                parsed_events.extend(_codex_flush_pending_ingest_events(state))
            emit(parsed_events)
            del parsed_events
            offsets[key] = new_offset
            report(done, frac=min(1.0, (new_offset - begin) / span))  # throttled
            if not more:
                break

    poster.flush()
    report(len(transcripts), force=True)
    return posted


def _run_import(agents: list[str], *, since: str | None = None, skip_active_s: float = 0,
                verbose: bool = True, complete_quiet_s: float | None = None) -> tuple[int, list[str]]:
    """One import pass over ``agents``: events, then session completion,
    question recovery and subagent links. Returns (events posted, held-back
    transcripts). ``cot import`` runs it over HTTP; the collector runs it in
    its own process with ``_INGEST_SINK`` set. ``complete_quiet_s`` closes only
    imported sessions quiet that long, for a pass that reads live transcripts."""
    say = print if verbose else (lambda *a, **k: None)
    _reindex_if_parser_changed()
    origins = _fetch_session_origins()
    offsets = _import_offsets_load()
    total = 0
    held_back: list[str] = []

    for agent in agents:
        count = _import_agent(agent, since, offsets, origins, verbose=verbose,
                              skip_active_s=skip_active_s, held_back=held_back)
        total += count
    if held_back:
        say(f"cot import: held back {len(held_back)} in-progress transcript(s) for the next run")

    _import_offsets_save(offsets)
    _write_import_parser_version()

    # Mark import-only sessions as completed — transcripts don't carry
    # lifecycle end events, so without this they'd stay "active" forever.
    if total > 0:
        try:
            req = urllib.request.Request(
                f"{COT_ENDPOINT}/v1/sessions/complete-imported",
                method="POST",
                headers={"Content-Type": "application/json"},
                data=json.dumps({"quiet_seconds": complete_quiet_s} if complete_quiet_s else {}).encode(),
            )
            with urllib.request.urlopen(req, timeout=10) as resp:
                result = json.loads(resp.read().decode("utf-8"))
                closed = result.get("completed", 0)
                if closed:
                    say(f"cot import: marked {closed} imported sessions as completed")
        except (urllib.error.URLError, TimeoutError, OSError):
            pass

    recovered = _recover_questions()
    if recovered:
        say(f"cot import: recovered {recovered} question answer(s)")

    _sync_subagent_links(agents, verbose=verbose)
    return total, held_back


def _session_sources() -> list[dict]:
    """Other machines' session folders to import: ``[{"path": …, "machine": …}]``
    in ~/.cot/session_sources.json. Each path is a home directory as copied or
    mounted from that machine (it holds .claude, .codex, .cursor …)."""
    try:
        data = json.loads(SESSION_SOURCES_PATH.read_text())
    except (OSError, ValueError):
        return []
    items = data.get("sources") if isinstance(data, dict) else data
    out = []
    for item in items if isinstance(items, list) else []:
        if isinstance(item, dict) and item.get("path") and item.get("machine"):
            out.append({"path": os.path.expanduser(str(item["path"])), "machine": str(item["machine"])})
    return out


def _save_session_sources(sources: list[dict]) -> None:
    _write_json_atomic(SESSION_SOURCES_PATH, {"sources": sources})


def _run_import_from(home: str, machine: str, agents: list[str], **kwargs) -> tuple[int, list[str]]:
    """One import pass over a copied or mounted home from ``machine``."""
    global _IMPORT_HOME_OVERRIDE, _IMPORT_MACHINE
    root = Path(home)
    if not root.is_dir():
        return 0, []
    _IMPORT_HOME_OVERRIDE, _IMPORT_MACHINE = root, machine
    try:
        return _run_import(agents, **kwargs)
    finally:
        _IMPORT_HOME_OVERRIDE = _IMPORT_MACHINE = None


def _import_sources(agents: list[str], **kwargs) -> int:
    total = 0
    for src in _session_sources():
        posted, _ = _run_import_from(src["path"], src["machine"], agents, **kwargs)
        total += posted
    return total


def _cmd_sources(args: list[str]) -> int:
    """`cot sources [list | add PATH --machine NAME | remove NAME]`."""
    action = args[0] if args else "list"
    sources = _session_sources()
    if action == "list":
        if not sources:
            print("cot sources: none. Add one with `cot sources add PATH --machine NAME`.")
        for src in sources:
            state = "ok" if Path(src["path"]).is_dir() else "missing"
            print(f"  {src['machine']:16s} {src['path']}  ({state})")
        return 0
    if action == "add" and len(args) >= 2:
        machine = args[args.index("--machine") + 1] if "--machine" in args and args.index("--machine") + 1 < len(args) else None
        if not machine:
            print("cot sources add: --machine NAME is required", file=sys.stderr)
            return 2
        path = os.path.abspath(os.path.expanduser(args[1]))
        sources = [s for s in sources if s["machine"] != machine] + [{"path": path, "machine": machine}]
        _save_session_sources(sources)
        print(f"cot sources: {machine} → {path}. The next import (or `cot import --sources`) reads it.")
        return 0
    if action == "remove" and len(args) >= 2:
        kept = [s for s in sources if s["machine"] != args[1]]
        _save_session_sources(kept)
        print(f"cot sources: removed {len(sources) - len(kept)}")
        return 0
    print("Usage: cot sources [list | add PATH --machine NAME | remove NAME]", file=sys.stderr)
    return 2


def _cmd_import(args: list[str]) -> int:
    import argparse
    parser = argparse.ArgumentParser(prog="cot import",
                                     description="Import historical agent transcripts")
    parser.add_argument("--agent", action="append", choices=["claude", "cursor", "codex", "opencode", "hermes"],
                        help="Agent(s) to import (default: all)")
    parser.add_argument("--since", help="Only import transcripts modified after YYYY-MM-DD")
    parser.add_argument("--report", action="store_true",
                        help="Print an ingestion quality/coverage report when done")
    parser.add_argument("--skip-active", type=float, default=0, metavar="MINUTES",
                        help="Leave transcripts written to in the last MINUTES for a later run "
                             "(sessions still in progress)")
    parser.add_argument("--from", dest="from_home", metavar="DIR",
                        help="Import a home directory copied or mounted from another machine")
    parser.add_argument("--machine", help="Name for the machine --from reads (shown on its sessions)")
    parser.add_argument("--sources", action="store_true",
                        help="Also import every folder in ~/.cot/session_sources.json (see `cot sources`)")
    parsed = parser.parse_args(args)

    agents = parsed.agent or ["claude", "cursor", "codex", "opencode", "hermes"]
    skip = max(0.0, parsed.skip_active) * 60
    if parsed.from_home:
        if not parsed.machine:
            parser.error("--from needs --machine NAME")
        total, _ = _run_import_from(parsed.from_home, parsed.machine, agents, since=parsed.since, skip_active_s=skip)
    else:
        total, _ = _run_import(agents, since=parsed.since, skip_active_s=skip)
        if parsed.sources:
            total += _import_sources(agents, since=parsed.since, skip_active_s=skip)
    print(f"cot import: done — {total} events posted")
    if parsed.report:
        _print_import_report()
    return 0


def _print_import_report() -> None:
    """Fetch and print the ingestion quality / coverage report."""
    try:
        data = _api_json("GET", "/v1/import/report")
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:
        print(f"cot import: report unavailable ({exc})", file=sys.stderr)
        return
    print("\ncot import: coverage by source")
    print(f"  {'source':8s} {'events':>8s} {'tools':>7s} {'other%':>7s} {'tokens%':>8s} {'model%':>7s}")
    for r in data.get("by_source", []):
        print(
            f"  {str(r.get('source')):8s} {r.get('events', 0):>8d}"
            f" {r.get('tool_events', 0):>7d} {r.get('other_pct', 0):>6.1f}%"
            f" {r.get('token_coverage_pct', 0):>7.1f}%"
            f" {(100.0 * (r.get('with_model', 0)) / r['events']) if r.get('events') else 0:>6.1f}%"
        )
    cats = data.get("by_category", [])
    if cats:
        top = ", ".join(f"{c['category']}={c['events']}" for c in cats[:8])
        print(f"  categories: {top}")


def _scan_questions_full(path: Path) -> list[dict]:
    """Pair each AskQuestion tool_use with the agent's next text block.

    Cursor doesn't persist the user's selection, so the follow-up prose is the
    only signal. Reads the whole file (not a delta) so recovery is independent
    of import offsets. Returns [{"input", "response_text"}]."""
    pending: list[dict] = []
    out: list[dict] = []
    content_text = _read_text_capped(path)
    if content_text is None:
        return out
    for line in content_text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        message = obj.get("message") if isinstance(obj.get("message"), dict) else {}
        role = obj.get("role") or message.get("role") or obj.get("type")
        content = obj.get("content")
        if content is None:
            content = message.get("content")
        if not isinstance(content, list):
            continue
        for block in content:
            if not isinstance(block, dict):
                continue
            if block.get("type") == "tool_use" and block.get("name") == "AskQuestion":
                inp = block.get("input") if isinstance(block.get("input"), dict) else {}
                if isinstance(inp.get("questions"), list):
                    pending.append(inp)
            # Only the agent's own follow-up reveals the choice; a following
            # *user* message (e.g. a pasted request) is not the answer.
            elif block.get("type") == "text" and pending and role == "assistant":
                response_text = str(block.get("text") or "")
                if not response_text.strip():
                    continue
                for inp in pending:
                    out.append({"input": inp, "response_text": response_text})
                pending = []
    return out


def _question_qids(tool_input: dict) -> list[str]:
    questions = tool_input.get("questions") if isinstance(tool_input.get("questions"), list) else []
    return [
        str(q.get("id") or q.get("prompt") or q.get("question") or "")
        for q in questions
        if isinstance(q, dict)
    ]


def _question_answer_payload(session_id: str, tool_input: dict, response_text: str) -> dict:
    return {
        "session_id": session_id,
        "title": tool_input.get("title"),
        "qids": _question_qids(tool_input),
        "response_text": response_text,
    }


def _recover_questions() -> int:
    """Host-side AskQuestion answer recovery, pushed to the collector.

    Works for both live and imported Cursor sessions: the transcript filename
    stem is the session id used in storage. Posts only non-empty follow-up prose.
    Clears previously recovered (heuristic) answers first so a re-run replaces
    stale guesses rather than leaving them stuck."""
    try:
        _api_json("POST", "/v1/questions/reset-recovered", {})
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        pass
    posted = 0
    for path in _discover_transcripts("cursor"):
        sid = path.stem
        for item in _scan_questions_full(path):
            inp = item["input"]
            response_text = item["response_text"]
            if not str(response_text or "").strip():
                continue
            payload = _question_answer_payload(sid, inp, response_text)
            try:
                req = urllib.request.Request(
                    f"{COT_ENDPOINT}/v1/questions/answer",
                    data=json.dumps(payload, ensure_ascii=False, default=str).encode("utf-8"),
                    headers={"Content-Type": "application/json"},
                    method="POST",
                )
                with urllib.request.urlopen(req, timeout=5) as r:
                    result = json.loads(r.read().decode("utf-8"))
                    posted += int(result.get("updated") or 0)
            except (urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError):
                pass
    return posted


def _cmd_recover_questions(args: list[str]) -> int:
    n = _recover_questions()
    print(f"cot recover-questions: filled {n} answer(s) from transcripts")
    return 0


def _cmd_reimport(args: list[str]) -> int:
    """Wipe previously imported data and re-ingest all transcripts fresh.

    Clears the collector's import-origin rows and the local byte offsets, then
    runs a full import so transcripts are re-parsed with the current logic.
    Live hook data is left untouched.
    """
    try:
        res = _api_json("POST", "/v1/import/reset", {})
        print(
            f"cot reimport: cleared {res.get('deleted_events', 0)} events,"
            f" {res.get('deleted_sessions', 0)} sessions"
        )
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:
        print(f"cot reimport: reset failed: {exc}", file=sys.stderr)
        return 1

    try:
        if IMPORT_OFFSETS_PATH.exists():
            IMPORT_OFFSETS_PATH.unlink()
    except OSError as exc:
        print(f"cot reimport: could not clear offsets: {exc}", file=sys.stderr)

    agents = ["claude", "cursor", "codex"]
    origins = _fetch_session_origins()
    offsets: dict[str, int] = {}
    total = 0
    for agent in agents:
        total += _import_agent(agent, None, offsets, origins, verbose=True)
    _import_offsets_save(offsets)

    if total > 0:
        try:
            req = urllib.request.Request(
                f"{COT_ENDPOINT}/v1/sessions/complete-imported",
                method="POST",
                headers={"Content-Type": "application/json"},
                data=b"{}",
            )
            with urllib.request.urlopen(req, timeout=10) as resp:
                result = json.loads(resp.read().decode("utf-8"))
                closed = result.get("completed", 0)
                if closed:
                    print(f"cot reimport: marked {closed} imported sessions as completed")
        except (urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError):
            pass

    recovered = _recover_questions()
    if recovered:
        print(f"cot reimport: recovered {recovered} question answer(s)")

    _sync_subagent_links(agents, verbose=True)

    _write_import_parser_version()
    print(f"cot reimport: done — {total} events posted")
    return 0


def _cmd_watch(args: list[str]) -> int:
    import argparse
    import time as _time

    parser = argparse.ArgumentParser(prog="cot watch",
                                     description="Watch for new transcript lines")
    parser.add_argument("--agent", action="append", choices=["claude", "cursor", "codex"],
                        help="Agent(s) to watch (default: all)")
    parser.add_argument("--interval", type=int, default=10,
                        help="Seconds between poll cycles (default: 10)")
    parsed = parser.parse_args(args)

    agents = parsed.agent or ["claude", "cursor", "codex"]
    interval = max(2, parsed.interval)

    print(f"cot watch: monitoring {', '.join(agents)} (poll every {interval}s)")
    print(f"cot watch: endpoint {COT_ENDPOINT}")

    # Initial import pass
    _reindex_if_parser_changed()
    origins = _fetch_session_origins()
    offsets = _import_offsets_load()
    for agent in agents:
        count = _import_agent(agent, None, offsets, origins)
        if count:
            print(f"cot watch: initial import — {count} {agent} events")
    _import_offsets_save(offsets)
    _sync_subagent_links(agents)
    _write_import_parser_version()

    # Tail loop — refresh origins every 10 cycles so newly-hooked sessions
    # are skipped promptly (avoids duplicating hook data from transcripts).
    cycle = 0
    try:
        while True:
            _time.sleep(interval)
            cycle += 1
            if cycle % 10 == 0:
                origins = _fetch_session_origins()
            offsets = _import_offsets_load()
            for agent in agents:
                count = _import_agent(agent, None, offsets, origins, verbose=False)
                if count:
                    print(f"cot watch: +{count} {agent} events")
            _import_offsets_save(offsets)
            # Newly-finished subagents get embedded under their parent. Cheap
            # filesystem glob; throttled so we don't post on every poll.
            if cycle % 5 == 0:
                _sync_subagent_links(agents)
    except KeyboardInterrupt:
        print("\ncot watch: stopped")
        return 0


# --- MCP server ---------------------------------------------------------------
#
# `cot mcp` speaks the Model Context Protocol over stdio so an agent can ask
# cot about past sessions: what ran, what it cost, what failed. Every tool is
# read-only and goes through the collector's HTTP API on localhost; nothing
# here writes to the DB or leaves the machine. stdout carries only JSON-RPC.

_MCP_PROTOCOLS = ("2025-06-18", "2025-03-26", "2024-11-05")
# The tool interface's own version, bumped when a tool's inputs or output change.
_MCP_SERVER_VERSION = "1"
_MCP_TEXT_MAX = 400


def _mcp_short(text: object, limit: int = _MCP_TEXT_MAX) -> str | None:
    if text is None:
        return None
    s = " ".join(str(text).split())
    return s if len(s) <= limit else s[: limit - 1] + "…"


def _mcp_get(path: str, params: dict | None = None) -> dict:
    query = urllib.parse.urlencode({k: v for k, v in (params or {}).items() if v not in (None, "")})
    req = urllib.request.Request(f"{COT_ENDPOINT}{path}{'?' + query if query else ''}", method="GET")
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.loads(resp.read().decode("utf-8"))


def _mcp_since(days: object) -> str | None:
    try:
        d = int(days)
    except (TypeError, ValueError):
        return None
    if d <= 0:
        return None
    return (datetime.now(timezone.utc) - timedelta(days=d)).isoformat()


def _mcp_rating(value: object) -> int | None:
    return {"up": 1, "good": 1, "down": -1, "bad": -1}.get(str(value or "").lower())


def _mcp_session_row(s: dict) -> dict:
    return {
        "id": s.get("id"),
        "title": _mcp_short(s.get("title"), 160),
        "agent": s.get("source"),
        "project": s.get("cwd"),
        "started_at": s.get("started_at"),
        "last_activity": s.get("last_activity"),
        "duration_seconds": s.get("duration_seconds"),
        "events": s.get("event_count"),
        "tool_calls": s.get("tool_count"),
        "tokens": (s.get("tokens") or {}).get("total"),
        "cost_usd": s.get("cost_usd") if s.get("has_cost") else None,
        "models": s.get("models"),
        "rating": {1: "up", -1: "down"}.get(s.get("rating")),
    }


def _mcp_list_sessions(args: dict) -> dict:
    limit = max(1, min(int(args.get("limit") or 20), 100))
    since = _mcp_since(args.get("days", 7))
    rating = _mcp_rating(args.get("rating"))
    data = _mcp_get("/v1/sessions", {
        "limit": 500 if (since or rating) else limit,
        "source": args.get("agent"),
        "q": args.get("query"),
        "project": args.get("project"),
    })
    out = []
    for s in data.get("sessions") or []:
        if since and (s.get("last_activity") or s.get("started_at") or "") < since:
            continue  # newest first, but a long session can outlive a newer one's start
        if rating is not None and s.get("rating") != rating:
            continue
        out.append(_mcp_session_row(s))
        if len(out) >= limit:
            break
    return {"sessions": out, "matched": len(out)}


_MCP_TEXT_EVENTS = {"prompt", "response", "question", "plan"}


def _mcp_get_session(args: dict) -> dict:
    sid = str(args.get("session_id") or "").strip()
    if not sid:
        raise ValueError("session_id is required")
    max_events = max(10, min(int(args.get("max_events") or 80), 400))
    detail = _mcp_get(f"/v1/sessions/{urllib.parse.quote(sid, safe='')}")
    events = detail.get("events") or detail.get("timeline") or []
    rows = []
    for e in events:
        cat = e.get("category")
        if cat in ("thought", "lifecycle", "meta"):
            continue
        failed = e.get("status") in ("error", "failed")
        rows.append({
            "event_id": e.get("id"),
            "ts": e.get("ts"),
            "kind": cat,
            "tool": e.get("tool"),
            "target": _mcp_short(e.get("target"), 200),
            "text": _mcp_short(e.get("detail")) if cat in _MCP_TEXT_EVENTS else None,
            "failed": failed or None,
            "duration_ms": e.get("duration_ms"),
        })
    # Prompts and failures always make the cut; the rest fill what is left in order.
    keep = {i for i, r in enumerate(rows) if r["kind"] == "prompt" or r["failed"]}
    for i in range(len(rows)):
        if len(keep) >= max_events:
            break
        keep.add(i)
    shown = [{k: v for k, v in r.items() if v is not None} for i, r in enumerate(rows) if i in keep]
    links = detail.get("links") or {}
    annotations = None
    try:
        annotations = _mcp_get(f"/v1/sessions/{urllib.parse.quote(sid, safe='')}/annotations")
    except urllib.error.HTTPError:
        pass
    return {
        "summary": _mcp_session_row(detail.get("summary") or {}),
        "subagents": [c.get("session_id") for c in links.get("children") or [] if c.get("type") == "subagent"],
        "annotation": (annotations or {}).get("session"),
        "events": shown,
        "events_omitted": len(rows) - len(shown),
    }


def _mcp_session_cost(args: dict) -> dict:
    sid = str(args.get("session_id") or "").strip()
    if not sid:
        raise ValueError("session_id is required")
    return _mcp_get(f"/v1/sessions/{urllib.parse.quote(sid, safe='')}/cost")


def _mcp_search(args: dict) -> dict:
    q = str(args.get("query") or "").strip()
    if len(q) < 2:
        raise ValueError("query needs at least 2 characters")
    data = _mcp_get("/v1/search", {
        "q": q, "limit": max(1, min(int(args.get("limit") or 20), 100)), "session_id": args.get("session_id"),
        "mode": args.get("mode") if args.get("mode") in ("semantic", "hybrid") else None,
    })
    return {"results": [
        {k: (_mcp_short(v, 240) if k in ("snippet", "target") else v) for k, v in r.items()}
        for r in data.get("results") or []
    ]}


def _mcp_context(args: dict) -> dict:
    data = _mcp_get("/v1/context", {
        "days": int(args.get("days") if args.get("days") is not None else 30),
        "source": args.get("agent"), "project": args.get("project"),
    })

    def idle(rows: list) -> list:
        return [
            {"name": r["name"], "tokens_per_request": r["tokens_per_request"], "agents": r["agents"]}
            for r in rows if r.get("idle") and r.get("tokens_per_request")
        ][:15]

    return {
        "days": data.get("days"),
        "note": "Request counts and floors are measured; the memory/skills/MCP split is estimated from files on disk (~4 bytes per token).",
        "agents": data.get("agents"),
        "idle_mcp_servers": idle(data.get("mcp") or []),
        "idle_skills": idle(data.get("skills") or []),
        "largest_memory_files": [
