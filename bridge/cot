def _app_dirs(*apps: str, sub: str = "User") -> tuple[str, ...]:
    """An editor's user folder on macOS, Linux and Windows, for each app name."""
    return tuple(f"{base}/{app}/{sub}" for app in apps
                 for base in ("Library/Application Support", ".config", "AppData/Roaming"))


