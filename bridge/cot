# ---------------------------------------------------------------- Kiro CLI
# ~/.kiro/sessions/cli/<id>.jsonl with <id>.json beside it (cwd, title,
# timestamps). Lines are {kind: Prompt | AssistantMessage | ToolResults,
# data: {content: [{kind: text | toolUse | toolResult, data}]}}.

def _kiro_index(root: Path) -> list[dict]:
    out = [s for s in (_file_session(p) for p in sorted(root.glob("sessions/cli/*.jsonl"))) if s]
    # Newer releases (and Amazon Q Developer CLI, which Kiro CLI grew from)
    # keep conversations in data.sqlite3: conversations_v2, a JSON value per
    # save, newest wins.
    db_path = root / "data.sqlite3"
    rows = _sqlite_rows(db_path, "SELECT conversation_id, MAX(updated_at) AS updated, MIN(created_at) AS created,"
                                 " length(value) AS n FROM conversations_v2 GROUP BY conversation_id")
    for r in rows:
        out.append({"id": r["conversation_id"], "updated": _reader_epoch(r["updated"]), "started": r["created"],
                    "bytes": r["n"] or 0, "_db": db_path})
    return out


def _kiro_sqlite_items(session: dict) -> list[dict]:
    rows = _sqlite_rows(session["_db"], "SELECT value FROM conversations_v2 WHERE conversation_id = ?"
                                        " ORDER BY updated_at DESC, created_at DESC LIMIT 1", (session["id"],))
    doc = _reader_json(rows[0]["value"]) if rows else None
    items: list[dict] = []
    tools: dict = {}
    for n, turn in enumerate((doc or {}).get("history") or [] if isinstance(doc, dict) else []):
        if not isinstance(turn, dict):
            continue
        user = turn.get("user") if isinstance(turn.get("user"), dict) else {}
        env = ((user.get("env_context") or {}).get("env_state") or {}) if isinstance(user.get("env_context"), dict) else {}
        session["cwd"] = session.get("cwd") or env.get("current_working_directory")
        content = user.get("content") if isinstance(user.get("content"), dict) else {}
        ts = user.get("timestamp")
        prompt = (content.get("Prompt") or {}).get("prompt") if isinstance(content.get("Prompt"), dict) else None
        if prompt:
            items.append({"kind": "prompt", "id": f"p{n}", "ts": ts, "text": prompt})
        results = content.get("ToolUseResults") if isinstance(content.get("ToolUseResults"), dict) else {}
        for res in results.get("tool_use_results") or []:
            call = tools.get(res.get("tool_use_id")) if isinstance(res, dict) else None
            if call is not None:
                blocks = res.get("content") or []
                text = "\n".join(str(b.get("Text") or b.get("Json") or "") for b in blocks if isinstance(b, dict))
                call.update(output=text, end_ts=ts, failed=str(res.get("status") or "").lower() == "error")
        assistant = turn.get("assistant") if isinstance(turn.get("assistant"), dict) else {}
        end = (turn.get("request_metadata") or {}).get("stream_end_timestamp_ms") if isinstance(turn.get("request_metadata"), dict) else None
        reply = assistant.get("Response") or assistant.get("ToolUse") or {}
        if isinstance(reply, dict):
            items.append({"kind": "response", "id": reply.get("message_id") or f"r{n}", "ts": end or ts,
                          "text": reply.get("content") or ""})
            for use in reply.get("tool_uses") or []:
                if isinstance(use, dict) and use.get("name"):
                    name, args = use["name"], use.get("args") if isinstance(use.get("args"), dict) else {}
                    if name in ("write", "fs_write"):
                        name = "Edit" if args.get("command") in ("strReplace", "str_replace") else "Write"
                    tid = use.get("id") or f"t{n}"
                    tools[tid] = {"kind": "tool", "id": tid, "ts": end or ts, "name": name, "input": args}
                    items.append(tools[tid])
    return items


def _kiro_items(session: dict, root: Path) -> list[dict]:
    if "_db" in session:
        return _kiro_sqlite_items(session)
    meta = _read_json_doc(session["_path"].with_suffix(".json"))
    if isinstance(meta, dict):
        paths = meta.get("workspacePaths")
        session.update(cwd=meta.get("cwd") or (paths[0] if isinstance(paths, list) and paths else None),
                       title=meta.get("title"), started=meta.get("createdAt") or meta.get("created_at"))
    items: list[dict] = []
    tools: dict = {}
    for n, rec in enumerate(_read_jsonl_file(session["_path"])):
        kind, ts = rec.get("kind"), rec.get("timestamp")
        data = rec.get("data") if isinstance(rec.get("data"), dict) else {}
        text: list[str] = []
        for i, block in enumerate(data.get("content") or []):
            if not isinstance(block, dict):
                continue
            bkind, bdata = block.get("kind"), block.get("data")
            if bkind == "text" and isinstance(bdata, str):
                text.append(bdata)
            elif bkind == "toolUse" and isinstance(bdata, dict):
                tid = bdata.get("toolUseId") or f"{n}:{i}"
                name = bdata.get("name")
                tool_input = bdata.get("input") if isinstance(bdata.get("input"), dict) else {}
                if name == "write":  # Kiro's write tool edits or creates by its command
                    name = "Edit" if tool_input.get("command") == "strReplace" else "Write"
                tools[tid] = {"kind": "tool", "id": tid, "ts": ts, "name": name, "input": tool_input}
                items.append(tools[tid])
            elif bkind == "toolResult" and isinstance(bdata, dict) and tools.get(bdata.get("toolUseId")) is not None:
                tools[bdata["toolUseId"]].update(output=_reader_text(bdata.get("content")) or bdata.get("content"),
                                                 end_ts=ts, failed=bdata.get("status") == "error")
        if kind == "Prompt" and text:
            items.append({"kind": "prompt", "id": n, "ts": ts, "text": "\n".join(text)})
        elif kind == "AssistantMessage" and text:
            items.append({"kind": "response", "id": n, "ts": ts, "text": "\n".join(text)})
    return items


_register(_Reader("kiro-cli", "Kiro CLI", (".kiro", ".local/share/kiro-cli", "Library/Application Support/kiro-cli"),
                  env="KIRO_DIR", index=_kiro_index, items=_kiro_items,
                  tools={"fs_read": "Read", "execute_bash": "Bash", "shell": "Bash", "glob": "Glob", "grep": "Grep"}))


# ----------------------------------------------------------- OpenHands CLI
# ~/.openhands/conversations/<id>/base_state.json (model) and events/*.json,
# one event per file: MessageEvent (llm_message), ActionEvent (tool_name,
# tool_call_id, action) and ObservationEvent (tool_call_id, observation).

def _openhands_index(root: Path) -> list[dict]:
    out = []
    for state in sorted(root.glob("conversations/*/base_state.json")):
        events = list(state.parent.glob("events/*.json"))
        newest = max([state, *events], key=lambda p: p.stat().st_mtime if p.exists() else 0)
        s = _file_session(newest, state.parent.name)
        if s:
            s.update(weight=len(events), _dir=state.parent)
            out.append(s)
    return out


def _openhands_items(session: dict, root: Path) -> list[dict]:
    base = _read_json_doc(session["_dir"] / "base_state.json")
    base = base if isinstance(base, dict) else {}
    llm = ((base.get("agent") or {}).get("llm") or {}) if isinstance(base.get("agent"), dict) else {}
    model = llm.get("model") if isinstance(llm, dict) else None
    session.update(id=base.get("id") or session["id"], model=model)
    items: list[dict] = []
    tools: dict = {}
    events = [e for e in (_read_json_doc(p) for p in sorted((session["_dir"] / "events").glob("*.json")))
              if isinstance(e, dict)]
    events.sort(key=lambda e: str(e.get("timestamp") or ""))
    for n, ev in enumerate(events):
        kind, ts, eid = ev.get("kind"), ev.get("timestamp"), ev.get("id") or n
        if kind == "MessageEvent":
            msg = ev.get("llm_message") if isinstance(ev.get("llm_message"), dict) else {}
            role = msg.get("role") or ("user" if ev.get("source") == "user" else "assistant")
            text = _reader_text(msg.get("content"))
            items.append({"kind": "prompt" if role == "user" else "response", "id": eid, "ts": ts, "text": text,
                          "model": model})
        elif kind == "ActionEvent":
            thought = _reader_text(ev.get("thought"))
            if thought:
                items.append({"kind": "thought", "id": f"{eid}:t", "ts": ts, "text": thought})
            action = ev.get("action") if isinstance(ev.get("action"), dict) else {}
            name = ev.get("tool_name") or action.get("kind")
            if name in ("str_replace_editor", "file_editor"):
                cmd = action.get("command")
                name = {"view": "Read", "create": "Write"}.get(cmd, "Edit")
            tid = ev.get("tool_call_id") or eid
            tools[tid] = {"kind": "tool", "id": tid, "ts": ts, "name": name, "input": action}
            items.append(tools[tid])
        elif kind in ("ObservationEvent", "AgentErrorEvent") and tools.get(ev.get("tool_call_id")) is not None:
            obs = ev.get("observation") if isinstance(ev.get("observation"), dict) else {}
            code = obs.get("exit_code")
            tools[ev["tool_call_id"]].update(
                output=_reader_text(obs.get("content")) or obs.get("error") or ev.get("error"), end_ts=ts,
                failed=kind == "AgentErrorEvent" or bool(obs.get("error")) or (isinstance(code, int) and code != 0))
            session["cwd"] = session.get("cwd") or obs.get("working_dir")
    return items


_register(_Reader("openhands", "OpenHands", (".openhands",), env="OPENHANDS_DIR", index=_openhands_index,
                  items=_openhands_items, tools={"execute_bash": "Bash", "terminal": "Bash", "task_tracker": "TodoWrite"}))


# --------------------------------------------------------------------- Amp
# Amp keeps threads on its servers now; older releases left one JSON per
# thread in ~/.local/share/amp/threads/T-*.json: {id, created, title,
# messages: [{role, content: blocks, usage, meta: {sentAt}}], env}.

def _amp_index(root: Path) -> list[dict]:
    return [s for s in (_file_session(p) for p in sorted(root.glob("threads/T-*.json"))) if s]


def _amp_items(session: dict, root: Path) -> list[dict]:
    doc = _read_json_doc(session["_path"])
    if not isinstance(doc, dict):
        return []
    trees = (((doc.get("env") or {}).get("initial") or {}).get("trees") or []) if isinstance(doc.get("env"), dict) else []
    uri = trees[0].get("uri") if trees and isinstance(trees[0], dict) else None
    session.update(id=doc.get("id") or session["id"], title=doc.get("title"), started=doc.get("created"),
                   cwd=urllib.parse.unquote(uri[len("file://"):]) if isinstance(uri, str) and uri.startswith("file://") else None)
    items: list[dict] = []
    tools: dict = {}
    for n, m in enumerate(doc.get("messages") or []):
        if not isinstance(m, dict):
            continue
        meta = m.get("meta") if isinstance(m.get("meta"), dict) else {}
        state = m.get("state") if isinstance(m.get("state"), dict) else {}
        ts = meta.get("sentAt") or state.get("completedAt")
        usage = m.get("usage") if isinstance(m.get("usage"), dict) else None
        model = usage.get("model") if usage else None
        content = m.get("content")
        if isinstance(content, list):  # Amp's blocks: tool_result results live in ``run``
            content = [{**b, "content": (b.get("run") or {}).get("result"),
                        "is_error": (b.get("run") or {}).get("status") == "error"}
                       if isinstance(b, dict) and b.get("type") == "tool_result" and "run" in b else b for b in content]
        _anthropic_blocks(items, tools, m.get("messageId") or n, m.get("role") or "", ts, content, model)
        if usage:
            items.append({"kind": "usage", "id": n, "ts": ts, "model": model, "usage": _usage_counts(usage)})
    return items


_register(_Reader("amp", "Amp", (".local/share/amp",), env="AMP_DIR", index=_amp_index, items=_amp_items,
                  tools={"Bash": "Bash", "edit_file": "Edit", "create_file": "Write", "Read": "Read"}))


# ------------------------------------------------------------------- Aider
# Aider writes .aider.chat.history.md in each repo it runs in, so there's no
# folder to find: it's opt-in, with AIDER_DIR naming folders to search
# (":"-separated). Each "# aider chat started at …" starts a session; "#### "
# lines are the person's prompts, "> " lines are aider's own output (commands,
# edits applied), the rest is the model's reply.

def _aider_roots() -> list[Path]:
    out = []
    for raw in (os.environ.get("AIDER_DIR") or "").split(os.pathsep):
        if raw.strip():
            safe = _safe_transcript_root(Path(raw.strip()).expanduser())
            if safe:
                out.append(safe)
    return out


def _aider_index(root: Path) -> list[dict]:
    out = []
    for path in sorted(root.glob("**/.aider.chat.history.md")):
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        starts = [m for m in re.finditer(r"^# aider chat started at (.+)$", text, re.M)]
        mtime = path.stat().st_mtime
        for i, m in enumerate(starts):
            body = text[m.end(): starts[i + 1].start() if i + 1 < len(starts) else len(text)]
            sid = hashlib.sha1(f"{path}:{m.group(1)}".encode()).hexdigest()[:16]  # noqa: S324 - an id, not a secret
            out.append({"id": f"aider-{sid}", "cwd": str(path.parent), "started": m.group(1).strip().replace(" ", "T"),
                        "updated": mtime if i == len(starts) - 1 else _reader_epoch(m.group(1).strip().replace(" ", "T")),
                        "bytes": len(body), "weight": body.count("\n#### "), "_body": body,
                        "ended": i < len(starts) - 1})
    return out


def _aider_items(session: dict, root: Path) -> list[dict]:
    items: list[dict] = []
    reply: list[str] = []
    ts = session.get("started")

    def flush() -> None:
        text = "\n".join(reply).strip()
        if text:
            items.append({"kind": "response", "id": f"r{len(items)}", "ts": ts, "text": text})
        reply.clear()

    for line in session["_body"].splitlines():
        if line.startswith("#### "):
            flush()
            items.append({"kind": "prompt", "id": f"p{len(items)}", "ts": ts, "text": line[5:]})
        elif line.startswith("> "):
            note = line[2:].strip()
            m = re.match(r"(?:Running|Run shell command\??)\s*:?\s*(.+)", note)
            if m:
                flush()
                items.append({"kind": "tool", "id": f"c{len(items)}", "ts": ts, "name": "Bash",
                              "input": {"command": m.group(1)}, "failed": False})
            m = re.match(r"Applied edit to (.+)", note)
            if m:
                flush()
                items.append({"kind": "tool", "id": f"e{len(items)}", "ts": ts, "name": "Edit",
                              "input": {"file_path": m.group(1)}, "failed": False})
        else:
            reply.append(line)
    flush()
    return items


class _AiderReader(_Reader):
    def roots(self) -> list[Path]:
        return _aider_roots()


_register(_AiderReader("aider", "Aider", (), env="AIDER_DIR", opt_in=True, index=_aider_index, items=_aider_items))


# ---------------------------------------------------------------- Windsurf
# Windsurf (a VS Code fork) keeps chat-panel tabs in each workspace's
# state.vscdb under workbench.panel.aichat.view.aichat.chatdata: {tabs:
# [{tabId, chatTitle, bubbles: [{type: user|ai (or 1|2), text}]}]}. Cascade
# conversations are stored encrypted and aren't readable.

_WINDSURF_KEYS = ("workbench.panel.aichat.view.aichat.chatdata", "aiChat.chatdata")


def _windsurf_index(root: Path) -> list[dict]:
    out = []
    for db_path in sorted(root.glob("workspaceStorage/*/state.vscdb")):
        rows = _sqlite_rows(db_path, "SELECT key, value FROM ItemTable WHERE key IN (?, ?)", _WINDSURF_KEYS)
        cwd = _vscode_folder(db_path.parent)
        mtime = db_path.stat().st_mtime
        for r in rows:
            data = _reader_json(r["value"])
            for tab in (data.get("tabs") if isinstance(data, dict) else None) or []:
                if isinstance(tab, dict) and tab.get("tabId") and tab.get("bubbles"):
                    out.append({"id": f"windsurf-{tab['tabId']}", "title": tab.get("chatTitle"), "cwd": cwd,
                                "updated": mtime, "weight": len(tab["bubbles"]), "_tab": tab})
    return out


def _windsurf_items(session: dict, root: Path) -> list[dict]:
    items = []
    for n, b in enumerate(session["_tab"].get("bubbles") or []):
        if not isinstance(b, dict):
            continue
        text = b.get("text") or b.get("rawText") or b.get("initText") or ""
        kind = str(b.get("type"))
        items.append({"kind": "prompt" if kind in ("1", "user") else "response", "id": n,
                      "ts": session.get("updated"), "text": text})
    return items


