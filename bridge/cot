def _load_offsets() -> dict[str, int]:
    if not TRANSCRIPT_OFFSETS.exists():
        return {}
    try:
        return json.loads(TRANSCRIPT_OFFSETS.read_text())
    except (json.JSONDecodeError, OSError):
        return {}


def _save_offsets(data: dict[str, int]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    TRANSCRIPT_OFFSETS.write_text(json.dumps(data))


class _SpoolLock:
    """Best-effort exclusive lock around spool reads/writes so concurrent hook
    processes don't interleave appends or double-drain. A no-op where fcntl is
    unavailable — duplicate replays are harmless because ingest is idempotent."""

    def __init__(self) -> None:
        self._fh = None

    def __enter__(self) -> "_SpoolLock":
        if fcntl is None:
            return self
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            self._fh = open(SPOOL_LOCK_PATH, "w")
            fcntl.flock(self._fh.fileno(), fcntl.LOCK_EX)
        except OSError:
            if self._fh is not None:
                self._fh.close()
                self._fh = None
        return self

    def __exit__(self, *exc: object) -> None:
        if self._fh is not None:
            try:
                fcntl.flock(self._fh.fileno(), fcntl.LOCK_UN)
            finally:
                self._fh.close()
                self._fh = None


_down_since: float | None = None  # this process's last unreachable send


def _mark_collector_down() -> None:
    global _down_since
    _down_since = time.time()
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        COLLECTOR_DOWN_PATH.touch()
    except OSError:
        pass


def _mark_collector_up() -> None:
    global _down_since
    _down_since = None
    try:
        COLLECTOR_DOWN_PATH.unlink()
    except OSError:
        pass


def _probe_health() -> bool:
    try:
        urllib.request.urlopen(f"{COT_ENDPOINT}/health", timeout=_PROBE_TIMEOUT_S).read()
        return True
    except urllib.error.HTTPError:
        return True  # it answered
    except (urllib.error.URLError, TimeoutError, OSError):
        return False


# Spooled events per request when the collector takes batches.
_SPOOL_POST_BATCH = 100


def _collector_accepts_batches(endpoint: str | None = None) -> bool:
    """Whether the collector advertises batched ingest. An older one rejects an
    array as malformed, and a rejected send counts as delivered, so batches
    only go to a collector that says it takes them."""
    try:
        with urllib.request.urlopen(
            f"{(endpoint or COT_ENDPOINT).rstrip('/')}/health", timeout=_PROBE_TIMEOUT_S
        ) as resp:
            body = json.loads(resp.read() or b"{}")
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        return False
    return isinstance(body, dict) and "ingest_batch" in (body.get("features") or [])


def _collector_reachable() -> bool:
    """False while a recent unreachable send says the collector is down, so a
    hung collector costs one timeout rather than one per send. After the
    backoff, a short health probe decides instead of a full send timeout."""
    now = time.time()
    if _down_since is not None and now - _down_since < _DOWN_BACKOFF_S:
        return False
    try:
        marked: float | None = COLLECTOR_DOWN_PATH.stat().st_mtime
    except OSError:
        marked = None
    if marked is None and _down_since is None:
        return True
    if marked is not None and now - marked < _DOWN_BACKOFF_S:
        return False
    if _probe_health():
        _mark_collector_up()
        return True
    _mark_collector_down()
    return False


def _send_once(url: str, payload: dict | list[dict], timeout: float, *, retry_5xx: bool = False) -> bool:
    """POST one payload. Returns True on success, False if the collector could
    not be reached (the only condition that should trigger spooling).
    ``retry_5xx`` also returns False on a server error, for a batch whose
    events would otherwise all be dropped by one busy write."""
    data = json.dumps(payload, ensure_ascii=False, default=str).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        urllib.request.urlopen(req, timeout=timeout)
        return True
    except urllib.error.HTTPError as exc:
        # The collector answered (4xx/5xx). Retrying won't help and the payload
        # is likely malformed, so don't spool — treat as delivered.
        return not (retry_5xx and exc.code >= 500)
    except (urllib.error.URLError, TimeoutError, OSError):
        _mark_collector_down()
        return False


def _url_request_target(url: str) -> str:
    parsed = urllib.parse.urlsplit(url)
    path = parsed.path
    if parsed.query:
        path = f"{path}?{parsed.query}"
    return path


# When the running `cot hook` fired. A spooled event is stamped with this rather
# than the time it reached the spool: against a hanging collector every failed
# send first waits out its timeout, and a hook can post several events.
_HOOK_CAPTURED_AT: str | None = None


def _spool_append(url: str, payload: dict) -> bool:
    """Queue an undelivered ingest event, trimming the oldest to stay under the
    byte cap."""
    path = _url_request_target(url)
    # Most hook payloads carry no timestamp, so the collector stamps arrival
    # time. Pin the capture time now or a replay lands at flush time, out of
    # order with transcript-timed events. Only spooled events get this: the live
    # path's dedup hashes the raw payload, and a fresh ts would defeat it.
    if not payload.get("timestamp"):
        captured = _HOOK_CAPTURED_AT or datetime.now(timezone.utc).isoformat()
        payload = {**payload, "timestamp": captured}
    record = json.dumps({"path": path, "payload": payload}, ensure_ascii=False, default=str)
    line = record + "\n"
    with _SpoolLock():
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            existing = b""
            if SPOOL_PATH.exists() and SPOOL_PATH.stat().st_size + len(line.encode("utf-8")) > _MAX_SPOOL_BYTES:
                existing = SPOOL_PATH.read_bytes()
                # Drop whole lines from the front until the new record fits.
                budget = _MAX_SPOOL_BYTES - len(line.encode("utf-8"))
                while len(existing) > budget:
                    nl = existing.find(b"\n")
                    if nl == -1:
                        existing = b""
                        break
                    existing = existing[nl + 1:]
                SPOOL_PATH.write_bytes(existing)
            with SPOOL_PATH.open("a", encoding="utf-8") as fh:
                fh.write(line)
            return True
        except OSError as exc:
            print(f"cot: failed to spool event: {exc}", file=sys.stderr)
            return False


def _spool_target(record: dict, endpoint: str | None = None) -> str:
    """Resolve new and legacy spool records against the current collector."""
    path = record.get("path")
    if not isinstance(path, str) or not path:
        legacy_url = record.get("url")
        if not isinstance(legacy_url, str) or not legacy_url:
            return ""
        path = _url_request_target(legacy_url)
    if not path.startswith("/v1/ingest/"):
        return ""
    return f"{(endpoint or COT_ENDPOINT).rstrip('/')}{path}"


def _spool_flush(timeout: float = 3.0, *, endpoint: str | None = None) -> bool:
    """Replay queued events in order. Stops at the first unreachable send and
    rewrites the unsent remainder. Returns True if the collector was reachable
    (spool empty or fully/partially drained), False if it is still down."""
    with _SpoolLock():
        try:
            if not SPOOL_PATH.exists():
                return True
            raw = SPOOL_PATH.read_text(encoding="utf-8")
        except OSError:
            return True
        lines = [ln for ln in raw.splitlines() if ln.strip()]
        if not lines:
            try:
                SPOOL_PATH.unlink()
            except OSError:
                pass
            return True
        reachable = True
        limit = min(len(lines), _SPOOL_FLUSH_BATCH)
        # Consecutive events for the same endpoint go as one request (one write
        # transaction on the collector) when it takes batches; order is kept.
        per_post = _SPOOL_POST_BATCH if limit > 1 and _collector_accepts_batches(endpoint) else 1
        i = 0
        while i < limit:
            group: list[dict] = []
            target = ""
            j = i
            while j < limit and len(group) < per_post:
                try:
                    rec = json.loads(lines[j])
                except json.JSONDecodeError:
                    j += 1  # skip a corrupt line rather than wedge the queue
                    continue
                rec_target = _spool_target(rec, endpoint)
                if not rec_target:
                    j += 1
                    continue
                if target and rec_target != target:
                    break
                target = rec_target
                group.append(rec.get("payload", {}))
                j += 1
            if group and not _send_once(target, group if per_post > 1 else group[0], timeout):
                reachable = False
                break
            i = j
        remaining = lines[i:]
        try:
            if remaining:
                SPOOL_PATH.write_text("\n".join(remaining) + "\n", encoding="utf-8")
            else:
                SPOOL_PATH.unlink()
        except OSError:
            pass
        return reachable


def _post(url: str, payload: dict) -> None:
    is_ingest = "/v1/ingest/" in url
    if is_ingest:
        if "/v1/ingest/opencode" in url or "/v1/ingest/hermes" in url:
            # The plugin bounds subprocess lifetime. Persist before HTTP work
            # so a timeout during queue replay cannot lose the new event.
            if not _spool_append(url, payload):
                raise OSError("Unable to persist plugin hook event")
            if _collector_reachable():
                _spool_flush(endpoint=url.split("/v1/ingest/", 1)[0])
            return
        if not _collector_reachable():
            _spool_append(url, payload)
            return
        # Drain anything queued from a prior outage first so events stay ordered,
        # and skip the live attempt entirely if the collector is still down.
        if SPOOL_PATH.exists() and not _spool_flush():
            _spool_append(url, payload)
            return
        if _send_once(url, payload, timeout=3):
            return
        _spool_append(url, payload)
        return
    if not _collector_reachable() or not _send_once(url, payload, timeout=3):
        print(f"cot: failed to post event: {url}", file=sys.stderr)


def _post_async(url: str, payload: dict) -> None:
    """Fire-and-forget — only for non-critical follow-up posts."""
    def _send() -> None:
        _post(url, payload)

    threading.Thread(target=_send, daemon=True).start()


# Imported events per request when the collector takes batches. Each request is
# one write transaction, so this also bounds how long an import holds the write
# lock that live hooks wait on.
_IMPORT_POST_BATCH = 200
# Batches queued for the poster's sender thread before parsing waits on it.
_IMPORT_SEND_QUEUE = 2

# Set by a collector that runs the import in its own process: called with
# (url, body) instead of POSTing, where body is one payload or a list of them.
_INGEST_SINK = None
# Set alongside it: called with (agent, files_done, files_total, bytes_done,
