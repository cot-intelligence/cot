def _reader_tool_input(canonical: str, value: object) -> dict:
    data = _reader_json(value)
    if not isinstance(data, dict):
        return {"input": data} if data not in (None, "") else {}
    out = dict(data)
    for theirs, ours in _READER_INPUT_KEYS.items():
        if theirs in data and ours not in out:
            # ``query`` stays put for searches; ``path`` is a folder for them.
            if canonical in ("Grep", "Glob", "Search") and theirs == "path":
                continue
            out[ours] = data[theirs]
    if canonical == "Bash" and isinstance(out.get("command"), list):
        out["command"] = " ".join(str(c) for c in out["command"])
    return out


def _reader_tool(reader: _Reader, name: object, value: object) -> tuple[str, dict]:
    raw = str(name or "tool")
    if raw.startswith("mcp-") and raw not in reader.tools:
        return "MCP:" + raw[4:], _reader_tool_input("MCP", value)  # Cursor's "mcp-<server>-<tool>"
    # MCP tools keep their name: ``server__tool`` / ``mcp_server_tool``.
    canonical = reader.tools.get(raw) or _READER_TOOLS.get(raw) or _READER_TOOLS.get(raw.lower()) or raw
    return canonical, _reader_tool_input(canonical, value)


def _reader_totals(items: list[dict], before: dict) -> list[dict]:
    """Running totals as usage for the tokens added since ``before`` (what the
    last pass saw, per model), which is updated in place. Each delta is keyed by
    the total it reaches, so a pass over an unchanged session adds nothing."""
    out = []
    for item in items:
        if item.get("kind") != "total":
            out.append(item)
            continue
        model = str(item.get("model") or "")
        now = {k: int(v) for k, v in (item.get("usage") or {}).items() if isinstance(v, (int, float))}
        seen = before.get(model) or {}
        delta = {k: v - int(seen.get(k) or 0) for k, v in now.items()}
        if any(v < 0 for v in delta.values()):
            delta = now  # the store was reset or rewritten
        if any(delta.values()):
            out.append({**item, "kind": "usage", "id": f"total:{model}:{sum(now.values())}", "usage": delta})
        before[model] = now
    return out


def _reader_payloads(reader: _Reader, session: dict, items: list[dict]) -> list[dict]:
    """Hook-shaped payloads for one session, oldest first, each with a dedup
    key so a later pass over a grown session only adds what's new."""
    sid = str(session["id"])
    cwd = session.get("cwd")
    start_ts = _reader_ts(session.get("started")) or next(
        (t for t in (_reader_ts(i.get("ts")) for i in items) if t), None) or _reader_ts(session.get("updated"))
    out: list[dict] = []

    def add(hook: str, ts: object, key: str, **fields) -> None:
        out.append({
            "session_id": sid, "hook_event_name": hook, "origin": "import", "_import": True,
            "_reader": reader.id, "cwd": cwd, "timestamp": _reader_ts(ts) or start_ts,
            "_dedup_key": f"{reader.id}:{sid}:{key}",
            **{k: v for k, v in fields.items() if v is not None},
        })

    add("SessionStart", start_ts, "session", session_title=session.get("title"),
        parent_session_id=session.get("parent_id"), model=session.get("model"))
    for n, item in enumerate(items):
        kind = item.get("kind")
        key = str(item.get("id") or n)
        ts = item.get("ts")
        text = item.get("text")
        if kind == "prompt" and isinstance(text, str) and text.strip():
            add("UserPromptSubmit", ts, f"prompt:{key}", prompt=text, model=item.get("model"))
        elif kind == "thought" and isinstance(text, str) and text.strip():
            add("afterAgentThought", ts, f"thought:{key}", thought=text)
        elif kind == "response" and isinstance(text, str) and text.strip():
            add("afterAgentResponse", ts, f"response:{key}", response=text, model=item.get("model"))
        elif kind == "tool":
            tool, tool_input = _reader_tool(reader, item.get("name"), item.get("input"))
            raw_name = str(item.get("name") or "")
            extra = {"raw_tool_name": raw_name} if raw_name and raw_name != tool else {}
            add("PreToolUse", ts, f"tool:start:{key}", tool_name=tool, tool_input=tool_input,
                tool_use_id=key, **extra)
            if "output" in item or item.get("failed") is not None:
                add("PostToolUseFailure" if item.get("failed") else "PostToolUse", item.get("end_ts") or ts,
                    f"tool:end:{key}", tool_name=tool, tool_input=tool_input,
                    tool_response=item.get("output"), tool_use_id=key, **extra)
        elif kind == "usage" and isinstance(item.get("usage"), dict):
            usage = {k: int(v) for k, v in item["usage"].items() if isinstance(v, (int, float)) and v}
            if usage:
                add("ModelUsage", ts, f"usage:{key}", model=item.get("model"), usage=usage)
        elif kind == "end":
            add("SessionEnd", ts, "session:end", reason=item.get("reason"))
    if not any(p["hook_event_name"] in ("UserPromptSubmit", "afterAgentResponse", "PreToolUse") for p in out):
        return []  # opened and never used
    if session.get("ended") and not any(p["hook_event_name"] == "SessionEnd" for p in out):
        add("SessionEnd", session.get("updated"), "session:end")
    return out


def _session_payloads(reader: _Reader, session: dict, totals: dict | None = None) -> list[dict]:
    """``totals`` is the running token totals the last pass saw for this
    session, per model; it's updated in place."""
    root = session.get("_root") or reader.root()
    if reader.payloads is not None:
        return reader.payloads(session, root)
    try:
        items = reader.items(session, root) if reader.items else []
    except Exception as exc:  # noqa: BLE001 - one unreadable session shouldn't stop the pass
        print(f"cot import: {reader.id} {session.get('id')}: {exc}", file=sys.stderr)
        return []
    return _reader_payloads(reader, session, _reader_totals(items, totals if totals is not None else {}))


def _import_store(reader: _Reader, offsets: dict[str, int], origins: dict[str, str], *,
                  verbose: bool = True, skip_active_s: float = 0,
                  held_back: list[str] | None = None, since: str | None = None) -> int:
    """Import a session store's sessions changed since the last pass. ``offsets``
    holds each session's ``reader.mark`` from when it was last imported."""
    if not reader.roots():
        if verbose:
            print(f"cot import: no {reader.id} data found", file=sys.stderr)
        return 0
    sessions = reader.sessions()
    # ``origins`` was read when the whole import began; a session a hook
    # started capturing since then must not be imported over its live events.
    if reader.hooks or reader.otel or reader.skip_known:
        origins = {**origins, **_fetch_session_origins()}
    cutoff = _reader_epoch(since) if since else 0
    progress = _PROGRESS_SINK is not None or bool(os.environ.get("COT_IMPORT_PROGRESS"))
    weights = [max(1, int(s.get("weight") or 0)) for s in sessions]
    total_w = sum(weights)
    now = time.time()
    posted = 0
    poster = _ImportPoster(f"{COT_ENDPOINT}/v1/ingest/{reader.id}")
    for done, s in enumerate(sessions):
        if progress:
            _import_progress(reader.id, done, len(sessions), sum(weights[:done]), total_w)
        key = f"{reader.id}:{s['id']}"
        mark = reader.mark(s)
        if origins.get(str(s["id"])) == "hook" or offsets.get(key) == mark:
            continue
        if reader.skip_known and str(s["id"]) in origins and key not in offsets:
            offsets[key] = mark  # another reader brought this one in; leave it be
            continue
        updated = s.get("updated") or 0
        if cutoff and updated and updated < cutoff:
            continue
        if skip_active_s and not s.get("ended") and updated and now - updated < skip_active_s:
            if held_back is not None:
                held_back.append(key)
            continue
        totals_key = f"{key}#totals"
        totals = offsets.get(totals_key)
        totals = dict(totals) if isinstance(totals, dict) else {}
        payloads = _session_payloads(reader, s, totals)
        if totals:
            offsets[totals_key] = totals
        if verbose:
            print(f"cot import: {reader.id} {s['id']} ({len(payloads)} events)")
        for payload in payloads:
            poster.add(payload)
            posted += 1
        offsets[key] = mark
    poster.flush()
    if progress:
        _import_progress(reader.id, len(sessions), len(sessions), total_w, total_w)
    return posted


