def _mcp_result(req_id: object, result: dict) -> dict:
    return {"jsonrpc": "2.0", "id": req_id, "result": result}


def _mcp_error(req_id: object, code: int, message: str) -> dict:
    return {"jsonrpc": "2.0", "id": req_id, "error": {"code": code, "message": message}}


def _mcp_call_tool(params: dict) -> dict:
    name = params.get("name")
    entry = _MCP_TOOLS.get(str(name))
    if entry is None:
        return {"content": [{"type": "text", "text": f"Unknown tool: {name}"}], "isError": True}
    args = params.get("arguments") if isinstance(params.get("arguments"), dict) else {}
    try:
        data = entry[1](args)
    except urllib.error.HTTPError as exc:
        msg = "not found" if exc.code == 404 else f"collector returned HTTP {exc.code}"
        return {"content": [{"type": "text", "text": f"cot: {msg}"}], "isError": True}
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        text = f"cot: the collector at {COT_ENDPOINT} is not reachable ({exc}). Start it with `cot up` or open the cot app."
        return {"content": [{"type": "text", "text": text}], "isError": True}
    except ValueError as exc:
        return {"content": [{"type": "text", "text": f"cot: {exc}"}], "isError": True}
    return {"content": [{"type": "text", "text": json.dumps(data, ensure_ascii=False, default=str)}]}


def _mcp_handle(msg: object) -> dict | None:
    """One JSON-RPC message in, its response out (None for notifications)."""
    if not isinstance(msg, dict) or msg.get("jsonrpc") != "2.0":
        return _mcp_error(None, -32600, "Invalid request")
    method = msg.get("method")
    req_id = msg.get("id")
    params = msg.get("params") if isinstance(msg.get("params"), dict) else {}
    if req_id is None:
        return None  # notifications (initialized, cancelled) need no answer
    if method == "initialize":
        asked = params.get("protocolVersion")
        return _mcp_result(req_id, {
            "protocolVersion": asked if asked in _MCP_PROTOCOLS else _MCP_PROTOCOLS[0],
            "capabilities": {"tools": {"listChanged": False}},
            "serverInfo": {"name": "cot", "title": "cot", "version": _MCP_SERVER_VERSION},
            "instructions": "Read-only access to the coding-agent sessions cot recorded on this machine. Start with list_sessions or search, then get_session or explain_session_cost on an id.",
        })
    if method == "ping":
        return _mcp_result(req_id, {})
    if method == "tools/list":
        tools = [
            {"name": name, **spec, "annotations": {"readOnlyHint": True, "openWorldHint": False}}
            for name, (spec, _fn) in _MCP_TOOLS.items()
        ]
        return _mcp_result(req_id, {"tools": tools})
    if method == "tools/call":
        return _mcp_result(req_id, _mcp_call_tool(params))
    return _mcp_error(req_id, -32601, f"Method not found: {method}")


def _cmd_mcp(args: list[str]) -> int:
    """Serve MCP over stdio until stdin closes."""
    if args and args[0] in ("-h", "--help"):
        print("Usage: cot mcp    (an MCP server over stdio; register it with your agent)\n"
              "  Claude Code:  claude mcp add cot -- ~/.cot/bin/cot mcp\n"
              "  Codex:        codex mcp add cot -- ~/.cot/bin/cot mcp\n"
              f'  Cursor:       add {{"cot": {{"command": "{BRIDGE_PATH}", "args": ["mcp"]}}}} to mcpServers in ~/.cursor/mcp.json')
        return 0
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            out: object = _mcp_error(None, -32700, "Parse error")
        else:
            if isinstance(msg, list):
                out = [r for r in (_mcp_handle(m) for m in msg) if r is not None] or None
            else:
                out = _mcp_handle(msg)
        if out is not None:
            sys.stdout.write(json.dumps(out, ensure_ascii=False) + "\n")
            sys.stdout.flush()
    return 0


def _cmd_statusline(args: list[str]) -> int:
    """One line for a shell prompt or an agent status line: session and today's spend.

    Claude Code pipes a JSON status object on stdin; its ``session_id`` picks the
    session. Prints a short offline note instead of failing, since a status line
    runs on every redraw.
    """
    as_json = "--json" in args
    session_id = None
    for i, a in enumerate(args):
        if a == "--session" and i + 1 < len(args):
            session_id = args[i + 1]
    if session_id is None and not sys.stdin.isatty():
        try:
            body = json.loads(sys.stdin.read() or "{}")
            session_id = body.get("session_id") if isinstance(body, dict) else None
        except (json.JSONDecodeError, OSError):
            session_id = None
    query = urllib.parse.urlencode({k: v for k, v in (("session_id", session_id), ("tz", _local_tz_name())) if v})
    try:
        with urllib.request.urlopen(f"{COT_ENDPOINT}/v1/statusline?{query}", timeout=1) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        print(json.dumps({"line": "cot · offline"}) if as_json else "cot · offline")
        return 0
    print(json.dumps(data) if as_json else data.get("line", "cot"))
    return 0


def _local_tz_name() -> str | None:
    tz = os.environ.get("TZ")
    if tz:
        return tz
    try:
        link = os.readlink("/etc/localtime")
    except OSError:
        return None
    return link.split("zoneinfo/", 1)[1] if "zoneinfo/" in link else None


def _capture_parse(agent: str, stdout: str) -> dict:
    """Usage and the final answer from a `claude -p --output-format json|stream-json`
    or `codex exec --json` run's stdout."""
    out: dict = {"session_id": None, "model": None, "cost_usd": None, "turns": None, "result": None,
                 "usage": {"input_tokens": 0, "output_tokens": 0, "cache_read_tokens": 0, "cache_write_tokens": 0}}
    usage = out["usage"]
    docs: list = []
    text = stdout.strip()
    try:
        whole = json.loads(text) if text.startswith("{") or text.startswith("[") else None
    except json.JSONDecodeError:
        whole = None
    if isinstance(whole, list):
        docs = whole
    elif isinstance(whole, dict):
        docs = [whole]
    else:
        for line in text.splitlines():
            try:
                docs.append(json.loads(line))
            except json.JSONDecodeError:
                continue
    for d in docs:
        if not isinstance(d, dict):
            continue
        if agent == "claude":
            if d.get("type") == "system" and d.get("model"):
                out["model"] = d.get("model")
            if d.get("type") == "result":
                u = d.get("usage") or {}
                usage["input_tokens"] = int(u.get("input_tokens") or 0)
                usage["output_tokens"] = int(u.get("output_tokens") or 0)
                usage["cache_read_tokens"] = int(u.get("cache_read_input_tokens") or 0)
                usage["cache_write_tokens"] = int(u.get("cache_creation_input_tokens") or 0)
                out["cost_usd"] = d.get("total_cost_usd")
                out["turns"] = d.get("num_turns")
                out["session_id"] = d.get("session_id") or out["session_id"]
                out["result"] = d.get("result")
                models = d.get("modelUsage") or {}
                if models and not out["model"]:
                    out["model"] = max(models, key=lambda m: (models[m] or {}).get("outputTokens", 0))
        else:
            kind = d.get("type")
            if kind == "thread.started":
                out["session_id"] = d.get("thread_id")
            elif kind == "turn.completed":
                u = d.get("usage") or {}
                usage["input_tokens"] += int(u.get("input_tokens") or 0)
                usage["output_tokens"] += int(u.get("output_tokens") or 0)
                usage["cache_read_tokens"] += int(u.get("cached_input_tokens") or 0)
                out["turns"] = (out["turns"] or 0) + 1
            elif kind == "item.completed" and (d.get("item") or {}).get("type") == "agent_message":
                out["result"] = d["item"].get("text")
    return out


def _cmd_capture(args: list[str]) -> int:
    """Run one non-interactive agent call and save what it used, no collector needed.

    ``cot capture [--out FILE] -- claude -p "…"`` (or ``codex exec "…"``). JSON
    output is switched on when the command doesn't ask for it, and the agent's
    answer still goes to stdout. The result lands in FILE (default
    ``cot-capture.json``) and, on GitHub Actions, as a line in the job summary.
    """
    if "--" not in args:
        print("Usage: cot capture [--out FILE] -- claude -p \"…\" | codex exec \"…\"", file=sys.stderr)
        return 2
    split = args.index("--")
    opts, cmd = args[:split], args[split + 1:]
    out_path = os.environ.get("COT_CAPTURE_OUT") or "cot-capture.json"
    for i, a in enumerate(opts):
        if a == "--out" and i + 1 < len(opts):
            out_path = opts[i + 1]
    if not cmd:
        print("cot capture: no command after --", file=sys.stderr)
        return 2
    prog = os.path.basename(cmd[0])
    agent = "claude" if prog == "claude" else "codex" if prog == "codex" else None
    if agent is None:
        print("cot capture: only `claude -p` and `codex exec` runs can be captured", file=sys.stderr)
        return 2
    run = list(cmd)
    passthrough = False
    if agent == "claude" and "--output-format" not in run:
        run += ["--output-format", "json"]
    elif agent == "claude":
        passthrough = True
    if agent == "codex" and "--json" not in run:
        run.insert(2 if len(run) > 1 and run[1] == "exec" else 1, "--json")
    elif agent == "codex":
        passthrough = True
    import subprocess
    started = datetime.now(timezone.utc)
    t0 = time.monotonic()
    try:
        proc = subprocess.run(run, stdout=subprocess.PIPE, text=True, check=False)
    except OSError as exc:
        print(f"cot capture: could not run {cmd[0]}: {exc}", file=sys.stderr)
        return 127
    parsed = _capture_parse(agent, proc.stdout or "")
    if passthrough:
        sys.stdout.write(proc.stdout or "")
    elif parsed["result"]:
        print(parsed["result"])
    record = {
        "agent": agent,
        "started_at": started.isoformat().replace("+00:00", "Z"),
        "duration_ms": int((time.monotonic() - t0) * 1000),
        "exit_code": proc.returncode,
        **{k: v for k, v in parsed.items() if k != "result"},
        "ci": {k.lower(): os.environ[k] for k in ("GITHUB_REPOSITORY", "GITHUB_RUN_ID", "GITHUB_SHA", "GITHUB_REF_NAME", "CI_PIPELINE_ID", "CI_COMMIT_SHA") if os.environ.get(k)},
    }
    try:
        Path(out_path).write_text(json.dumps(record, indent=2) + "\n")
    except OSError as exc:
        print(f"cot capture: could not write {out_path}: {exc}", file=sys.stderr)
    u = record["usage"]
    cost = f"${record['cost_usd']:.4f}" if isinstance(record["cost_usd"], (int, float)) else "cost n/a"
    summary = (f"cot capture · {agent} · {cost} · in {u['input_tokens']:,} · out {u['output_tokens']:,}"
               f" · cache read {u['cache_read_tokens']:,} · {record['duration_ms'] / 1000:.1f}s")
    print(summary, file=sys.stderr)
    step = os.environ.get("GITHUB_STEP_SUMMARY")
    if step:
        try:
            with open(step, "a") as fh:
                fh.write(f"- {summary}\n")
        except OSError:
            pass
    return proc.returncode


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == "install":
        return _cmd_install(sys.argv[2:])
    if len(sys.argv) >= 2 and sys.argv[1] == "status":
