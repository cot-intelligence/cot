                                           for c in t.get("tool_calls") or [] if isinstance(c, dict)],
                            "timestamp": e.get("timestamp"), "usage": e.get("usage")})
        elif isinstance(m.get("tool"), dict):
            t = m["tool"]
            out = t.get("output") if isinstance(t.get("output"), dict) else {}
            values = out.get("values") if isinstance(out.get("values"), list) else []
            records.append({"role": "tool", "tool_call_id": t.get("call_id"),
                            "content": "\n".join(str(_first(v, "text", "Text") or v) for v in values),
                            "is_error": bool(out.get("is_error"))})
    session["_id_set"] = True
    return _chat_items(records, session)


