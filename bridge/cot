# ------------------------------------------------------------------- Goose
# Goose keeps sessions in sessions/sessions.db: ``sessions`` (working_dir,
# model_config_json, accumulated token totals) and ``messages`` (role,
# content_json: text / thinking / toolRequest / toolResponse blocks).
# Releases before the database wrote one <id>.jsonl per session, a metadata
# line then one message per line, with the same blocks.

def _goose_index(root: Path) -> list[dict]:
    db_path = root / "sessions.db"
    out = []
    for r in _sqlite_rows(db_path, "SELECT * FROM sessions"):
        cfg = _reader_json(r.get("model_config_json"))
        out.append({"id": str(r["id"]), "title": r.get("name") or r.get("description"),
                    "cwd": r.get("working_dir"), "started": r.get("created_at"),
                    "updated": _reader_epoch(r.get("updated_at")) or _reader_epoch(r.get("created_at")),
                    "parent_id": r.get("parent_session_id"),
                    "model": cfg.get("model_name") if isinstance(cfg, dict) else None,
                    "_db": db_path, "_row": r})
    for path in sorted(root.glob("*.jsonl")):
        s = _file_session(path)
        if s and not any(x["id"] == s["id"] for x in out):
            out.append(s)
    return out


def _goose_blocks(items: list[dict], tools: dict, mid: object, role: str, ts: object,
                  blocks: object, model: str | None) -> None:
    text: list[str] = []
    for i, b in enumerate(blocks if isinstance(blocks, list) else []):
        if not isinstance(b, dict):
            continue
        kind = b.get("type")
        if kind == "text" and isinstance(b.get("text"), str):
            text.append(b["text"])
        elif kind == "thinking" and b.get("thinking"):
            items.append({"kind": "thought", "id": f"{mid}:{i}", "ts": ts, "text": b["thinking"]})
        elif kind in ("toolRequest", "frontendToolRequest"):
            call = b.get("toolCall") if isinstance(b.get("toolCall"), dict) else {}
            value = call.get("value") if isinstance(call.get("value"), dict) else {}
            tid = b.get("id") or f"{mid}:{i}"
            tools[tid] = {"kind": "tool", "id": tid, "ts": ts, "name": value.get("name"), "input": value.get("arguments")}
            items.append(tools[tid])
        elif kind == "toolResponse":
            res = b.get("toolResult") if isinstance(b.get("toolResult"), dict) else {}
            call = tools.get(b.get("id"))
            if call is not None:
                value = res.get("value")
                output = value.get("content", value) if isinstance(value, dict) else value
                call.update(end_ts=ts, failed=res.get("status") == "error",
                            output=res.get("error") if res.get("status") == "error" else _reader_text(output) or output)
    if role == "user" and text:
        items.append({"kind": "prompt", "id": mid, "ts": ts, "text": "\n".join(text)})
    elif role == "assistant" and text:
        items.append({"kind": "response", "id": mid, "ts": ts, "text": "\n".join(text), "model": model})


def _goose_items(session: dict, root: Path) -> list[dict]:
    items: list[dict] = []
    tools: dict = {}
    model = session.get("model")
    if "_path" in session:
        for n, m in enumerate(_read_jsonl_file(session["_path"])):
            if n == 0 and "role" not in m:
                session["cwd"] = m.get("working_dir")
                session["title"] = m.get("description")
                continue
            _goose_blocks(items, tools, m.get("id") or n, m.get("role") or "", m.get("created"), m.get("content"), model)
        return items
    for m in _sqlite_rows(session["_db"], "SELECT * FROM messages WHERE session_id = ? ORDER BY created_timestamp, id",
                          (session["id"],)):
        _goose_blocks(items, tools, m.get("message_id") or m.get("id"), m.get("role") or "",
                      m.get("created_timestamp") or m.get("timestamp"), _reader_json(m.get("content_json")), model)
    row = session["_row"]
    if row.get("accumulated_input_tokens") or row.get("accumulated_output_tokens"):
        read, write = int(row.get("accumulated_cache_read_tokens") or 0), int(row.get("accumulated_cache_write_tokens") or 0)
        items.append({"kind": "total", "ts": session.get("updated"), "model": model, "usage": {
            "input_tokens": max(0, int(row.get("accumulated_input_tokens") or 0) - read - write),
            "output_tokens": int(row.get("accumulated_output_tokens") or 0),
            "cache_read_tokens": read, "cache_write_tokens": write}})
    return items


_register(_Reader("goose", "Goose", (".local/share/goose/sessions", "AppData/Roaming/Block/goose/data/sessions"),
                  env="COT_GOOSE_HOME", index=_goose_index, items=_goose_items,
                  # The usage row is a running total, so a session is re-read when it grows.
                  mark=lambda s: f"{s.get('updated')}:{(s.get('_row') or {}).get('accumulated_total_tokens') or 0}"))


# ------------------------------------------------------------------- Crush
# ~/.local/share/crush/projects.json lists each project and its data folder
# (``<project>/.crush``), which holds crush.db: ``sessions`` (title, parent,
# prompt/completion token totals, cost) and ``messages`` (role, model, parts:
# text / reasoning / tool_call / tool_result / finish, each {type, data}).

def _crush_index(root: Path) -> list[dict]:
    registry = _read_json_doc(root / "projects.json")
    projects = registry.get("projects") if isinstance(registry, dict) else None
    out = []
    for proj in projects if isinstance(projects, list) else []:
        if not isinstance(proj, dict) or not proj.get("path"):
            continue
        data_dir = Path(proj.get("data_dir") or Path(proj["path"]) / ".crush")
        if not data_dir.is_absolute():
            data_dir = Path(proj["path"]) / data_dir
        db_path = data_dir / "crush.db"
        if not _safe_transcript_root(db_path):
            continue
        for r in _sqlite_rows(db_path, "SELECT s.*, (SELECT MAX(m.created_at) FROM messages m"
                                       " WHERE m.session_id = s.id) AS last_message FROM sessions s"):
            out.append({"id": str(r["id"]), "title": r.get("title"), "cwd": proj["path"],
                        "parent_id": r.get("parent_session_id") or None, "started": r.get("created_at"),
                        "updated": _reader_epoch(r.get("last_message") or r.get("updated_at")),
                        "weight": r.get("message_count"), "_db": db_path, "_row": r})
    return out


def _crush_items(session: dict, root: Path) -> list[dict]:
    items: list[dict] = []
    tools: dict = {}
    model = None
    for m in _sqlite_rows(session["_db"], "SELECT * FROM messages WHERE session_id = ? ORDER BY created_at, rowid",
                          (session["id"],)):
        role, ts, mid = m.get("role"), m.get("created_at"), m.get("id")
        model = m.get("model") or model
        text: list[str] = []
        parts = _reader_json(m.get("parts"))
        for i, part in enumerate(parts if isinstance(parts, list) else []):
            data = part.get("data") if isinstance(part, dict) and isinstance(part.get("data"), dict) else {}
            kind = part.get("type") if isinstance(part, dict) else None
            if kind == "text" and data.get("text"):
                text.append(data["text"])
            elif kind == "reasoning" and data.get("thinking"):
                items.append({"kind": "thought", "id": f"{mid}:{i}", "ts": ts, "text": data["thinking"]})
            elif kind == "tool_call" and data.get("name"):
                tid = data.get("id") or f"{mid}:{i}"
                tools[tid] = {"kind": "tool", "id": tid, "ts": ts, "name": data["name"], "input": data.get("input")}
                items.append(tools[tid])
            elif kind == "tool_result":
                call = tools.get(data.get("tool_call_id"))
                if call is not None:
                    call.update(output=data.get("content"), end_ts=ts, failed=bool(data.get("is_error")))
        if role == "user" and text:
            items.append({"kind": "prompt", "id": mid, "ts": ts, "text": "\n".join(text)})
        elif role == "assistant" and text:
            items.append({"kind": "response", "id": mid, "ts": ts, "text": "\n".join(text), "model": model})
    row = session["_row"]
    if row.get("prompt_tokens") or row.get("completion_tokens"):
        items.append({"kind": "total", "ts": session.get("updated"), "model": model, "usage": {
            "input_tokens": int(row.get("prompt_tokens") or 0), "output_tokens": int(row.get("completion_tokens") or 0)}})
    return items


_register(_Reader("crush", "Crush", (".local/share/crush", "AppData/Local/crush"), env="CRUSH_DIR",
                  index=_crush_index, items=_crush_items,
                  mark=lambda s: f"{s.get('updated')}:{s.get('weight')}:{(s.get('_row') or {}).get('completion_tokens')}"))


def _anthropic_blocks(items: list[dict], tools: dict, mid: object, role: str, ts: object,
                      content: object, model: str | None = None) -> None:
    """Items from one message of Anthropic-style content blocks (text,
    thinking, tool_use, tool_result), the shape several agents store."""
    if isinstance(content, str):
        content = [{"type": "text", "text": content}]
    text: list[str] = []
    for i, b in enumerate(content if isinstance(content, list) else []):
        if not isinstance(b, dict):
            continue
        kind = b.get("type")
        if kind == "text" and isinstance(b.get("text"), str):
            text.append(b["text"])
        elif kind in ("thinking", "reasoning") and (b.get("thinking") or b.get("text")):
            items.append({"kind": "thought", "id": f"{mid}:{i}", "ts": ts, "text": b.get("thinking") or b.get("text")})
        elif kind == "tool_use":
            tid = b.get("id") or f"{mid}:{i}"
            tools[tid] = {"kind": "tool", "id": tid, "ts": ts, "name": b.get("name"), "input": b.get("input")}
            items.append(tools[tid])
        elif kind == "tool_result":
            call = tools.get(b.get("tool_use_id"))
            if call is not None:
                call.update(output=_reader_text(b.get("content")) or b.get("content"), end_ts=ts,
                            failed=bool(b.get("is_error")))
    if not text:
        return
    if role == "user":
        items.append({"kind": "prompt", "id": mid, "ts": ts, "text": "\n".join(text)})
    elif role == "assistant":
        items.append({"kind": "response", "id": mid, "ts": ts, "text": "\n".join(text), "model": model})


# --------------------------------------------------------------- Qwen Code
# ~/.qwen/projects/<encoded cwd>/chats/<id>.jsonl, one record per line:
# {sessionId, cwd, timestamp, type: user|assistant|system|tool_result,
#  message: {role, parts: [text | thought | functionCall | functionResponse]},
#  model, usageMetadata}. A Gemini CLI fork, with Gemini API parts.

def _qwen_index(root: Path) -> list[dict]:
    return [s for s in (_file_session(p) for p in sorted(root.glob("projects/*/chats/*.jsonl"))) if s]


def _qwen_items(session: dict, root: Path) -> list[dict]:
    items: list[dict] = []
    tools: dict = {}
    for n, rec in enumerate(_read_jsonl_file(session["_path"])):
        session["id"] = rec.get("sessionId") or session["id"]
        session["cwd"] = session.get("cwd") or rec.get("cwd")
        ts, mid, kind = rec.get("timestamp"), rec.get("uuid") or rec.get("id") or n, rec.get("type")
        if kind == "system" and rec.get("subtype") == "custom_title":
            session["title"] = (rec.get("systemPayload") or {}).get("customTitle")
            continue
        msg = rec.get("message") if isinstance(rec.get("message"), dict) else {}
        text: list[str] = []
        model = rec.get("model")
        for i, part in enumerate(msg.get("parts") or []):
            if not isinstance(part, dict):
                continue
            if isinstance(part.get("text"), str):
                if part.get("thought"):
                    items.append({"kind": "thought", "id": f"{mid}:{i}", "ts": ts, "text": part["text"]})
                else:
                    text.append(part["text"])
            fc = part.get("functionCall")
            if isinstance(fc, dict):
                tid = fc.get("id") or f"{mid}:{i}"
                tools[tid] = {"kind": "tool", "id": tid, "ts": ts, "name": fc.get("name"), "input": fc.get("args")}
                items.append(tools[tid])
            fr = part.get("functionResponse")
            if isinstance(fr, dict) and tools.get(fr.get("id")) is not None:
                resp = fr.get("response")
                out = resp.get("output", resp.get("error", resp)) if isinstance(resp, dict) else resp
                tools[fr["id"]].update(output=out, end_ts=ts,
                                       failed=isinstance(resp, dict) and resp.get("error") is not None)
        if kind == "user" and msg.get("role") == "user" and text:
            items.append({"kind": "prompt", "id": mid, "ts": ts, "text": "\n".join(text)})
        elif kind == "assistant" and text:
            items.append({"kind": "response", "id": mid, "ts": ts, "text": "\n".join(text), "model": model})
        u = rec.get("usageMetadata")
        if kind == "assistant" and isinstance(u, dict):
            cached = int(u.get("cachedContentTokenCount") or 0)
            items.append({"kind": "usage", "id": mid, "ts": ts, "model": model, "usage": {
                "input_tokens": max(0, int(u.get("promptTokenCount") or 0) - cached),
                "output_tokens": int(u.get("candidatesTokenCount") or 0) + int(u.get("thoughtsTokenCount") or 0),
                "cache_read_tokens": cached, "reasoning_tokens": int(u.get("thoughtsTokenCount") or 0)}})
    return items


_register(_Reader("qwen-code", "Qwen Code", (".qwen",), env="QWEN_DIR", index=_qwen_index, items=_qwen_items))


# --------------------------------------------------------------- Cline CLI
# ~/.cline/data/sessions/<id>/<id>.json (cwd, model, status, usage totals)
# and <id>.messages.json ({messages: [{id, role, ts, content: blocks,
# modelInfo, metrics}]}, Anthropic-style blocks).

def _cline_cli_index(root: Path) -> list[dict]:
    out = []
    for meta_path in sorted(root.glob("data/sessions/*/*.json")):
        sid = meta_path.parent.name
        if meta_path.name != f"{sid}.json":
            continue
        msgs = meta_path.with_name(f"{sid}.messages.json")
        s = _file_session(msgs if msgs.exists() else meta_path, sid)
        if s:
            s["_meta"] = meta_path
            out.append(s)
    return out


def _cline_cli_items(session: dict, root: Path) -> list[dict]:
    meta = _read_json_doc(session["_meta"])
    meta = meta if isinstance(meta, dict) else {}
    session.update(cwd=meta.get("cwd") or meta.get("workspace_root"), started=meta.get("started_at"),
                   model=meta.get("model"), ended=bool(meta.get("ended_at")),
                   title=(meta.get("metadata") or {}).get("title") if isinstance(meta.get("metadata"), dict) else None)
    doc = _read_json_doc(session["_path"]) if session["_path"].name.endswith(".messages.json") else None
    items: list[dict] = []
    tools: dict = {}
    for n, m in enumerate((doc or {}).get("messages") or [] if isinstance(doc, dict) else []):
        if not isinstance(m, dict):
            continue
        info = m.get("modelInfo") if isinstance(m.get("modelInfo"), dict) else {}
        model = info.get("id") or session.get("model")
        _anthropic_blocks(items, tools, m.get("id") or n, m.get("role") or "", m.get("ts"), m.get("content"), model)
        metrics = m.get("metrics") if isinstance(m.get("metrics"), dict) else None
        if metrics and m.get("role") == "assistant":
            items.append({"kind": "usage", "id": m.get("id") or n, "ts": m.get("ts"), "model": model, "usage": {
                "input_tokens": int(metrics.get("inputTokens") or 0), "output_tokens": int(metrics.get("outputTokens") or 0),
                "cache_read_tokens": int(metrics.get("cacheReadTokens") or 0),
                "cache_write_tokens": int(metrics.get("cacheWriteTokens") or 0)}})
    if not items and meta.get("prompt"):
        items.append({"kind": "prompt", "id": "prompt", "ts": meta.get("started_at"), "text": meta["prompt"]})
    return items


_register(_Reader("cline-cli", "Cline CLI", (".cline",), env="CLINE_DIR", index=_cline_cli_index, items=_cline_cli_items))


# ------------------------------------------- Cline, Roo Code and Kilo Code
# The VS Code extensions keep one folder per task under their globalStorage:
# tasks/<id>/ui_messages.json, the transcript as the panel shows it
# ([{ts, type: ask|say, ask, say, text}]), with history_item.json (Roo, Kilo)
# or task_metadata.json beside it. Tool calls are ``ask: tool`` messages whose
# text is JSON ({tool, path, …}); commands are ``ask: command`` followed by
# ``say: command_output``; each request's tokens are in ``say: api_req_started``.

_CLINE_TOOLS = {
    "readFile": "Read", "fetchInstructions": "Read", "editedExistingFile": "Edit", "appliedDiff": "Edit",
    "insertContent": "Edit", "searchAndReplace": "Edit", "newFileCreated": "Write", "writeToFile": "Write",
    "listFilesTopLevel": "Search", "listFilesRecursive": "Search", "listCodeDefinitionNames": "Search",
    "searchFiles": "Grep", "codebaseSearch": "Search", "webFetch": "WebFetch", "webSearch": "WebSearch",
    "newTask": "Task", "switchMode": "SwitchMode", "updateTodoList": "TodoWrite", "execute_command": "Bash",
}


def _cline_task_index(root: Path) -> list[dict]:
    out = []
    for ui in sorted(root.glob("tasks/*/ui_messages.json")):
        s = _file_session(ui, ui.parent.name)
        if s:
            out.append(s)
    return out


def _cline_task_items(session: dict, root: Path) -> list[dict]:
    task_dir = session["_path"].parent
    history = _read_json_doc(task_dir / "history_item.json")
    if isinstance(history, dict):
        session.update(cwd=history.get("workspace"), title=history.get("task"), started=history.get("ts"),
                       parent_id=history.get("parentTaskId") or None, model=history.get("apiConfigName"))
    msgs = _read_json_doc(session["_path"])
    items: list[dict] = []
    pending: dict | None = None  # the command or MCP call whose output is still streaming in
    last_tool: dict | None = None
    for n, m in enumerate(msgs if isinstance(msgs, list) else []):
        if not isinstance(m, dict) or m.get("partial"):
            continue
        ts, kind, text = m.get("ts"), m.get("ask") or m.get("say"), m.get("text") or ""
        mid = f"{ts}:{n}"
        if n == 0 or kind in ("user_feedback", "user_feedback_diff"):
            items.append({"kind": "prompt", "id": mid, "ts": ts, "text": text})
        elif kind in ("text", "completion_result") and m.get("type") == "say":
            items.append({"kind": "response", "id": mid, "ts": ts, "text": text})
        elif kind == "reasoning":
            items.append({"kind": "thought", "id": mid, "ts": ts, "text": m.get("reasoning") or text})
        elif kind == "tool" and m.get("type") == "ask":
            data = _reader_json(text)
            if isinstance(data, dict) and data.get("tool"):
                last_tool = {"kind": "tool", "id": mid, "ts": ts, "name": data["tool"],
                             "input": {k: v for k, v in data.items() if k != "tool"}}
                if "content" in data and data["tool"] == "readFile":
                    last_tool["output"] = data["content"]
                items.append(last_tool)
        elif kind == "command" and m.get("type") == "ask":
            pending = last_tool = {"kind": "tool", "id": mid, "ts": ts, "name": "execute_command",
                                   "input": {"command": text}}
            items.append(pending)
        elif kind == "use_mcp_server" and m.get("type") == "ask":
            data = _reader_json(text)
            data = data if isinstance(data, dict) else {}
            pending = last_tool = {"kind": "tool", "id": mid, "ts": ts,
                                   "name": f"mcp__{data.get('serverName')}__{data.get('toolName') or data.get('uri')}",
                                   "input": _reader_json(data.get("arguments")) or {}}
            items.append(pending)
        elif kind in ("command_output", "mcp_server_response") and pending is not None:
            pending["output"] = (str(pending.get("output") or "") + text) if kind == "command_output" else text
            pending["end_ts"] = ts
        elif kind in ("error", "diff_error", "rooignore_error", "mistake_limit_reached") and last_tool is not None:
            last_tool.update(failed=True, output=text, end_ts=ts)
        elif kind == "api_req_started":
            data = _reader_json(text)
            if isinstance(data, dict) and (data.get("tokensIn") or data.get("tokensOut")):
                items.append({"kind": "usage", "id": mid, "ts": ts, "model": session.get("model"), "usage": {
                    "input_tokens": int(data.get("tokensIn") or 0), "output_tokens": int(data.get("tokensOut") or 0),
                    "cache_read_tokens": int(data.get("cacheReads") or 0),
                    "cache_write_tokens": int(data.get("cacheWrites") or 0)}})
            pending = None
    for item in items:
        if item.get("kind") == "tool" and "output" not in item and item.get("failed") is None:
            item["failed"] = False  # the panel only moves on once a call has finished
    return items


def _vscode_ext_dirs(extension: str) -> tuple[str, ...]:
    return tuple(f"{d}/globalStorage/{extension}" for d in _VSCODE_DIRS)


