# ------------------------------------------------------ chat-log JSONL / JSON
# Many agents write a session as JSON lines of chat messages in one of a few
# shapes: Claude-style ({type, message: {role, content: blocks}}), Pi-style
# ({type: "message", message: {role, content: [text | thinking | toolCall]}}),
# OpenAI chat ({role, content, tool_calls} with role "tool" results) and the
# Responses API ({type: message | function_call | function_call_output}).
# _chat_items reads all of them, so a reader for such an agent only says where
# its files are and how to find the session's id and folder.

_ROLE = {"user": "user", "human": "user", "assistant": "assistant", "ai": "assistant", "model": "assistant",
         "agent": "assistant", "bot": "assistant", "tool": "tool", "toolresult": "tool", "tool_result": "tool",
         "function": "tool", "system": "system", "developer": "system"}
_HEADER_TYPES = ("session", "session_info", "session_start", "session_meta", "metadata", "meta", "header")


def _first(d: object, *keys: str) -> object:
    for k in keys:
        cur = d
        for part in k.split("."):
            cur = cur.get(part) if isinstance(cur, dict) else None
        if cur not in (None, ""):
            return cur
    return None


def _chat_items(records: list[dict], session: dict, model: str | None = None) -> list[dict]:
    items: list[dict] = []
    tools: dict = {}

    def tool_call(tid: object, name: object, args: object, ts: object) -> None:
        tid = str(tid or f"t{len(items)}")
        tools[tid] = {"kind": "tool", "id": tid, "ts": ts, "name": name, "input": args}
        items.append(tools[tid])

    def tool_result(tid: object, output: object, failed: bool, ts: object) -> None:
        call = tools.get(str(tid)) if tid is not None else None
        if call is None:
            call = next((t for t in reversed(list(tools.values())) if "output" not in t), None)
        if call is not None:
            text = _reader_text(output) if not isinstance(output, str) else output
            call.update(output=text or output, end_ts=ts, failed=failed)

    for n, rec in enumerate(records):
        if not isinstance(rec, dict):
            continue
        rtype = str(rec.get("type") or "").lower()
        ts = _first(rec, "timestamp", "created_at", "createdAt", "ts", "time", "message.timestamp")
        if rtype in _HEADER_TYPES or (n == 0 and not any(k in rec for k in ("role", "message", "content"))):
            session["id"] = _first(rec, "id", "sessionId", "session_id") or session["id"]
            session["cwd"] = session.get("cwd") or _first(rec, "cwd", "working_dir", "workdir", "workspace",
                                                          "project_path", "projectPath", "working_directory")
            session["started"] = session.get("started") or ts
            session["title"] = session.get("title") or _first(rec, "title", "name", "summary")
            model = _first(rec, "model", "model_id") or model
            continue
        if rtype in ("model_change", "config", "config.update"):
            model = _first(rec, "model", "new_model", "modelAlias") or model
            continue
        session["id"] = session["id"] if session.get("_id_set") else (_first(rec, "sessionId", "session_id") or session["id"])
        session["cwd"] = session.get("cwd") or _first(rec, "cwd", "working_dir")
        if isinstance(rec.get("messages"), list):  # a record carrying a whole exchange
            items += _chat_items([m for m in rec["messages"] if isinstance(m, dict)], {**session, "_id_set": True}, model)
            continue
        # Responses-API items.
        if rtype in ("function_call", "custom_tool_call"):
            tool_call(_first(rec, "call_id", "callId", "id"), rec.get("name"), rec.get("arguments") or rec.get("input"), ts)
            continue
        if rtype in ("function_call_output", "custom_tool_call_output"):
            tool_result(_first(rec, "call_id", "callId"), rec.get("output"), False, ts)
            continue
        if rtype == "reasoning":
            text = _reader_text(rec.get("summary") or rec.get("content"))
            if text:
                items.append({"kind": "thought", "id": f"r{n}", "ts": ts, "text": text})
            continue
        m = rec.get("message") if isinstance(rec.get("message"), dict) else rec.get("msg") if isinstance(rec.get("msg"), dict) else rec
        role = _ROLE.get(str(m.get("role") or rec.get("role") or rtype).lower().replace("-", "_"))
        if role is None:
            continue
        mid = _first(rec, "id", "uuid", "message_id") or _first(m, "id") or n
        # Posit Assistant (Vercel AI SDK messages) keeps its own stamps in providerOptions.
        posit = _first(m, "providerOptions.providerMetadata.positai") or {}
        mts = ts or _first(m, "timestamp", "created_at") or _first(posit, "timestamp")
        mmodel = (_first(m, "model", "modelId") or _first(rec, "model", "metadata.model", "metadata.generation_model")
                  or _first(posit, "modelId") or model)
        content = m.get("content")
        if content is None and "text" in m:
            content = m.get("text")
        text: list[str] = []
        if role == "tool" and not (isinstance(content, list) and any(
                isinstance(b, dict) and str(b.get("type") or "").replace("-", "_") == "tool_result" for b in content)):
            tool_result(_first(m, "tool_call_id", "toolCallId", "tool_use_id", "call_id") or _first(rec, "tool_call_id", "toolCallId"),
                        content if content is not None else m.get("output"),
                        bool(_first(m, "is_error", "isError") or _first(rec, "is_error", "isError")), mts)
            continue
        for i, b in enumerate(content if isinstance(content, list) else [content] if content is not None else []):
            if isinstance(b, str):
                text.append(b)
                continue
            if not isinstance(b, dict):
                continue
            btype = str(b.get("type") or "").lower().replace("-", "_")
            if btype in ("text", "input_text", "output_text", "") and isinstance(b.get("text"), str):
                text.append(b["text"])
            elif btype in ("thinking", "reasoning", "redacted_thinking") and (b.get("thinking") or b.get("text")):
                items.append({"kind": "thought", "id": f"{mid}:{i}", "ts": mts, "text": b.get("thinking") or b.get("text")})
            elif role == "system":
                if btype in ("tool_result", "toolresult"):  # QwenPaw hands results back as system turns
                    tool_result(_first(b, "id", "tool_use_id"), _first(b, "output", "content"), bool(b.get("is_error")), mts)
            elif btype in ("tool_use", "toolcall", "tool_call", "function_call", "server_tool_use"):
                tool_call(_first(b, "id", "toolCallId", "tool_call_id", "call_id", "toolUseId"),
                          _first(b, "name", "toolName", "tool_name"),
                          _first(b, "input", "arguments", "args", "params", "parameters"), mts)
            elif btype in ("tool_result", "toolresult", "function_call_output", "tool_output"):
                tool_result(_first(b, "tool_use_id", "toolCallId", "tool_call_id", "call_id", "id"),
                            _first(b, "content", "output", "result"), bool(_first(b, "is_error", "isError")), mts)
        for call in m.get("tool_calls") or [] if isinstance(m.get("tool_calls"), list) else []:
            fn = call.get("function") if isinstance(call, dict) and isinstance(call.get("function"), dict) else call
            if isinstance(fn, dict):
                tool_call(call.get("id"), fn.get("name"), fn.get("arguments") or fn.get("input"), mts)
        thought = _first(m, "reasoning_content", "reasoning", "thinking")
        if isinstance(thought, str) and thought.strip():
            items.append({"kind": "thought", "id": f"{mid}:r", "ts": mts, "text": thought})
        if text and role != "system":
            kind = "prompt" if role == "user" else "response"
            items.append({"kind": kind, "id": mid, "ts": mts, "text": "\n".join(text),
                          **({"model": mmodel} if kind == "response" else {})})
        usage = (_first(m, "usage", "usageMetadata", "metadata.metrics") or _first(rec, "usage", "metadata.usage")
                 or _first(posit, "usage"))
        if role == "assistant" and isinstance(usage, dict):
            counts = _usage_counts(usage)
            if any(counts.values()):
                items.append({"kind": "usage", "id": f"{mid}:u", "ts": mts, "model": mmodel, "usage": counts})
        session["model"] = session.get("model") or mmodel
    return items


def _chat_reader(agent: str, label: str, dirs: tuple[str, ...], pattern: str | tuple[str, ...], *,
                 skip: tuple[str, ...] = (), id_from=None, meta_file=None, doc_key: str | tuple[str, ...] | None = None,
                 tools: dict[str, str] | None = None, env: str | None = None, cwd_from=None,
                 skip_suffix: tuple[str, ...] = (), skip_prefix: tuple[str, ...] = (), companion=None) -> _Reader:
    """A reader for an agent whose sessions are chat-log files under its folder.
    ``pattern``: globs for session files; ``skip``: file names that aren't
    sessions; ``id_from``: (path) -> session id when the file name isn't it;
    ``meta_file``: (path) -> a JSON file beside it with cwd and title;
    ``doc_key``: the files are one JSON document whose messages sit under it;
    ``cwd_from``: (path, root) -> the project folder when the file doesn't say;
    ``skip_suffix`` / ``skip_prefix``: file-name ends and starts that aren't
    sessions (sidecars, subagents); ``companion``: (path) -> a JSONL file
    holding the messages when the document itself has none."""
    globs = (pattern,) if isinstance(pattern, str) else pattern

    def index(root: Path) -> list[dict]:
        out, seen = [], set()
        for g in globs:
            for path in sorted(root.glob(g)):
                if (path in seen or path.name in skip or not path.is_file()
                        or path.name.endswith(skip_suffix or ("\0",)) or path.name.startswith(skip_prefix or ("\0",))):
                    continue
                seen.add(path)
                s = _file_session(path, id_from(path) if id_from else None)
                if s:
                    out.append(s)
        return out

    def items(session: dict, root: Path) -> list[dict]:
        path = session["_path"]
        if meta_file is not None:
            meta = _read_json_doc(meta_file(path))
            if isinstance(meta, dict):
                session["cwd"] = _first(meta, "cwd", "working_dir", "workspace", "working_directory", "projectPath",
                                        "environment.working_directory", "workspace_root", "info.cwd",
                                        "source_workspace_dir", "git_root_dir")
                session["title"] = _first(meta, "title", "name", "summary", "root.title")
                session["started"] = _first(meta, "created_at", "createdAt", "start_time", "startTime")
                session["id"] = _first(meta, "session_id", "sessionId", "id") or session["id"]
        if cwd_from is not None and not session.get("cwd"):
            session["cwd"] = cwd_from(path, root)
        if path.suffix == ".jsonl":
            records = _read_jsonl_file(path)
        else:
            doc = _read_json_doc(path)
            if isinstance(doc, dict):
                session["id"] = _first(doc, "id", "sessionId", "session_id", "metadata.id") or session["id"]
                session["cwd"] = session.get("cwd") or _first(doc, "cwd", "workspace", "working_directory", "working_dir")
                session["title"] = session.get("title") or _first(doc, "title", "name")
                found = _first(doc, *((doc_key,) if isinstance(doc_key, str) else doc_key or ("messages",)))
                # QwenPaw keeps [message, marks] pairs.
                records = [r[0] if isinstance(r, list) and r and isinstance(r[0], dict) else r
                           for r in found] if isinstance(found, list) else []
                if not records and companion is not None:
                    records = _read_jsonl_file(companion(path))
            else:
                records = doc if isinstance(doc, list) else []
        session["_id_set"] = True
        return _chat_items(records, session)

    return _Reader(agent, label, dirs, env=env, index=index, items=items, tools=tools)


