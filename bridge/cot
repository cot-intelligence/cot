def _vscode_replay(path: Path) -> dict | None:
    """The session document a chatSessions .jsonl describes."""
    state: object = None
    for op in _read_jsonl_file(path):
        kind, keys, value = op.get("kind"), op.get("k") or [], op.get("v")
        if kind == 0:
            state = value
            continue
        if state is None or not keys:
            continue
        target = state
        try:
            for k in keys[:-1]:
                target = target[k]
            last = keys[-1]
            if kind == 1:
                if isinstance(target, list) and isinstance(last, int) and last == len(target):
                    target.append(value)
                else:
                    target[last] = value
            elif kind == 2:
                arr = target.setdefault(last, []) if isinstance(target, dict) else target[last]
                if isinstance(op.get("i"), int):
                    del arr[op["i"]:]
                arr.extend(value if isinstance(value, list) else [value])
            elif kind == 3:
                del target[last]
        except (KeyError, IndexError, TypeError):
            continue
    return state if isinstance(state, dict) else None


def _vscode_folder(storage: Path) -> str | None:
    """The folder a workspaceStorage/<hash> belongs to, from its workspace.json."""
    workspace = _read_json_doc(storage / "workspace.json")
    folder = workspace.get("folder") if isinstance(workspace, dict) else None
    if isinstance(folder, str) and folder.startswith("file://"):
        return urllib.parse.unquote(folder[len("file://"):])
    return None


def _vscode_index(root: Path) -> list[dict]:
    out = []
    folders: dict[Path, str | None] = {}
    for path in sorted([*root.glob("workspaceStorage/*/chatSessions/*.json*"),
                        *root.glob("globalStorage/emptyWindowChatSessions/*.json*")]):
        if path.suffix in (".json", ".jsonl"):
            s = _file_session(path)
            if s:
                storage = path.parent.parent
                if storage not in folders:
                    folders[storage] = _vscode_folder(storage)
                s["cwd"] = folders[storage]
                out.append(s)
    return out


def _vscode_uri_path(value: object) -> str | None:
    if isinstance(value, dict):
        for key in ("fsPath", "path"):
            if isinstance(value.get(key), str):
                return value[key]
        for uri in (value.get("uris") or {}).values() if isinstance(value.get("uris"), dict) else ():
            found = _vscode_uri_path(uri)
            if found:
                return found
        value = value.get("value") or value.get("external")
    if isinstance(value, str):
        m = re.search(r"file://(/[^)\s\]]+)", value)
        if m:
            return urllib.parse.unquote(m.group(1))
    return None


def _vscode_items(session: dict, root: Path) -> list[dict]:
    path = session["_path"]
    doc = _vscode_replay(path) if path.suffix == ".jsonl" else _read_json_doc(path)
    if not isinstance(doc, dict):
        return []
    session["id"] = doc.get("sessionId") or session["id"]
    session["started"] = doc.get("creationDate")
    session["title"] = doc.get("customTitle")
    items: list[dict] = []
    for n, req in enumerate(doc.get("requests") or []):
        if not isinstance(req, dict):
            continue
        rid, ts = req.get("requestId") or n, req.get("timestamp")
        meta = (req.get("result") or {}).get("metadata") if isinstance(req.get("result"), dict) else None
        meta = meta if isinstance(meta, dict) else {}
        model = meta.get("resolvedModel") or req.get("modelId")
        message = req.get("message") if isinstance(req.get("message"), dict) else {}
        items.append({"kind": "prompt", "id": rid, "ts": ts, "text": message.get("text") or "", "model": model})
        text: list[str] = []
        for part in req.get("response") or []:
            if not isinstance(part, dict):
                continue
            kind = part.get("kind")
            if kind in (None, "markdownContent", "markdownVuln") and isinstance(part.get("value"), str):
                text.append(part["value"])
            elif kind == "thinking" and isinstance(part.get("value"), str):
                items.append({"kind": "thought", "id": f"{rid}:t{len(items)}", "ts": ts, "text": part["value"]})
            elif kind == "toolInvocationSerialized" and part.get("toolId"):
                data = part.get("toolSpecificData") if isinstance(part.get("toolSpecificData"), dict) else {}
                command = data.get("command") or ((data.get("commandLine") or {}).get("original")
                                                  if isinstance(data.get("commandLine"), dict) else None)
                message_text = part.get("pastTenseMessage") or part.get("invocationMessage")
                tool_input: dict = {"description": _reader_text(message_text) or None}
                if command:
                    tool_input["command"] = command
                target = _vscode_uri_path(part.get("pastTenseMessage")) or _vscode_uri_path(part.get("invocationMessage"))
                if target:
                    tool_input["file_path"] = target
                items.append({"kind": "tool", "id": part.get("toolCallId") or f"{rid}:{len(items)}", "ts": ts,
                              "name": part["toolId"], "input": {k: v for k, v in tool_input.items() if v},
                              "output": _reader_text(part.get("resultDetails")) or None,
                              "failed": bool(part.get("isError")) or part.get("isConfirmed") is False})
        items.append({"kind": "response", "id": rid, "ts": ts, "text": "".join(text).strip(), "model": model})
        if meta.get("promptTokens") or meta.get("outputTokens"):
            items.append({"kind": "usage", "id": rid, "ts": ts, "model": model, "usage": {
                "input_tokens": int(meta.get("promptTokens") or 0), "output_tokens": int(meta.get("outputTokens") or 0)}})
    return items


