    return [{"id": r["conversation_id"], "title": r.get("title"), "started": r.get("created_at"),
             "updated": _reader_epoch(r.get("updated_at") or r.get("created_at")), "_db": db_path}
            for r in _sqlite_rows(db_path, "SELECT conversation_id, title, created_at, updated_at FROM conversations"
