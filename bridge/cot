# --------------------------------------------------------------------- Zed
# Zed's agent panel keeps every thread in threads/threads.db: one row per
# thread with its JSON, zstd-compressed when data_type is "zstd". Messages are
# {"User": {...}} / {"Agent": {...}} with Text, Thinking and ToolUse parts;
# tool results sit in the agent message's ``tool_results``. Messages carry no
# timestamps, so every event takes the thread's updated_at.

def _zstd_decompress(blob: bytes) -> bytes | None:
    try:
        from compression import zstd  # Python 3.14+
        return zstd.decompress(blob)
    except ImportError:
        pass
    try:
        import zstandard  # type: ignore[import-not-found]
        return zstandard.ZstdDecompressor().decompressobj().decompress(blob)
    except ImportError:
        pass
    import shutil
    import subprocess
    exe = shutil.which("zstd")
    if exe:
        try:
            return subprocess.run([exe, "-dc"], input=blob, capture_output=True, timeout=30, check=True).stdout
        except (OSError, subprocess.SubprocessError):
            return None
    return None


def _zed_index(root: Path) -> list[dict]:
    db_path = root / "threads" / "threads.db"
    rows = _sqlite_rows(db_path, "SELECT id, summary, updated_at, length(data) AS n FROM threads")
    try:
        cols = {r["name"] for r in _sqlite_rows(db_path, "PRAGMA table_info(threads)")}
    except Exception:  # noqa: BLE001
        cols = set()
    folders = {r["id"]: r["folder_paths"] for r in _sqlite_rows(db_path, "SELECT id, folder_paths FROM threads")} \
        if "folder_paths" in cols else {}
    out = []
    for r in rows:
        paths = [p for p in str(folders.get(r["id"]) or "").splitlines() if p.strip()]
        out.append({"id": r["id"], "title": r["summary"], "updated": _reader_epoch(r["updated_at"]),
                    "bytes": r["n"] or 0, "cwd": paths[0] if paths else None, "_db": db_path,
                    "_updated_at": r["updated_at"]})
    return out


def _zed_walk(value: object, key: str) -> list:
    found: list = []
    if isinstance(value, dict):
        if key in value:
            found.append(value[key])
        for child in value.values():
            found += _zed_walk(child, key)
    elif isinstance(value, list):
        for child in value:
            found += _zed_walk(child, key)
    return found


def _zed_text(value: object) -> str:
    return "\n".join(t if isinstance(t, str) else str((t or {}).get("text") or "")
                     for t in _zed_walk(value, "Text")).strip()


def _zed_items(session: dict, root: Path) -> list[dict]:
    rows = _sqlite_rows(session["_db"], "SELECT data_type, data FROM threads WHERE id = ?", (session["id"],))
    if not rows:
        return []
    blob = rows[0]["data"]
    blob = blob.encode() if isinstance(blob, str) else blob
    if rows[0]["data_type"] == "zstd":
        blob = _zstd_decompress(blob)
        if blob is None:
            print("cot import: zed threads are zstd-compressed; install zstd (or Python 3.14) to read them",
                  file=sys.stderr)
            return []
    doc = _reader_json(blob.decode("utf-8", errors="replace"))
    if not isinstance(doc, dict):
        return []
    model = (doc.get("model") or {}).get("model") if isinstance(doc.get("model"), dict) else None
    session["model"] = model
    ts = session.get("_updated_at")
    items: list[dict] = []
    for n, msg in enumerate(doc.get("messages") or []):
        if not isinstance(msg, dict):
            continue
        if "User" in msg:
            items.append({"kind": "prompt", "id": n, "ts": ts, "text": _zed_text(msg["User"])})
            continue
        agent = msg.get("Agent")
        if not isinstance(agent, dict):
            continue
        for i, thinking in enumerate(_zed_walk(agent.get("content"), "Thinking")):
            if isinstance(thinking, dict):
                items.append({"kind": "thought", "id": f"{n}:{i}", "ts": ts, "text": thinking.get("text") or ""})
        results = agent.get("tool_results") if isinstance(agent.get("tool_results"), dict) else {}
        for use in _zed_walk(agent.get("content"), "ToolUse"):
            if not isinstance(use, dict):
                continue
            res = results.get(use.get("id")) if isinstance(results.get(use.get("id")), dict) else None
            items.append({"kind": "tool", "id": use.get("id") or f"{n}:tool", "ts": ts, "name": use.get("name"),
                          "input": use.get("input") if use.get("input") is not None else use.get("raw_input"),
                          **({"output": res.get("output") or _zed_text(res.get("content")),
                              "failed": bool(res.get("is_error"))} if res else {})})
        items.append({"kind": "response", "id": n, "ts": ts, "text": _zed_text(agent.get("content")), "model": model})
    for rid, usage in (doc.get("request_token_usage") or {}).items() if isinstance(doc.get("request_token_usage"), dict) else ():
        if isinstance(usage, dict):
            items.append({"kind": "usage", "id": rid, "ts": ts, "model": model, "usage": {
                "input_tokens": int(usage.get("input_tokens") or 0), "output_tokens": int(usage.get("output_tokens") or 0),
                "cache_read_tokens": int(usage.get("cache_read_input_tokens") or 0),
                "cache_write_tokens": int(usage.get("cache_creation_input_tokens") or 0)}})
    return items


