                      tools=_CLINE_TOOLS))


# -------------------------------------------------------------------- Kilo
# The Kilo CLI is an OpenCode fork and keeps OpenCode's store in its own
# folder (see _opencode_family, defined further down).


def _usage_counts(u: object) -> dict:
    """Token counts from the usage shapes agents write (OpenAI, Anthropic,
    camelCase, Kimi's input_other / input_cache_read), in cot's keys."""
    if not isinstance(u, dict):
        return {}

    def pick(*keys: str) -> int:
        for k in keys:
            v = u.get(k)
            if isinstance(v, (int, float)) and not isinstance(v, bool):
                return int(v)
        return 0

    read = pick("cache_read_tokens", "cache_read_input_tokens", "cacheReadTokens", "input_cache_read",
                "cached_tokens", "cachedInputTokens", "cacheRead", "cachedReadTokens", "cached_input_tokens")
    write = pick("cache_write_tokens", "cache_creation_input_tokens", "cacheWriteTokens", "input_cache_creation",
                 "cacheWrite", "cache_creation_tokens", "cacheCreation")
    fresh = pick("input_other")
    if not fresh:
        total_in = pick("input_tokens", "inputTokens", "prompt_tokens", "promptTokens", "input")
        # OpenAI-style prompt counts include the cached part; Anthropic's don't.
        fresh = max(0, total_in - read) if ("prompt_tokens" in u or "promptTokens" in u) else total_in
    return {"input_tokens": fresh, "cache_read_tokens": read, "cache_write_tokens": write,
            "output_tokens": pick("output_tokens", "outputTokens", "completion_tokens", "completionTokens", "output"),
            "reasoning_tokens": pick("reasoning_tokens", "reasoningTokens")}


# -------------------------------------------------------------------- Kimi
# Kimi CLI: ~/.kimi/sessions/<work dir hash>/<session>/wire.jsonl (newer:
# …/session_<id>/agents/<agent>/wire.jsonl). Older lines are
# {timestamp, message: {type: TurnBegin | ContentPart | ToolCall | ToolResult
# | StatusUpdate, payload}}; newer ones carry a top-level type (turn.prompt,
# context.append_loop_event, usage.record, config.update). The work dir
# behind a hash is in ~/.kimi/kimi.json.

def _kimi_index(root: Path) -> list[dict]:
    config = _read_json_doc(root / "kimi.json")
    dirs = config.get("work_dirs") if isinstance(config, dict) else None
    by_hash = {}
    for d in dirs if isinstance(dirs, list) else []:
        path = d.get("path") if isinstance(d, dict) else d
        if isinstance(path, str):
            by_hash[hashlib.md5(path.encode()).hexdigest()] = path  # noqa: S324 - Kimi's own folder key
    out = []
    for wire in sorted(root.glob("sessions/**/wire.jsonl")):
        rel = wire.relative_to(root / "sessions").parts
        if "agents" in rel:
            # One wire per agent; the main one carries the person's turns.
            agents = sorted(p.name for p in wire.parent.parent.iterdir() if p.is_dir())
            main = next((a for a in ("main", "root", "default") if a in agents), agents[0] if agents else None)
            if wire.parent.name != main:
                continue
        sid = next((p[len("session_"):] for p in rel if p.startswith("session_")), rel[-2] if len(rel) > 1 else wire.stem)
        s = _file_session(wire, sid)
        if s:
            s["cwd"] = by_hash.get(rel[0].rsplit("_", 1)[-1]) or by_hash.get(rel[0])
            out.append(s)
    return out


def _kimi_items(session: dict, root: Path) -> list[dict]:
    items: list[dict] = []
    tools: dict = {}
    model = None
    text: list[str] = []
    turn = 0

    def flush(ts: object) -> None:
        if text:
            items.append({"kind": "response", "id": f"r{turn}:{len(items)}", "ts": ts, "text": "".join(text), "model": model})
            text.clear()

    for n, rec in enumerate(_read_jsonl_file(session["_path"])):
        ts = rec.get("timestamp")
        msg = rec.get("message") if isinstance(rec.get("message"), dict) else {}
        mtype, payload = msg.get("type"), msg.get("payload") if isinstance(msg.get("payload"), dict) else {}
        rtype = rec.get("type")
        if rtype == "config.update":
            model = rec.get("modelAlias") or model
            session["cwd"] = rec.get("cwd") or session.get("cwd")
        elif rtype in ("turn.prompt", "turn.steer") or mtype == "TurnBegin":
            flush(ts)
            turn += 1
            parts = rec.get("input") if rtype else payload.get("user_input")
            prompt = parts if isinstance(parts, str) else _reader_text(parts)
            items.append({"kind": "prompt", "id": f"p{turn}:{n}", "ts": ts, "text": prompt})
        elif rtype == "context.append_loop_event" or mtype in ("ContentPart", "ToolCall", "ToolResult"):
            ev = rec.get("event") if rtype else {**payload, "type": mtype}
            ev = ev if isinstance(ev, dict) else {}
            etype = ev.get("type")
            part = ev.get("part") if isinstance(ev.get("part"), dict) else ev
            if etype in ("content.part", "ContentPart", "text", "think"):
                if part.get("type") == "think" or etype == "think":
                    flush(ts)
                    items.append({"kind": "thought", "id": f"t{n}", "ts": ts, "text": part.get("think") or part.get("text") or ""})
                elif isinstance(part.get("text"), str):
                    text.append(part["text"])
            elif etype in ("tool.call", "ToolCall"):
                flush(ts)
                fn = ev.get("function") if isinstance(ev.get("function"), dict) else {}
                tid = ev.get("toolCallId") or ev.get("id") or f"c{n}"
                tools[tid] = {"kind": "tool", "id": tid, "ts": ts, "name": ev.get("name") or fn.get("name"),
                              "input": ev.get("args") if "args" in ev else fn.get("arguments")}
                items.append(tools[tid])
            elif etype in ("tool.result", "ToolResult"):
                tid = ev.get("toolCallId") or ev.get("tool_call_id")
                res = ev.get("result") if isinstance(ev.get("result"), dict) else ev.get("return_value")
                res = res if isinstance(res, dict) else {}
                if tools.get(tid) is not None:
                    tools[tid].update(output=res.get("output") or res.get("message"), end_ts=ts,
                                      failed=bool(res.get("isError") or res.get("is_error")))
            elif etype == "step.end":
                model = ev.get("model") or model
                if ev.get("usage"):
                    items.append({"kind": "usage", "id": f"u{n}", "ts": ts, "model": model, "usage": _usage_counts(ev["usage"])})
        elif rtype == "usage.record" and rec.get("usage"):
            model = rec.get("model") or model
            items.append({"kind": "usage", "id": f"u{n}", "ts": ts, "model": model, "usage": _usage_counts(rec["usage"])})
        elif mtype == "StatusUpdate" and isinstance(payload.get("token_usage"), dict):
            items.append({"kind": "usage", "id": f"u{n}", "ts": ts, "model": model,
                          "usage": _usage_counts(payload["token_usage"])})
    flush(None)
    session["model"] = model
    return items


_register(_Reader("kimi", "Kimi CLI", (".kimi", ".kimi-code"), env="KIMI_DIR", index=_kimi_index, items=_kimi_items))
