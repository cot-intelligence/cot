# The Trae IDE (a VS Code fork) keeps its agent chats in each workspace's
# state.vscdb, under ItemTable key memento/icube-ai-agent-storage:
# {"list": [{sessionId, createdAt, updatedAt, model, messages: [...]}]}.
# Messages hold the text only, no tool calls. TRAE CLI writes Codex rollouts
# under ~/.trae/cli and is read with the Codex parser.

_TRAE_KEY = "memento/icube-ai-agent-storage"


def _trae_sessions_in(db_path: Path) -> list[dict]:
    rows = _sqlite_rows(db_path, "SELECT value FROM ItemTable WHERE key = ?", (_TRAE_KEY,))
    store = _reader_json(rows[0]["value"]) if rows else None
    items = store.get("list") if isinstance(store, dict) else None
    return [x for x in items if isinstance(x, dict) and x.get("sessionId")] if isinstance(items, list) else []


def _trae_index(root: Path) -> list[dict]:
    out = []
    for db_path in [root / "globalStorage" / "state.vscdb", *sorted(root.glob("workspaceStorage/*/state.vscdb"))]:
        cwd = _vscode_folder(db_path.parent)
        for rec in _trae_sessions_in(db_path):
            msgs = rec.get("messages") if isinstance(rec.get("messages"), list) else []
            out.append({"id": rec["sessionId"], "updated": _reader_epoch(rec.get("updatedAt")),
                        "started": rec.get("createdAt"), "model": rec.get("model"), "cwd": cwd,
                        "weight": len(msgs), "_record": rec})
    return out


def _trae_items(session: dict, root: Path) -> list[dict]:
    rec = session["_record"]
    items = []
    for n, m in enumerate(rec.get("messages") or []):
        if not isinstance(m, dict):
            continue
        role, ts = str(m.get("role") or "").lower(), m.get("timestamp") or rec.get("createdAt")
        text = m.get("content") if isinstance(m.get("content"), str) else ""
        if role == "assistant" and not text.strip():
            task = _reader_json(m.get("agentTaskContent"))
            if isinstance(task, str):
                text = task
            elif isinstance(task, dict):
                text = next((task[k] for k in ("content", "text", "proposal") if isinstance(task.get(k), str)), "")
        if role == "user":
            items.append({"kind": "prompt", "id": n, "ts": ts, "text": text})
        elif role == "assistant":
            items.append({"kind": "response", "id": n, "ts": ts, "text": text, "model": m.get("model") or rec.get("model")})
    return items


